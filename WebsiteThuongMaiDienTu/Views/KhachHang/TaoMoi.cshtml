@model WebsiteThuongMaiDienTu.Models.khachhang

@{
    ViewBag.Title = "Thêm khách hàng";
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2><i class="bi bi-person-plus-fill" style="color: var(--brand-yellow);"></i> Thêm khách hàng</h2>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" style="padding:14px 18px;border-radius:8px;margin-bottom:18px;background:#ffebee;color:#c62828;border:1px solid #ef5350;">
                <i class="bi bi-exclamation-triangle-fill"></i> Vui lòng kiểm tra lại thông tin bên dưới.
            </div>
        }

        <form method="post" action="@Url.Action("TaoMoi")">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Họ tên <span class="required">*</span></label>
                <input type="text" name="hoten" class="form-control" maxlength="100"
                       value="@(Model != null ? Model.hoten : "")" required />
                @Html.ValidationMessage("hoten", new { @class = "field-error" })
            </div>

            <div class="form-group">
                <label>Địa chỉ <span class="required">*</span></label>
                <textarea name="diachi" class="form-control" rows="3" maxlength="200" required>@(Model != null ? Model.diachi : "")</textarea>
                @Html.ValidationMessage("diachi", new { @class = "field-error" })
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                <input type="tel" name="SDT" class="form-control" maxlength="15"
                       placeholder="Nhập 10-11 chữ số (không bắt buộc)"
                       value="@(Model != null ? Model.SDT : "")" />
                @Html.ValidationMessage("SDT", new { @class = "field-error" })
            </div>

            <div class="d-flex align-items-center gap-2 mt-3">
                <button type="submit" class="btn-luu"><i class="bi bi-check-circle"></i> Lưu</button>
                <a href="@Url.Action("Index")" class="btn-huy">Hủy</a>
            </div>
        </form>
    </div>
</div>