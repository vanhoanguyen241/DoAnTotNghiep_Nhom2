@model List<WebsiteThuongMaiDienTu.Models.sanpham>

@{
    ViewBag.Title = "Giỏ hàng";

    var gioHang = ViewBag.GioHang as System.Collections.Generic.Dictionary<string, int>;

    if (gioHang == null)
    {
        gioHang = new System.Collections.Generic.Dictionary<string, int>();
    }

    decimal tongTien = 0;

    if (ViewBag.TongTien != null)
    {
        tongTien = (decimal)ViewBag.TongTien;
    }
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h2 class="h4 mb-0">
                <i class="bi bi-cart3"></i> Giỏ hàng
            </h2>
        </div>

        <div class="card-body p-4">
            @if (TempData["ThongBaoGioHang"] != null)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill"></i> @TempData["ThongBaoGioHang"]
                </div>
            }

            @if (TempData["LoiGioHang"] != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["LoiGioHang"]
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Hình</th>
                                <th>Sản phẩm</th>
                                <th style="width: 120px;">Đơn giá</th>
                                <th style="width: 180px;">Số lượng</th>
                                <th style="width: 140px;">Thành tiền</th>
                                <th style="width: 80px;">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sp in Model)
                            {
                                int soLuong = gioHang.ContainsKey(sp.masanpham) ? gioHang[sp.masanpham] : 0;
                                decimal thanhTien = sp.dongia * soLuong;

                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(sp.hinh))
                                        {
                                            <img src="@Url.Content(sp.hinh)"
                                                 alt="@sp.tensanpham"
                                                 style="width: 60px; height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <strong>@sp.tensanpham</strong>
                                        <div class="text-muted small">@sp.masanpham</div>
                                    </td>

                                    <td>
                                        @string.Format("{0:N0}₫", sp.dongia)
                                    </td>

                                    <td>
                                        <form method="post"
                                              action="@Url.Action("CapNhat", "GioHang", new { area = "" })">
                                            <input type="hidden" name="id" value="@sp.masanpham" />

                                            <div class="d-flex align-items-center gap-2">
                                                <button type="submit"
                                                        name="hanhdong"
                                                        value="bot"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    -
                                                </button>

                                                <span>@soLuong</span>

                                                <button type="submit"
                                                        name="hanhdong"
                                                        value="them"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    +
                                                </button>
                                            </div>
                                        </form>
                                    </td>

                                    <td>
                                        @string.Format("{0:N0}₫", thanhTien)
                                    </td>

                                    <td class="text-center">
                                        <form method="post"
                                              action="@Url.Action("CapNhat", "GioHang", new { area = "" })"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?');">
                                            <input type="hidden" name="id" value="@sp.masanpham" />
                                            <input type="hidden" name="hanhdong" value="xoa" />

                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                    </a>

                    <div class="text-end">
                        <h5 class="mb-1">Tổng tiền:</h5>
                        <h4 class="mb-0 text-danger">
                            @string.Format("{0:N0}₫", tongTien)
                        </h4>
                    </div>
                </div>

                <div class="mt-3 text-end">
                    <a href="@Url.Action("Index", "Home", new { area = "" })"
                       class="btn btn-primary disabled">
                        <i class="bi bi-bag-check"></i> Đặt hàng
                    </a>
                    <div class="text-muted small mt-1">
                        Chức năng đặt hàng sẽ được nối với module hóa đơn ở bước sau.
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-cart-x" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">Giỏ hàng trống</h4>
                    <p class="text-muted">Bạn chưa có sản phẩm nào trong giỏ hàng.</p>

                    <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })"
                       class="btn btn-primary">
                        <i class="bi bi-arrow-left-circle"></i> Xem sản phẩm
                    </a>
                </div>
            }
        </div>
    </div>
</div>