@model List<WebsiteThuongMaiDienTu.Models.sanpham>
@{
    ViewBag.Title = "Giỏ hàng";
    var gioHang = ViewBag.GioHang as System.Collections.Generic.Dictionary<string, int>;
    if (gioHang == null)
    {
        gioHang = new System.Collections.Generic.Dictionary<string, int>();
    }
    decimal tongTien = 0;
    if (ViewBag.TongTien != null)
    {
        tongTien = (decimal)ViewBag.TongTien;
    }
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <h4 class="fw-bold text-dark mb-0">
                <i class="bi bi-cart3 me-2 text-brand-yellow"></i> Giỏ hàng của bạn
            </h4>
        </div>

        @if (TempData["ThongBaoGioHang"] != null)
        {
            <div class="px-4 pt-4">
                <div class="alert alert-success border-0 bg-success-subtle text-success-emphasis rounded-3 d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["ThongBaoGioHang"]</span>
                </div>
            </div>
        }

        @if (TempData["LoiGioHang"] != null)
        {
            <div class="px-4 pt-4">
                <div class="alert alert-danger border-0 bg-danger-subtle text-danger-emphasis rounded-3 d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@TempData["LoiGioHang"]</span>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-uppercase text-secondary small fw-bold py-3 ps-4" style="width: 45%;">Sản phẩm</th>
                            <th class="text-uppercase text-secondary small fw-bold py-3" style="width: 15%;">Đơn giá</th>
                            <th class="text-center text-uppercase text-secondary small fw-bold py-3" style="width: 18%;">Số lượng</th>
                            <th class="text-end text-uppercase text-secondary small fw-bold py-3" style="width: 15%;">Thành tiền</th>
                            <th class="text-center py-3 pe-4" style="width: 7%;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sp in Model)
                        {
                            int soLuong = gioHang.ContainsKey(sp.masanpham) ? gioHang[sp.masanpham] : 0;
                            decimal thanhTien = sp.dongia * soLuong;
                            <tr>
                                <td class="py-3 ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(sp.hinh))
                                        {
                                            <img src="@Url.Content(sp.hinh)" alt="@sp.tensanpham" class="rounded-3 border object-fit-cover flex-shrink-0" style="width: 70px; height: 70px;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-3 border bg-light d-flex align-items-center justify-content-center text-secondary flex-shrink-0" style="width: 70px; height: 70px;">
                                                <i class="bi bi-image opacity-50 fs-4"></i>
                                            </div>
                                        }
                                        <div class="d-flex flex-column">
                                            <strong class="text-dark">@sp.tensanpham</strong>
                                            <span class="text-muted small">@sp.masanpham</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <span class="text-secondary fw-medium">@string.Format("{0:N0}₫", sp.dongia)</span>
                                </td>
                                <td class="py-3">
                                    <div class="d-flex justify-content-center align-items-center gap-1">
                                        <form method="post" action="@Url.Action("CapNhat", "GioHang", new { area = "" })" style="display: contents;">
                                            <input type="hidden" name="id" value="@sp.masanpham" />
                                            <button type="submit" name="hanhdong" value="bot" class="btn btn-sm btn-light border rounded-circle lh-1 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Giảm số lượng">−</button>
                                        </form>
                                        <span class="fw-bold text-dark text-center" style="min-width: 40px;">@soLuong</span>
                                        <form method="post" action="@Url.Action("CapNhat", "GioHang", new { area = "" })" style="display: contents;">
                                            <input type="hidden" name="id" value="@sp.masanpham" />
                                            <button type="submit" name="hanhdong" value="them" class="btn btn-sm btn-light border rounded-circle lh-1 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Tăng số lượng">+</button>
                                        </form>
                                    </div>
                                </td>
                                <td class="py-3 text-end">
                                    <span class="text-danger fw-bold">@string.Format("{0:N0}₫", thanhTien)</span>
                                </td>
                                <td class="py-3 pe-4 text-center">
                                    <form method="post"
                                          action="@Url.Action("CapNhat", "GioHang", new { area = "" })"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?');"
                                          style="display: inline;">
                                        <input type="hidden" name="id" value="@sp.masanpham" />
                                        <input type="hidden" name="hanhdong" value="xoa" />
                                        <button type="submit" class="btn btn-sm btn-light text-danger" title="Xóa khỏi giỏ">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-body border-top p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua sắm
                    </a>
                    <div class="text-end">
                        <div class="text-secondary small text-uppercase fw-bold">Tổng tiền thanh toán</div>
                        <div class="h3 mb-0 text-danger fw-bold">@string.Format("{0:N0}₫", tongTien)</div>
                    </div>
                </div>
                <div class="text-end mt-4">
                    <button type="button" class="btn btn-brand btn-lg px-4 rounded-pill fw-bold shadow-sm" onclick="xuLyDatHang()">
                        <i class="bi bi-bag-check me-1"></i> Đặt hàng
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-cart-x text-muted mb-3 d-block opacity-50" style="font-size: 3.5rem;"></i>
                <h4 class="fw-bold text-dark">Giỏ hàng trống</h4>
                <p class="text-muted mb-4">Bạn chưa có sản phẩm nào trong giỏ hàng.</p>
                <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })" class="btn btn-brand rounded-pill px-4">
                    <i class="bi bi-arrow-left-circle me-1"></i> Xem sản phẩm
                </a>
            </div>
        }
    </div>

    <script>
    // Truyền trạng thái đăng nhập từ Server xuống JS
    var daDangNhap = @(Session["TenDangNhap"] != null ? "true" : "false");

    function xuLyDatHang() {
        // Nếu đã đăng nhập → không hỏi, vào thẳng trang đặt hàng
        if (daDangNhap) {
            window.location.href = '@Url.Action("Index", "DatHang", new { area = "" })';
            return;
        }

        // Chưa đăng nhập → hỏi ý kiến
        var ketQua = confirm("Bạn có muốn đăng ký / đăng nhập không?\n(Có thể bỏ qua)");
        if (ketQua) {
            // Bấm OK → qua trang đăng nhập, đăng nhập xong tự về trang chủ
            window.location.href = '@Url.Action("DangNhap", "TaiKhoan", new { area = "" })';
        } else {
            // Bấm Cancel → qua trang đặt hàng, focus thẳng vào ô họ tên
            window.location.href = '@Url.Action("Index", "DatHang", new { area = "", focus = "1" })';
        }
    }
    </script>
</div>