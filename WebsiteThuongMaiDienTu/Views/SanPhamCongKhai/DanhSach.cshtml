@model List<WebsiteThuongMaiDienTu.Models.sanpham>

@{
    ViewBag.Title = "Danh sách sản phẩm";

    int tongSoSanPham = (int)(ViewBag.TongSoSanPham ?? 0);
    int tongSoTrang = (int)(ViewBag.TongSoTrang ?? 1);
    int trangHienTai = (int)(ViewBag.TrangHienTai ?? 1);

    string maloai = ViewBag.MaLoai as string;
    string tukhoa = ViewBag.TuKhoa as string;
    string tenLoai = ViewBag.TenLoai as string;

    var danhSachLoai = ViewBag.DanhSachLoai as List<WebsiteThuongMaiDienTu.Models.loaisanpham>;
}

<!-- Bộ lọc sản phẩm -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <h5 class="card-title fw-bold text-dark mb-3"><i class="bi bi-funnel me-1 text-brand-yellow"></i> Bộ lọc sản phẩm</h5>
        <form method="get" action="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })">
            <div class="row g-3">
                <div class="col-md-5 col-lg-4">
                    <label class="form-label fw-medium text-dark small mb-1">Loại sản phẩm</label>
                    <select name="maloai" class="form-select">
                        <option value="">-- Tất cả loại --</option>
                        @if (danhSachLoai != null)
                        {
                            foreach (var loai in danhSachLoai)
                            {
                                <option value="@loai.maloaisanpham" @(maloai == loai.maloaisanpham ? "selected" : "")>
                                    @loai.tenloaisanpham
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-7 col-lg-5">
                    <label class="form-label fw-medium text-dark small mb-1">Tìm kiếm</label>
                    <input type="text"
                           name="tukhoa"
                           class="form-control"
                           placeholder="Nhập tên hoặc mô tả..."
                           value="@tukhoa" />
                </div>

                <div class="col-12 col-lg-3 d-flex align-items-end gap-2 mt-3 mt-lg-0">
                    <button type="submit" class="btn btn-brand flex-grow-1">
                        <i class="bi bi-search me-1"></i> Tìm kiếm
                    </button>
                    <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })" class="btn btn-light border px-3" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg text-muted"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Kết quả -->
<div class="d-flex justify-content-between align-items-center mb-4 px-2">
    <div class="text-secondary">
        Tìm thấy <strong class="text-dark">@tongSoSanPham</strong> sản phẩm

        @if (!string.IsNullOrEmpty(tenLoai))
        {
            <span> trong danh mục <strong class="text-brand">@tenLoai</strong></span>
        }

        @if (!string.IsNullOrEmpty(tukhoa))
        {
            <span> với từ khóa "<strong class="text-dark">@tukhoa</strong>"</span>
        }
    </div>
</div>

<!-- Danh sách sản phẩm -->
@if (Model != null && Model.Any())
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 mb-5">
        @foreach (var sp in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 position-relative overflow-hidden">
                    @if (sp.quangcao == true)
                    {
                        <span class="position-absolute top-0 start-0 bg-danger text-white px-2 py-1 small fw-bold rounded-end shadow-sm" style="z-index: 2; border-top-left-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 8px;">
                            <i class="bi bi-star-fill text-warning me-1"></i> Hot
                        </span>
                    }

                    <a href="@Url.Action("ChiTiet", "SanPhamCongKhai", new { id = sp.masanpham, area = "" })" class="text-decoration-none text-dark d-flex flex-column h-100">
                        <div class="position-relative">
                            @if (!string.IsNullOrEmpty(sp.hinh))
                            {
                                <img src="@Url.Content(sp.hinh)" class="card-img-top card-img-fixed-240 object-fit-cover" alt="@sp.tensanpham" />
                            }
                            else
                            {
                                <div class="card-img-top card-img-fixed-240 bg-light d-flex align-items-center justify-content-center text-secondary">
                                    <i class="bi bi-image opacity-50" style="font-size: 3rem;"></i>
                                </div>
                            }
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold mb-2 text-clamp-2" style="min-height: 2.4em;">@sp.tensanpham</h5>
                            <p class="card-text text-muted small mb-3 text-clamp-2 flex-grow-1">@sp.mota</p>

                            <div class="d-flex justify-content-between align-items-end mt-auto">
                                <span class="text-danger fw-bold fs-5">@string.Format("{0:N0}₫", sp.dongia)</span>

                                @if (sp.soluonghienco > 0)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i>Còn hàng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-2 py-1">
                                        <i class="bi bi-x-circle me-1"></i>Hết hàng
                                    </span>
                                }
                            </div>
                        </div>
                    </a>

                    <div class="card-footer bg-white border-top-0 px-4 pb-4 pt-0">
                        @if (sp.soluonghienco > 0)
                        {
                            <form method="post" action="@Url.Action("Them", "GioHang", new { area = "" })">
                                <input type="hidden" name="id" value="@sp.masanpham" />
                                <input type="hidden" name="sl" value="1" />
                                <button type="submit" class="btn btn-brand w-100 rounded-pill fw-medium shadow-sm">
                                    <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100 rounded-pill fw-medium opacity-75" disabled>
                                <i class="bi bi-cart-x me-1"></i> Tạm hết hàng
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Phân trang Bootstrap 5 -->
    if (tongSoTrang > 1)
    {
        <nav aria-label="Page navigation" class="mt-4 mb-5">
            <ul class="pagination justify-content-center">
                @if (trangHienTai > 1)
                {
                    <li class="page-item">
                        <a class="page-link shadow-sm border-0 rounded-circle mx-1 text-dark" href="@Url.Action("DanhSach", "SanPhamCongKhai", new { maloai = maloai, tukhoa = tukhoa, page = trangHienTai - 1, area = "" })" aria-label="Previous">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </a>
                    </li>
                }

                @for (int i = 1; i <= tongSoTrang; i++)
                {
                    if (i == trangHienTai)
                    {
                        <li class="page-item active" aria-current="page">
                            <span class="page-link shadow-sm border-0 rounded-circle mx-1 text-dark text-brand-yellow" style="background- font-weight: bold;">@i</span>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link shadow-sm border-0 rounded-circle mx-1 text-dark" href="@Url.Action("DanhSach", "SanPhamCongKhai", new { maloai = maloai, tukhoa = tukhoa, page = i, area = "" })">
                                @i
                            </a>
                        </li>
                    }
                }

                @if (trangHienTai < tongSoTrang)
                {
                    <li class="page-item">
                        <a class="page-link shadow-sm border-0 rounded-circle mx-1 text-dark" href="@Url.Action("DanhSach", "SanPhamCongKhai", new { maloai = maloai, tukhoa = tukhoa, page = trangHienTai + 1, area = "" })" aria-label="Next">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 my-5">
        <div class="card-body py-5">
            <i class="bi bi-search text-muted mb-3 d-block opacity-50" style="font-size: 3rem;"></i>
            <h4 class="fw-bold text-dark">Không tìm thấy sản phẩm</h4>
            <p class="text-muted mb-4">Không có sản phẩm nào phù hợp với tiêu chí tìm kiếm của bạn</p>

            <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Xem tất cả sản phẩm
            </a>
        </div>
    </div>
}
