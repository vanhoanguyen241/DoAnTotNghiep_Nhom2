@model List<WebsiteThuongMaiDienTu.Models.sanpham>

@{
    ViewBag.Title = "Danh sách sản phẩm";

    int tongSoSanPham = (int)(ViewBag.TongSoSanPham ?? 0);
    int tongSoTrang = (int)(ViewBag.TongSoTrang ?? 1);
    int trangHienTai = (int)(ViewBag.TrangHienTai ?? 1);

    string maloai = ViewBag.MaLoai as string;
    string tukhoa = ViewBag.TuKhoa as string;
    string tenLoai = ViewBag.TenLoai as string;

    var danhSachLoai = ViewBag.DanhSachLoai as List<WebsiteThuongMaiDienTu.Models.loaisanpham>;
}

<!-- Bộ lọc sản phẩm -->
<div class="filter-section">
    <div class="filter-header">
        <h3><i class="bi bi-funnel"></i> Bộ lọc sản phẩm</h3>
    </div>

    <form method="get" action="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })">
        <div class="filter-controls">
            <div class="filter-group">
                <label>Loại sản phẩm</label>
                <select name="maloai" class="form-control">
                    <option value="">-- Tất cả loại --</option>

                    @if (danhSachLoai != null)
                    {
                        foreach (var loai in danhSachLoai)
                        {
                            <option value="@loai.maloaisanpham"
                                    @(maloai == loai.maloaisanpham ? "selected" : "")>
                                @loai.tenloaisanpham
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>Tìm kiếm</label>
                <input type="text"
                       name="tukhoa"
                       class="form-control"
                       placeholder="Nhập tên hoặc mô tả..."
                       value="@tukhoa" />
            </div>

            <button type="submit" class="btn-filter">
                <i class="bi bi-search"></i> Tìm kiếm
            </button>

            <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })" class="btn-clear">
                <i class="bi bi-x-circle"></i> Xóa bộ lọc
            </a>
        </div>
    </form>
</div>

<!-- Kết quả -->
<div class="results-header">
    <div class="results-info">
        Tìm thấy <strong>@tongSoSanPham</strong> sản phẩm

        @if (!string.IsNullOrEmpty(tenLoai))
        {
            <span> trong <strong>@tenLoai</strong></span>
        }

        @if (!string.IsNullOrEmpty(tukhoa))
        {
            <span> với từ khóa "<strong>@tukhoa</strong>"</span>
        }
    </div>
</div>

<!-- Danh sách sản phẩm -->
@if (Model != null && Model.Any())
{
    <div class="product-grid">
        @foreach (var sp in Model)
        {
            <div class="product-card-wrapper">
                @if (sp.quangcao == true)
                {
                    <span class="product-card-hot-badge"><i class="bi bi-star-fill"></i> Hot</span>
                }
                <a href="@Url.Action("ChiTiet", "SanPhamCongKhai", new { id = sp.masanpham, area = "" })" class="product-card">
                    <div class="product-image">
                        @if (!string.IsNullOrEmpty(sp.hinh))
                        {
                            <img src="@Url.Content(sp.hinh)" alt="@sp.tensanpham" />
                        }
                        else
                        {
                            <div class="product-image-placeholder">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                    </div>
                    <div class="product-body">
                        <h4 class="product-name">@sp.tensanpham</h4>
                        <p class="product-description">@sp.mota</p>
                        <div class="product-footer">
                            <span class="product-price">@string.Format("{0:N0}₫", sp.dongia)</span>
                            @if (sp.soluonghienco > 0)
                            {
                                <span class="product-stock in-stock">
                                    <i class="bi bi-check-circle-fill"></i> Còn hàng
                                </span>
                            }
                            else
                            {
                                <span class="product-stock">
                                    <i class="bi bi-x-circle"></i> Hết hàng
                                </span>
                            }
                        </div>
                    </div>
                </a>
                @if (sp.soluonghienco > 0)
                {
                    <div class="product-card-add-btn">
                        <form method="post" action="@Url.Action("Them", "GioHang", new { area = "" })">
                            <input type="hidden" name="id" value="@sp.masanpham" />
                            <input type="hidden" name="sl" value="1" />
                            <button type="submit" class="btn-add">
                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Phân trang đơn giản -->
    if (tongSoTrang > 1)
    {
        <div class="pagination-container">
            <ul class="pagination">
                @if (trangHienTai > 1)
                {
                    <li>
                        <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { maloai = maloai, tukhoa = tukhoa, page = trangHienTai - 1, area = "" })">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                }

                @for (int i = 1; i <= tongSoTrang; i++)
                {
                    if (i == trangHienTai)
                    {
                        <li class="active"><span>@i</span></li>
                    }
                    else
                    {
                        <li>
                            <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { maloai = maloai, tukhoa = tukhoa, page = i, area = "" })">
                                @i
                            </a>
                        </li>
                    }
                }

                @if (trangHienTai < tongSoTrang)
                {
                    <li>
                        <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { maloai = maloai, tukhoa = tukhoa, page = trangHienTai + 1, area = "" })">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
}
else
{
    <div class="empty-state">
        <i class="bi bi-search"></i>
        <h3>Không tìm thấy sản phẩm</h3>
        <p>Không có sản phẩm nào phù hợp với tiêu chí tìm kiếm của bạn</p>

        <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })" class="btn-back-home">
            <i class="bi bi-arrow-left"></i> Xem tất cả sản phẩm
        </a>
    </div>
}