@model WebsiteThuongMaiDienTu.Models.sanpham
@{
    ViewBag.Title = Model.tensanpham;
    string tenLoai = ViewBag.TenLoai as string;
    string tenNSX = ViewBag.TenNSX as string;
}

<div class="product-detail-container">
    <div class="product-detail-card">
        <div class="product-detail-header">
            <h2>@Model.tensanpham</h2>
        </div>
        <div class="product-detail-body">
            <div class="row">
                <!-- Cột ảnh -->
                <div class="col-md-5">
                    <div class="product-detail-gallery">
                        @if (!string.IsNullOrEmpty(Model.hinh))
                        {
                            <img src="@Url.Content(Model.hinh)" alt="@Model.tensanpham" class="product-detail-main-img" />
                        }
                        else
                        {
                            <div class="product-detail-img-placeholder">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                    </div>
                </div>

                <!-- Cột thông tin -->
                <div class="col-md-7">
                    <div class="product-detail-info">
                        <h1 class="product-detail-name">@Model.tensanpham</h1>

                        <!-- Hộp giá -->
                        <div class="product-detail-price-box">
                            <span class="product-detail-price-label">Giá bán</span>
                            <span class="product-detail-price">@string.Format("{0:N0}₫", Model.dongia)</span>
                        </div>

                        <!-- Thông số -->
                        <div class="product-detail-meta">
                            <div class="product-detail-meta-item">
                                <span class="product-detail-meta-label">Mã sản phẩm</span>
                                <span class="product-detail-meta-value" style="font-family: monospace;">@Model.masanpham</span>
                            </div>
                            <div class="product-detail-meta-item">
                                <span class="product-detail-meta-label">Loại sản phẩm</span>
                                <span class="product-detail-meta-value">@tenLoai</span>
                            </div>
                            <div class="product-detail-meta-item">
                                <span class="product-detail-meta-label">Nhà sản xuất</span>
                                <span class="product-detail-meta-value">@tenNSX</span>
                            </div>
                            <div class="product-detail-meta-item">
                                <span class="product-detail-meta-label">Bảo hành</span>
                                <span class="product-detail-meta-value">@Model.thoigianbaohanh tháng</span>
                            </div>
                            <div class="product-detail-meta-item">
                                <span class="product-detail-meta-label">Tình trạng</span>
                                <span class="product-detail-meta-value">
                                    @if (Model.soluonghienco > 0)
                                    {
                                        <span class="stock-badge in-stock">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Còn hàng (@Model.soluonghienco)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge out-of-stock">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Hết hàng
                                        </span>
                                    }
                                </span>
                            </div>
                        </div>

                        <!-- Mô tả -->
                        <div class="product-detail-description">
                            <h5><i class="bi bi-file-text"></i> Mô tả sản phẩm</h5>
                            <p>@Model.mota</p>
                        </div>

                        <!-- Form thêm vào giỏ -->
                        @if (Model.soluonghienco > 0)
                        {
                            <form method="post"
                                  action="@Url.Action("Them", "GioHang", new { area = "" })"
                                  class="add-to-cart-form">
                                <div class="qty-selector">
                                    <label for="sl">Số lượng:</label>
                                    <input type="number"
                                           id="sl"
                                           name="sl"
                                           value="1"
                                           min="1"
                                           max="@Model.soluonghienco"
                                           class="qty-input" />
                                </div>
                                <input type="hidden" name="id" value="@Model.masanpham" />
                                <button type="submit" class="btn-add-to-cart">
                                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="out-of-stock-alert">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>Sản phẩm tạm thời hết hàng. Vui lòng quay lại sau.</span>
                            </div>
                        }

                        <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })" class="btn-back-list">
                            <i class="bi bi-arrow-left"></i> Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>