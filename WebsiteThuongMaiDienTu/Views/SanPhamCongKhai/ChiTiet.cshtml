@model WebsiteThuongMaiDienTu.Models.sanpham
@{
    ViewBag.Title = Model.tensanpham;
    string tenLoai = ViewBag.TenLoai as string;
    string tenNSX = ViewBag.TenNSX as string;
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <div class="row g-4 g-md-5">
                <!-- Cột ảnh -->
                <div class="col-md-5">
                    @if (!string.IsNullOrEmpty(Model.hinh))
                    {
                        <img src="@Url.Content(Model.hinh)" alt="@Model.tensanpham" class="img-fluid w-100 rounded-4 border object-fit-cover" style="max-height: 420px;" />
                    }
                    else
                    {
                        <div class="w-100 rounded-4 border bg-light d-flex align-items-center justify-content-center text-secondary" style="height: 320px;">
                            <i class="bi bi-image opacity-50" style="font-size: 4rem;"></i>
                        </div>
                    }
                </div>

                <!-- Cột thông tin -->
                <div class="col-md-7">
                    <h1 class="h3 fw-bold text-dark mb-3">@Model.tensanpham</h1>

                    <!-- Hộp giá -->
                    <div class="bg-light rounded-4 p-4 mb-4">
                        <div class="text-secondary small text-uppercase fw-bold mb-1">Giá bán</div>
                        <div class="h2 mb-0 text-danger fw-bold">@string.Format("{0:N0}₫", Model.dongia)</div>
                    </div>

                    <!-- Thông số -->
                    <div class="list-group list-group-flush mb-4 border-top border-bottom">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-secondary">Mã sản phẩm</span>
                            <span class="fw-medium text-dark font-monospace">@Model.masanpham</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-secondary">Loại sản phẩm</span>
                            <span class="fw-medium text-dark">@tenLoai</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-secondary">Nhà sản xuất</span>
                            <span class="fw-medium text-dark">@tenNSX</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-secondary">Bảo hành</span>
                            <span class="fw-medium text-dark">@Model.thoigianbaohanh tháng</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-secondary">Tình trạng</span>
                            @if (Model.soluonghienco > 0)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-2">
                                    <i class="bi bi-check-circle-fill me-1"></i> Còn hàng (@Model.soluonghienco)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-2">
                                    <i class="bi bi-x-circle-fill me-1"></i> Hết hàng
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Mô tả -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark mb-2">
                            <i class="bi bi-file-text me-2" style="color: var(--brand-yellow);"></i> Mô tả sản phẩm
                        </h5>
                        <p class="text-secondary mb-0" style="line-height: 1.8;">@Model.mota</p>
                    </div>

                    <!-- Form thêm vào giỏ -->
                    @if (Model.soluonghienco > 0)
                    {
                        <form method="post"
                              action="@Url.Action("Them", "GioHang", new { area = "" })">
                            <div class="row g-3 align-items-end">
                                <div class="col-auto">
                                    <label for="sl" class="form-label fw-medium text-dark small mb-1">Số lượng</label>
                                    <input type="number"
                                           id="sl"
                                           name="sl"
                                           value="1"
                                           min="1"
                                           max="@Model.soluonghienco"
                                           class="form-control text-center fw-bold"
                                           style="width: 100px;" />
                                </div>
                                <div class="col">
                                    <input type="hidden" name="id" value="@Model.masanpham" />
                                    <button type="submit" class="btn btn-brand w-100 py-2 fw-bold rounded-3 shadow-sm">
                                        <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ hàng
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0 bg-warning-subtle text-warning-emphasis rounded-3 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>Sản phẩm tạm thời hết hàng. Vui lòng quay lại sau.</span>
                        </div>
                    }

                    <div class="mt-4">
                        <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>