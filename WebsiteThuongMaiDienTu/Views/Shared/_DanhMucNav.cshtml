@model IEnumerable<WebsiteThuongMaiDienTu.Models.loaisanpham>

<a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })"
   class="nav-dropdown-item d-flex align-items-center gap-2 px-3 py-2
          text-decoration-none text-dark fw-medium rounded-2"
   style="font-size:.9rem;">
    <i class="bi bi-grid-3x3-gap text-secondary"></i> Tất cả
</a>

@if (Model != null && Model.Any())
{
    foreach (var danhmuc in Model)
    {
        <a href="@Url.Action("DanhSach", "SanPhamCongKhai",
                 new { maloai = danhmuc.maloaisanpham, area = "" })"
           class="nav-dropdown-item d-flex align-items-center gap-2 px-3 py-2
                  text-decoration-none text-dark rounded-2"
           style="font-size:.9rem;">
            <i class="bi bi-box text-secondary"></i> @danhmuc.tenloaisanpham
        </a>
    }
}