@model IEnumerable<WebsiteThuongMaiDienTu.Models.loaisanpham>

@*
    Partial view hiển thị danh mục sản phẩm.
    Được gọi từ _Layout.cshtml bằng:
    @Html.Action("DanhMucNav", "Layout")
*@

<ul class="list-unstyled">
    <li>
        <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })">
            <i class="bi bi-grid-3x3-gap"></i> Tất cả sản phẩm
        </a>
    </li>

    @if (Model != null && Model.Any())
    {
        foreach (var danhmuc in Model)
        {
            <li>
                <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { maloai = danhmuc.maloaisanpham, area = "" })">
                    <i class="bi bi-box"></i> @danhmuc.tenloaisanpham
                </a>
            </li>
        }
    }
</ul>