<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - QHVD Tech</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <style>
        .user-dropdown-toggle {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 8px !important;
            cursor: pointer !important;
            text-decoration: none !important;
            color: var(--brand-dark) !important;
            padding: 6px 12px !important;
            border-radius: 8px !important;
            transition: all 0.2s ease !important;
        }

            .user-dropdown-toggle:hover, .user-dropdown-toggle[aria-expanded="true"] {
                background-color: rgba(0, 0, 0, 0.05) !important;
                color: #000 !important;
            }

            .user-dropdown-toggle i.bi-person-circle {
                font-size: 1.4rem !important;
            }

        .dropdown-menu {
            border: 1px solid rgba(0,0,0,0.06) !important;
            border-radius: 12px !important;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
            z-index: 1050 !important;
            padding: 8px !important;
            animation: fadeInDrop 0.2s ease-out !important;
        }

        .dropdown-item {
            display: flex !important;
            align-items: center !important;
            gap: 12px !important;
            padding: 10px 12px !important;
            font-size: 0.9rem !important;
            font-weight: 500 !important;
            color: #333 !important;
            border-radius: 8px !important;
            transition: all 0.2s ease !important;
            margin: 2px 0 !important;
        }

            .dropdown-item i {
                width: 20px !important;
                text-align: center !important;
                font-size: 1.1rem !important;
                flex-shrink: 0;
            }

            .dropdown-item:hover {
                background-color: #FFF8E1 !important;
                color: #000 !important;
                transform: translateX(2px);
            }

        .dropdown-header {
            padding: 8px 12px 4px 12px !important;
            font-size: 0.75rem !important;
            text-transform: uppercase !important;
            letter-spacing: 0.5px !important;
            color: #888 !important;
            font-weight: 700 !important;
        }

        .dropdown-divider {
            border-top: 1px solid #f0f0f0 !important;
            margin: 6px 8px !important;
        }

        .mobile-bottom-nav .dropup .dropdown-menu {
            margin-bottom: 12px !important;
            min-width: 200px !important;
            border-radius: 12px !important;
            bottom: 100% !important;
            top: auto !important;
            left: 50% !important;
            transform: translateX(-50%) !important;
        }

        @@keyframes fadeInDrop {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body>
    @{
        var tenDangNhap = Session["TenDangNhap"] as string;

        var gioHang = Session["GioHang"] as System.Collections.Generic.Dictionary<string, int>;
        int soLuongGioHang = 0;

        if (gioHang != null)
        {
            foreach (var soLuong in gioHang.Values)
            {
                soLuongGioHang += soLuong;
            }
        }
    }

    <header class="site-header">
        <!-- Hàng 1: Logo + Tìm kiếm + Tài khoản/Giỏ hàng -->
        <div class="header-top">
            <div class="site-container header-top-inner">
                <a href="@Url.Action("Index", "Home", new { area = "" })" class="logo">
                    <span class="logo-icon">
                        <img src="~/Content/images/logo.png" alt="QHVD Tech" />
                    </span>
                </a>

                <form class="search-form"
                      role="search"
                      method="get"
                      action="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })">
                    <div class="input-group">
                        <input type="text"
                               name="tukhoa"
                               class="form-control search-input"
                               placeholder="Bạn muốn mua gì hôm nay?" />
                        <button class="btn search-btn" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Dropdown sản phẩm - chỉ hiện trên mobile -->
                <div class="mobile-product-dropdown">
                    <button type="button" class="mobile-product-toggle" id="mobileProductToggle">
                        <i class="bi bi-box-seam"></i>
                        <span class="action-label">Sản phẩm</span>
                        <i class="bi bi-chevron-down nav-caret"></i>
                    </button>
                    <div class="mobile-product-menu" id="mobileProductMenu">
                        @Html.Action("DanhMucNav", "Layout")
                    </div>
                </div>

                <ul class="header-actions list-unstyled mb-0">
                    <li>
                        <a href="@Url.Action("Index", "GioHang", new { area = "" })" class="action-item">
                            <i class="bi bi-cart3"></i>
                            <span class="cart-badge">@soLuongGioHang</span>
                            <span class="action-label">Giỏ hàng</span>
                        </a>
                    </li>

                    @if (!string.IsNullOrEmpty(tenDangNhap))
                    {
                        <li class="nav-item dropdown">
                            <a class="action-item user-dropdown-toggle dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span>Xin chào, <strong>@tenDangNhap</strong></span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><h6 class="dropdown-header">Quản lý tài khoản</h6></li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("ThongTin", "TaiKhoan", new { area = "" })">
                                        <i class="bi bi-person-gear text-primary"></i>
                                        <span>Thông tin tài khoản</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("LichSuDonHang", "TaiKhoan", new { area = "" })">
                                        <i class="bi bi-clock-history text-primary"></i>
                                        <span>Lịch sử mua hàng</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("DoiMatKhau", "TaiKhoan", new { area = "" })">
                                        <i class="bi bi-key text-warning"></i>
                                        <span>Đổi mật khẩu</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("DangXuat", "TaiKhoan", new { area = "" })" style="color: #dc3545 !important;">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Đăng xuất</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a href="@Url.Action("DangNhap", "TaiKhoan", new { area = "" })" class="action-item">
                                <i class="bi bi-person"></i>
                                <span class="action-label">Đăng nhập</span>
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("DangKy", "TaiKhoan", new { area = "" })" class="action-item">
                                <i class="bi bi-person-plus"></i>
                                <span class="action-label">Đăng ký</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Hàng 2: Danh mục sản phẩm -->
        <!-- ===== Thanh nav chính ===== -->
        <nav class="main-nav">
            <div class="site-container main-nav-inner">
                <ul class="main-nav-list">
                    <li>
                        <a href="@Url.Action("Index", "Home", new { area = "" })">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("GioiThieu", "Home", new { area = "" })">
                            <i class="bi bi-info-circle"></i> Giới thiệu
                        </a>
                    </li>
                    <li class="has-dropdown">
                        <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })">
                            <i class="bi bi-box-seam"></i> Sản phẩm <i class="bi bi-chevron-down nav-caret"></i>
                        </a>
                        <div class="nav-dropdown">
                            @Html.Action("DanhMucNav", "Layout")
                        </div>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "TraCuuDonHang", new { area = "" })">
                            <i class="bi bi-search"></i> Tra cứu đơn hàng
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("TuyenDung", "Home", new { area = "" })">
                            <i class="bi bi-briefcase"></i> Tuyển dụng
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("LienHe", "Home", new { area = "" })">
                            <i class="bi bi-envelope"></i> Liên hệ
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <div class="site-container body-content">
        @RenderBody()

        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - QHVD Tech</p>
        </footer>
    </div>

    <!-- Bottom navigation - chỉ hiện trên mobile -->
    <nav class="mobile-bottom-nav">
        <a href="@Url.Action("Index", "Home", new { area = "" })" class="bottom-nav-item">
            <i class="bi bi-house-door"></i>
            <span>Trang chủ</span>
        </a>
        <a href="@Url.Action("Index", "TraCuuDonHang", new { area = "" })" class="bottom-nav-item">
            <i class="bi bi-search"></i>
            <span>Tra cứu</span>
        </a>
        <a href="@Url.Action("GioiThieu", "Home", new { area = "" })" class="bottom-nav-item">
            <i class="bi bi-info-circle"></i>
            <span>Giới thiệu</span>
        </a>
        <a href="@Url.Action("Index", "GioHang", new { area = "" })" class="bottom-nav-item">
            <i class="bi bi-cart3"></i>
            <span>Giỏ hàng</span>
            @if (soLuongGioHang > 0)
            {
                <span class="bottom-nav-badge">@soLuongGioHang</span>
            }
        </a>
        <a href="@Url.Action("LienHe", "Home", new { area = "" })" class="bottom-nav-item">
            <i class="bi bi-envelope"></i>
            <span>Liên hệ</span>
        </a>
        @if (!string.IsNullOrEmpty(tenDangNhap))
        {
            <div class="bottom-nav-item dropup" style="position: relative;">
                <a class="dropdown-toggle text-decoration-none text-dark" href="#" id="mobileUserDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="display: flex; flex-direction: column; align-items: center; width: 100%; cursor: pointer; padding: 4px 0;">
                    <i class="bi bi-person-circle" style="font-size: 1.4rem;"></i>
                    <span style="font-size: 0.7rem; margin-top: 2px;">Tài khoản</span>
                </a>

                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="mobileUserDropdown">
                    <li>
                        <a class="dropdown-item" href="@Url.Action("ThongTin", "TaiKhoan", new { area = "" })">
                            <i class="bi bi-person-gear text-primary"></i> Thông tin
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("LichSuDonHang", "TaiKhoan", new { area = "" })">
                            <i class="bi bi-clock-history text-primary"></i> Lịch sử mua
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("DoiMatKhau", "TaiKhoan", new { area = "" })">
                            <i class="bi bi-key text-warning"></i> Đổi mật khẩu
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("DangXuat", "TaiKhoan", new { area = "" })" style="color: #dc3545 !important;">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <a href="@Url.Action("DangNhap", "TaiKhoan", new { area = "" })" class="bottom-nav-item">
                <i class="bi bi-person"></i><span>Đăng nhập</span>
            </a>
        }
    </nav>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var toggle = document.getElementById('mobileProductToggle');
        var dropdown = toggle ? toggle.closest('.mobile-product-dropdown') : null;
        if (toggle && dropdown) {
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('open');
            });
            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target)) {
                    dropdown.classList.remove('open');
                }
            });
        }

        function setupDropdown(toggleId, menuSelector) {
            var toggleBtn = document.getElementById(toggleId);
            var menu = document.querySelector(menuSelector);

            if (toggleBtn && menu) {
                toggleBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    document.querySelectorAll('.dropdown-menu.show').forEach(function (m) {
                        if (m !== menu) m.classList.remove('show');
                    });
                    menu.classList.toggle('show');
                    toggleBtn.setAttribute('aria-expanded', menu.classList.contains('show'));
                });
                document.addEventListener('click', function (e) {
                    if (!toggleBtn.contains(e.target) && !menu.contains(e.target)) {
                        menu.classList.remove('show');
                        toggleBtn.setAttribute('aria-expanded', 'false');
                    }
                });
            }
        }

        setupDropdown('userDropdown', '.dropdown-menu[aria-labelledby="userDropdown"]');
        setupDropdown('mobileUserDropdown', '.dropdown-menu[aria-labelledby="mobileUserDropdown"]');
    });
</script>

</body>
</html>