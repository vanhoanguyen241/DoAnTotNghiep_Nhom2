<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - QHVD Tech</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @{
        var tenDangNhap = Session["TenDangNhap"] as string;
        var gioHang = Session["GioHang"]
                      as System.Collections.Generic.Dictionary<string, int>;
        int soLuongGioHang = 0;
        if (gioHang != null)
        {
            foreach (var soLuong in gioHang.Values) { soLuongGioHang += soLuong; }
        }
    }

    <header class="site-header sticky-top" style="z-index:1030;">

        <!-- ═══ Hàng 1: Logo + Tìm kiếm + Tài khoản / Giỏ hàng ═══ -->
        <div class="header-top">
            <div class="site-container d-flex align-items-center h-100 gap-3 flex-wrap">

                <!-- Logo -->
                <a href="~/" class="logo text-decoration-none position-relative"
                   style="z-index:2;">
                    <img src="~/Content/images/logo.png"
                         alt="QHVD Tech" class="logo-img" />
                </a>

                <!-- Nút mở danh mục mobile (chỉ hiện < lg) -->
                <button class="btn d-lg-none d-flex align-items-center justify-content-center
               gap-1 fw-semibold text-dark border-0 rounded-3 mobile-menu-btn ms-auto"
                        id="mobileProductToggle" type="button"
                        aria-label="Mở danh mục sản phẩm" aria-expanded="false">
                    <i class="bi bi-list"></i>
                    <span class="d-none d-sm-inline">Sản phẩm</span>
                </button>

                <!-- Tìm kiếm -->
                @using (Html.BeginForm("DanhSach", "SanPhamCongKhai",
                    FormMethod.Get,
                    new { @class = "search-form flex-grow-1 d-flex order-lg-0" }))
                {
                    <div class="search-box d-flex w-100 rounded-pill overflow-hidden shadow-sm
                border border-light-subtle mx-auto">
                        <input type="text" name="tukhoa"
                               class="form-control border-0 rounded-0 ps-3 py-2"
                               placeholder="Bạn cần tìm gì..."
                               style="font-size:.92rem;" />
                        <button type="submit"
                                class="btn btn-brand rounded-0 px-3 d-flex
                       align-items-center">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                }

                <!-- Nhóm icon: Tài khoản + Giỏ hàng (desktop — ẩn < lg) -->
                <div class="d-none d-lg-flex align-items-center gap-3 ms-auto"
                     style="white-space:nowrap;">

                    <!-- Dropdown tài khoản desktop -->
                    @if (!string.IsNullOrEmpty(tenDangNhap))
                    {
                        <div class="dropdown position-relative">
                            <a href="#" class="d-flex align-items-center gap-1
                                              text-dark text-decoration-none fw-semibold"
                               id="userDropdown" role="button" aria-expanded="false"
                               style="font-size:.92rem;">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span>@tenDangNhap</span>
                                <i class="bi bi-chevron-down"
                                   style="font-size:.65rem;"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0
                                       rounded-3 mt-2 py-2"
                                aria-labelledby="userDropdown"
                                style="min-width:200px; z-index:1050;">
                                <li>
                                    <a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2"
                                       href="@Url.Action("ThongTin","TaiKhoan")">
                                        <i class="bi bi-person"></i> Tài khoản của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2"
                                       href="@Url.Action("LichSuDonHang","TaiKhoan")">
                                        <i class="bi bi-clock-history"></i> Lịch sử đơn hàng
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider mx-2" /></li>
                                <li>
                                    <a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2
                                              text-danger"
                                       href="@Url.Action("DangXuat","TaiKhoan")">
                                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("DangNhap","TaiKhoan")"
                           class="d-flex align-items-center gap-1 text-dark
                                  text-decoration-none fw-semibold"
                           style="font-size:.92rem;">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span>Đăng nhập</span>
                        </a>
                    }

                    <!-- Giỏ hàng desktop -->
                    <a href="@Url.Action("Index","GioHang")"
                       class="d-flex align-items-center gap-1 text-dark
                              text-decoration-none fw-semibold position-relative"
                       style="font-size:.92rem;">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span>Giỏ hàng</span>
                        @if (soLuongGioHang > 0)
                        {
                            <span class="cart-badge position-absolute translate-middle
                                         badge rounded-pill bg-danger"
                                  style="top:2px; right:-14px; font-size:.65rem;">
                                @soLuongGioHang
                            </span>
                        }
                    </a>
                </div>

            </div>
        </div>

        <!-- ═══ Dropdown danh mục mobile (click) ═══ -->
        <div class="mobile-product-dropdown" id="mobileProductMenu"
             style="z-index:1050;">
            <div class="site-container py-2">
                @Html.Action("DanhMucNav", "Layout")
            </div>
        </div>

        <!-- ═══ Hàng 2: Nav chính (desktop — ẩn < lg) ═══ -->
        <nav class="main-nav d-none d-lg-block">
            <div class="site-container d-flex justify-content-center align-items-center gap-1 py-0">

                <!-- Trang chủ -->
                <a href="@Url.Action("Index", "Home", new { area = "" })"
                   class="nav-link-item px-3 py-2 text-decoration-none fw-semibold"
                   style="font-size:.93rem;">
                    <i class="bi bi-house-door-fill me-1"></i>Trang chủ
                </a>

                <!-- Dropdown "Sản phẩm" hover -->
                <div class="has-dropdown position-relative">
                    <a href="@Url.Action("DanhSach","SanPhamCongKhai")"
                       class="nav-link-item d-flex align-items-center gap-1
                              px-3 py-2 text-decoration-none fw-semibold"
                       style="font-size:.93rem;">
                        <i class="bi bi-grid-3x3-gap-fill"></i> Sản phẩm
                        <i class="bi bi-chevron-down" style="font-size:.6rem;"></i>
                    </a>
                    <div class="nav-dropdown position-absolute bg-white shadow rounded-3
                                border-0 py-2" style="min-width:220px; z-index:100;">
                        @Html.Action("DanhMucNav", "Layout")
                    </div>
                </div>

                <a href="@Url.Action("Index","TraCuuDonHang")"
                   class="nav-link-item px-3 py-2 text-decoration-none fw-semibold"
                   style="font-size:.93rem;">
                    <i class="bi bi-search me-1"></i>Tra cứu đơn hàng
                </a>
                <a href="@Url.Action("GioiThieu","Home")"
                   class="nav-link-item px-3 py-2 text-decoration-none fw-semibold"
                   style="font-size:.93rem;">
                    <i class="bi bi-info-circle me-1"></i>Giới thiệu
                </a>
                <a href="@Url.Action("TuyenDung","Home")"
                   class="nav-link-item px-3 py-2 text-decoration-none fw-semibold"
                   style="font-size:.93rem;">
                    <i class="bi bi-briefcase me-1"></i>Tuyển dụng
                </a>
                <a href="@Url.Action("LienHe","Home")"
                   class="nav-link-item px-3 py-2 text-decoration-none fw-semibold"
                   style="font-size:.93rem;">
                    <i class="bi bi-telephone me-1"></i>Liên hệ
                </a>
            </div>
        </nav>

    </header>

    <!-- ═══ Nội dung chính ═══ -->
    <main class="body-content site-container py-3">
        @RenderBody()
    </main>

    <!-- ═══ Footer ═══ -->
    <footer class="site-footer bg-dark text-white pt-5 pb-4">
        <div class="site-container">
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <h5 class="fw-bold mb-3">QHVD Tech</h5>
                    <p class="text-white-50 mb-1" style="font-size:.9rem;">
                        Cửa hàng công nghệ uy tín — Giá tốt mỗi ngày
                    </p>
                    <p class="text-white-50" style="font-size:.9rem;">
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        123 Đường ABC, Quận XYZ, TP.HCM
                    </p>
                </div>
                <div class="col-6 col-md-4">
                    <h6 class="fw-bold mb-3">Liên kết</h6>
                    <ul class="list-unstyled" style="font-size:.9rem;">
                        <li class="mb-2">
                            <a href="@Url.Action("GioiThieu","Home")"
                               class="text-white-50 text-decoration-none">Giới thiệu</a>
                        </li>
                        <li class="mb-2">
                            <a href="@Url.Action("LienHe","Home")"
                               class="text-white-50 text-decoration-none">Liên hệ</a>
                        </li>
                        <li class="mb-2">
                            <a href="@Url.Action("DanhSach","SanPhamCongKhai")"
                               class="text-white-50 text-decoration-none">Sản phẩm</a>
                        </li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <h6 class="fw-bold mb-3">Hỗ trợ</h6>
                    <ul class="list-unstyled" style="font-size:.9rem;">
                        <li class="mb-2">
                            <a href="@Url.Action("Index","TraCuuDonHang")"
                               class="text-white-50 text-decoration-none">Tra cứu đơn hàng</a>
                        </li>
                        <li class="mb-2">
                            <a href="@Url.Action("TuyenDung","Home")"
                               class="text-white-50 text-decoration-none">Tuyển dụng</a>
                        </li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <p class="text-center text-white-50 mb-0" style="font-size:.85rem;">
                &copy; @DateTime.Now.Year QHVD Tech — All rights reserved.
            </p>
        </div>
    </footer>

    <!-- ═══ Bottom Nav Mobile (< lg) ═══ -->
    <nav class="mobile-bottom-nav d-flex d-lg-none" style="z-index:1035;">
        <a href="~/" class="bottom-nav-item text-decoration-none">
            <i class="bi bi-house-door-fill"></i>
            <span>Trang chủ</span>
        </a>
        <a href="@Url.Action("Index","TraCuuDonHang")"
           class="bottom-nav-item text-decoration-none">
            <i class="bi bi-search"></i>
            <span>Tra cứu</span>
        </a>
        <a href="@Url.Action("GioiThieu","Home")"
           class="bottom-nav-item text-decoration-none">
            <i class="bi bi-info-circle"></i>
            <span>Giới thiệu</span>
        </a>
        <a href="@Url.Action("Index","GioHang")"
           class="bottom-nav-item text-decoration-none position-relative">
            <i class="bi bi-cart3"></i>
            <span>Giỏ hàng</span>
            @if (soLuongGioHang > 0)
            {
                <span class="bottom-nav-badge position-absolute badge rounded-pill
                             bg-danger"
                      style="top:2px; right:50%; transform:translateX(120%);
                             font-size:.6rem;">
                    @soLuongGioHang
                </span>
            }
        </a>
        <a href="@Url.Action("LienHe","Home")"
           class="bottom-nav-item text-decoration-none">
            <i class="bi bi-telephone"></i>
            <span>Liên hệ</span>
        </a>

        <!-- Tài khoản (dropup hoặc link đăng nhập) -->
        @if (!string.IsNullOrEmpty(tenDangNhap))
        {
            <div class="dropup bottom-nav-item position-relative">
                <a href="#" class="d-flex flex-column align-items-center
                                   text-decoration-none"
                   id="mobileUserDropdown" role="button" aria-expanded="false">
                    <i class="bi bi-person-circle"></i>
                    <span>Tài khoản</span>
                </a>
                <ul class="dropdown-menu shadow border-0 rounded-3 py-2 mb-2"
                    aria-labelledby="mobileUserDropdown"
                    style="min-width:200px; z-index:1050;">
                    <li>
                        <a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2"
                           href="@Url.Action("ThongTin","TaiKhoan")">
                            <i class="bi bi-person"></i> Tài khoản của tôi
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2"
                           href="@Url.Action("LichSuDonHang","TaiKhoan")">
                            <i class="bi bi-clock-history"></i> Lịch sử đơn
                        </a>
                    </li>
                    <li><hr class="dropdown-divider mx-2" /></li>
                    <li>
                        <a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2
                                  text-danger"
                           href="@Url.Action("DangXuat","TaiKhoan")">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <a href="@Url.Action("DangNhap","TaiKhoan")"
               class="bottom-nav-item text-decoration-none">
                <i class="bi bi-person-circle"></i>
                <span>Đăng nhập</span>
            </a>
        }
    </nav>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

<script>
    /* ── Mobile product dropdown toggle ── */
    (function () {
        var toggle = document.getElementById('mobileProductToggle');
        var menu = document.getElementById('mobileProductMenu');
        if (toggle && menu) {
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                menu.classList.toggle('open');
            });
            document.addEventListener('click', function (e) {
                if (!menu.contains(e.target) && e.target !== toggle) {
                    menu.classList.remove('open');
                }
            });
        }
    })();

    /* ── Dropdown tài khoản: bấm icon để mở, bấm lần nữa để đóng (toggle) ── */
    function setupDropdown(triggerId) {
        var trigger = document.getElementById(triggerId);
        if (!trigger) return;
        var menu = trigger.nextElementSibling
            || trigger.parentElement.querySelector('.dropdown-menu');
        if (!menu) return;

        trigger.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var isOpen = menu.classList.contains('show');

            // Đóng tất cả dropdown đang mở (kể cả chính nó)
            document.querySelectorAll('.dropdown-menu.show')
                .forEach(function (m) { m.classList.remove('show'); });
            // Reset aria-expanded của cả 2 trigger
            ['userDropdown', 'mobileUserDropdown'].forEach(function (id) {
                var t = document.getElementById(id);
                if (t) t.setAttribute('aria-expanded', 'false');
            });

            // Nếu trước đó đang đóng -> mở; đang mở -> đã bị đóng ở trên, không mở lại
            if (!isOpen) {
                menu.classList.add('show');
                trigger.setAttribute('aria-expanded', 'true');
            }
        });

        // Bấm ra ngoài vùng trigger + menu thì đóng
        document.addEventListener('click', function (e) {
            if (!menu.contains(e.target) && !trigger.contains(e.target)) {
                menu.classList.remove('show');
                trigger.setAttribute('aria-expanded', 'false');
            }
        });
    }
    setupDropdown('userDropdown');
    setupDropdown('mobileUserDropdown');
</script>
</body>
</html>