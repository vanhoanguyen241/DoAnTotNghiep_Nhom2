@model IEnumerable<WebsiteThuongMaiDienTu.Models.sanpham>

@{
    ViewBag.Title = "Trang chủ";
}

<!-- Bootstrap 5 Carousel -->
<div id="heroBannerCarousel" class="carousel slide hero-carousel mb-5 shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroBannerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#heroBannerCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#heroBannerCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="carousel-content">
                <div>
                    <img src="~/Content/images/banner1.png" class="d-block w-100 object-fit-cover" style="max-height: 400px; min-height: 200px;" alt="Banner 1" />
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <div class="carousel-content">
                <div>
                    <img src="~/Content/images/banner2.png" class="d-block w-100 object-fit-cover" style="max-height: 400px; min-height: 200px;" alt="Banner 2" />
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <div class="carousel-content">
                <div>
                    <img src="~/Content/images/banner3.png" class="d-block w-100 object-fit-cover" style="max-height: 400px; min-height: 200px;" alt="Banner 3" />
                </div>
            </div>
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#heroBannerCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroBannerCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!-- Featured Products Section -->
<section id="featured-products" class="mb-5">
    <div class="text-center mb-5">
        <h3 class="fw-bold text-dark mb-2">
            <i class="bi bi-star-fill me-2 text-brand-yellow"></i>
            Sản phẩm nổi bật
        </h3>
        <p class="text-muted">Những sản phẩm được khách hàng yêu thích nhất</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
            @foreach (var sp in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 position-relative overflow-hidden">
                        @if (sp.quangcao == true)
                        {
                            <span class="position-absolute top-0 start-0 bg-danger text-white px-2 py-1 small fw-bold rounded-end shadow-sm" style="z-index: 2; border-top-left-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 8px;">
                                <i class="bi bi-star-fill text-warning me-1"></i> Hot
                            </span>
                        }

                        <a href="@Url.Action("ChiTiet", "SanPhamCongKhai", new { id = sp.masanpham, area = "" })" class="text-decoration-none text-dark d-flex flex-column h-100">
                            <div class="position-relative">
                                @if (!string.IsNullOrEmpty(sp.hinh))
                                {
                                    <img src="@Url.Content(sp.hinh)" class="card-img-top card-img-fixed-240 object-fit-cover" alt="@sp.tensanpham" />
                                }
                                else
                                {
                                    <div class="card-img-top card-img-fixed-240 bg-light d-flex align-items-center justify-content-center text-secondary">
                                        <i class="bi bi-image opacity-50" style="font-size: 3rem;"></i>
                                    </div>
                                }
                            </div>

                            <div class="card-body d-flex flex-column p-4">
                                <h5 class="card-title fw-bold mb-2 text-clamp-2" style="min-height: 2.4em;">@sp.tensanpham</h5>
                                <p class="card-text text-muted small mb-3 text-clamp-2 flex-grow-1">@sp.mota</p>

                                <div class="d-flex justify-content-between align-items-end mt-auto">
                                    <span class="text-danger fw-bold fs-5">@string.Format("{0:N0}₫", sp.dongia)</span>

                                    @if (sp.soluonghienco > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Còn hàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-2 py-1">
                                            <i class="bi bi-x-circle me-1"></i>Hết hàng
                                        </span>
                                    }
                                </div>
                            </div>
                        </a>

                        <div class="card-footer bg-white border-top-0 px-4 pb-4 pt-0">
                            @if (sp.soluonghienco > 0)
                            {
                                <form method="post" action="@Url.Action("Them", "GioHang", new { area = "" })">
                                    <input type="hidden" name="id" value="@sp.masanpham" />
                                    <input type="hidden" name="sl" value="1" />
                                    <button type="submit" class="btn btn-brand w-100 rounded-pill fw-medium shadow-sm">
                                        <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100 rounded-pill fw-medium opacity-75" disabled>
                                    <i class="bi bi-cart-x me-1"></i> Tạm hết hàng
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <i class="bi bi-inbox text-muted mb-3 d-block" style="font-size: 3rem;"></i>
                <h4 class="fw-bold text-dark">Chưa có sản phẩm nổi bật</h4>
                <p class="text-muted mb-0">Hệ thống đang cập nhật sản phẩm mới</p>
            </div>
        </div>
    }
</section>

@section scripts {
    <script>
        // Auto-start carousel
        document.addEventListener('DOMContentLoaded', function () {
            var carousel = new bootstrap.Carousel(document.getElementById('heroBannerCarousel'), {
                interval: 4000,
                wrap: true,
                keyboard: true,
                pause: 'hover'
            });
        });
    </script>
}
