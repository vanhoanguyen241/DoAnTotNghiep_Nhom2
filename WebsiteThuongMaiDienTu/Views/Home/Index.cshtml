@model IEnumerable<WebsiteThuongMaiDienTu.Models.sanpham>

@{
    ViewBag.Title = "Trang chủ";
}

<!-- Bootstrap 5 Carousel -->
<div id="heroBannerCarousel" class="carousel slide hero-carousel" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroBannerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#heroBannerCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#heroBannerCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="carousel-content">
                <div>
                    <img src="~/Content/images/banner1.png" />
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <div class="carousel-content">
                <div>
                    <img src="~/Content/images/banner2.png" />
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <div class="carousel-content">
                <div>
                    <img src="~/Content/images/banner3.png" />
                </div>
            </div>
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#heroBannerCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroBannerCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!-- Featured Products Section -->
<section id="featured-products">
    <div class="section-header">
        <h3>
            <i class="bi bi-star-fill" style="color: var(--brand-yellow);"></i>
            Sản phẩm nổi bật
        </h3>
        <p>Những sản phẩm được khách hàng yêu thích nhất</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="product-grid">
            @foreach (var sp in Model)
            {
                <div class="product-card">
                    <a href="@Url.Action("ChiTiet", "SanPhamCongKhai", new { id = sp.masanpham, area = "" })">
                        <div class="product-image">
                            @if (!string.IsNullOrEmpty(sp.hinh))
                            {
                                <img src="@Url.Content(sp.hinh)" alt="@sp.tensanpham" />
                            }
                            else
                            {
                                <div class="product-image-placeholder">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                        </div>

                        <div class="product-body">
                            <h4 class="product-name">@sp.tensanpham</h4>
                            <p class="product-description">@sp.mota</p>

                            <div class="product-footer">
                                <span class="product-price">
                                    @string.Format("{0:N0}₫", sp.dongia)
                                </span>

                                @if (sp.soluonghienco > 0)
                                {
                                    <span class="product-stock in-stock">
                                        <i class="bi bi-check-circle-fill"></i> Còn hàng
                                    </span>
                                }
                                else
                                {
                                    <span class="product-stock">
                                        <i class="bi bi-x-circle"></i> Hết hàng
                                    </span>
                                }
                            </div>
                        </div>
                    </a>

                    @if (sp.soluonghienco > 0)
                    {
                        <form method="post"
                              action="@Url.Action("Them", "GioHang", new { area = "" })"
                              class="mt-2 px-3 pb-3">
                            <input type="hidden" name="id" value="@sp.masanpham" />
                            <input type="hidden" name="sl" value="1" />

                            <button type="submit" class="btn btn-sm btn-primary w-100">
                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h4>Chưa có sản phẩm nổi bật</h4>
            <p>Hệ thống đang cập nhật sản phẩm mới</p>
        </div>
    }
</section>

@section scripts {
    <script>
        // Auto-start carousel
        document.addEventListener('DOMContentLoaded', function () {
            var carousel = new bootstrap.Carousel(document.getElementById('heroBannerCarousel'), {
                interval: 4000,
                wrap: true,
                keyboard: true,
                pause: 'hover'
            });
        });
    </script>
}
