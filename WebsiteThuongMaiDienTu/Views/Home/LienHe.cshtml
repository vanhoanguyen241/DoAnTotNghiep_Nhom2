@{
    ViewBag.Title = "Liên hệ";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-5">
                <h3 class="fw-bold text-dark"><i class="bi bi-geo-alt-fill me-2 text-brand-yellow"></i> Liên hệ với QHVD Tech</h3>
                <p class="text-muted">Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn</p>
            </div>

            <div class="row g-5">
                <!-- Thông tin liên hệ -->
                <div class="col-md-5">
                    <div class="p-4 bg-light h-100 rounded-4">
                        <h5 class="fw-bold text-dark mb-4"><i class="bi bi-building me-2 text-brand-yellow"></i> Thông tin cửa hàng</h5>

                        <div class="d-flex align-items-start gap-3 mb-4">
                            <i class="bi bi-geo-alt-fill text-brand-red" style="font-size: 1.5rem; flex-shrink: 0;"></i>
                            <div>
                                <strong class="text-dark">Trụ sở chính</strong><br>
                                <span class="text-secondary small">123 Đường ABC, Quận XYZ, TP. Hồ Chí Minh</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3 mb-4">
                            <i class="bi bi-telephone-fill text-brand-green" style="font-size: 1.5rem; flex-shrink: 0;"></i>
                            <div>
                                <strong class="text-dark">Hotline bán hàng</strong><br>
                                <a href="tel:19001234" class="text-decoration-none fw-bold text-primary">1900 1234</a>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3 mb-4">
                            <i class="bi bi-headset text-brand-blue" style="font-size: 1.5rem; flex-shrink: 0;"></i>
                            <div>
                                <strong class="text-dark">Hotline bảo hành</strong><br>
                                <a href="tel:18005678" class="text-decoration-none fw-bold text-primary">1800 5678</a>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3 mb-4">
                            <i class="bi bi-envelope-fill text-brand-orange" style="font-size: 1.5rem; flex-shrink: 0;"></i>
                            <div>
                                <strong class="text-dark">Email</strong><br>
                                <a href="mailto:contact@qhvdtech.com" class="text-decoration-none text-primary">contact@qhvdtech.com</a>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3">
                            <i class="bi bi-clock-fill" style="font-size: 1.5rem; color: #6c757d; flex-shrink: 0;"></i>
                            <div>
                                <strong class="text-dark">Giờ làm việc</strong><br>
                                <span class="text-secondary small">Thứ 2 - Chủ nhật: 8:00 - 21:30</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form liên hệ -->
                <div class="col-md-7">
                    <h5 class="fw-bold text-dark mb-4"><i class="bi bi-chat-dots-fill me-2 text-brand-yellow"></i> Gửi thắc mắc cho chúng tôi</h5>
                    <form method="post" action="#">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-medium text-dark small mb-1">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" placeholder="Nhập họ tên..." required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium text-dark small mb-1">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control" placeholder="Nhập SĐT..." required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-medium text-dark small mb-1">Email</label>
                                <input type="email" class="form-control" placeholder="Nhập email của bạn..." />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-medium text-dark small mb-1">Chủ đề</label>
                                <select class="form-select">
                                    <option value="">-- Chọn chủ đề --</option>
                                    <option>Tư vấn mua hàng</option>
                                    <option>Hỗ trợ bảo hành</option>
                                    <option>Khiếu nại dịch vụ</option>
                                    <option>Hợp tác kinh doanh</option>
                                    <option>Khác</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-medium text-dark small mb-1">Nội dung <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="5" placeholder="Nhập nội dung cần hỗ trợ..." required></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-brand w-100 py-3 fw-bold rounded-3 shadow-sm">
                                    <i class="bi bi-send-fill me-1"></i> Gửi liên hệ
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>