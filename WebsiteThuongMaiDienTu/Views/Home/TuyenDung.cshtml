@{
    ViewBag.Title = "Tuyển dụng";
}

<div class="container py-5">
    <!-- Banner -->
    <div class="card border-0 shadow-sm rounded-4 text-center mb-5 overflow-hidden" style="background: linear-gradient(135deg, #FBD808 0%, #F0C400 100%);">
        <div class="card-body" style="padding: 60px 20px;">
            <h1 class="fw-bold text-dark" style="font-size: 2.5rem;">Gia nhập đội ngũ QHVD Tech</h1>
            <p class="lead mt-3 mb-0" style="color: #333;">Nơi khởi đầu sự nghiệp công nghệ của bạn</p>
        </div>
    </div>

    <!-- Tại sao chọn chúng tôi -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-5">
                <h3 class="fw-bold text-dark"><i class="bi bi-trophy-fill me-2" style="color: var(--brand-yellow);"></i> Tại sao chọn QHVD Tech?</h3>
            </div>
            <div class="row g-5">
                <div class="col-md-6">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-cash-stack" style="font-size: 2.5rem; color: var(--brand-yellow); flex-shrink: 0;"></i>
                        <div>
                            <h5 class="fw-bold text-dark mb-2">Thu nhập hấp dẫn</h5>
                            <p class="text-secondary mb-0">Mức lương cạnh tranh, thưởng doanh số không giới hạn, review lương 6 tháng/lần.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-graph-up-arrow" style="font-size: 2.5rem; color: var(--brand-yellow); flex-shrink: 0;"></i>
                        <div>
                            <h5 class="fw-bold text-dark mb-2">Lộ trình thăng tiến rõ ràng</h5>
                            <p class="text-secondary mb-0">Được đào tạo bài bản, cơ hội thăng tiến lên Quản lý, Trưởng phòng.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-heart-pulse-fill" style="font-size: 2.5rem; color: var(--brand-red); flex-shrink: 0;"></i>
                        <div>
                            <h5 class="fw-bold text-dark mb-2">Chế độ đãi ngộ tốt</h5>
                            <p class="text-secondary mb-0">Đóng BHXH đầy đủ, bảo hiểm sức khỏe cao cấp, du lịch hàng năm.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-emoji-smile-fill" style="font-size: 2.5rem; color: #2E7D32; flex-shrink: 0;"></i>
                        <div>
                            <h5 class="fw-bold text-dark mb-2">Môi trường năng động</h5>
                            <p class="text-secondary mb-0">Đội ngũ trẻ trung, sáng tạo, sếp tâm lý, sẵn sàng support bạn.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vị trí tuyển dụng -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h3 class="fw-bold text-dark mb-0"><i class="bi bi-briefcase-fill me-2" style="color: var(--brand-yellow);"></i> Vị trí đang tuyển</h3>
                <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-2 fs-6">03 Vị trí</span>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-uppercase text-secondary small fw-bold py-3">Vị trí</th>
                            <th class="text-uppercase text-secondary small fw-bold py-3">Phòng ban</th>
                            <th class="text-uppercase text-secondary small fw-bold py-3">Mức lương</th>
                            <th class="text-center text-uppercase text-secondary small fw-bold py-3" style="width: 120px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="py-3"><strong class="text-dark">Nhân viên Kinh doanh (Sales)</strong></td>
                            <td class="py-3 text-secondary">Phòng Kinh doanh</td>
                            <td class="py-3"><span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3">10 - 25 Triệu</span></td>
                            <td class="text-center py-3">
                                <a href="mailto:hr@qhvdtech.com?subject=Ung tuyen Sales" class="btn btn-sm btn-brand px-3 rounded-pill" title="Ứng tuyển">
                                    <i class="bi bi-send-fill me-1"></i> Gửi CV
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-3"><strong class="text-dark">Kỹ thuật viên Phần cứng</strong></td>
                            <td class="py-3 text-secondary">Phòng Kỹ thuật</td>
                            <td class="py-3"><span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3">12 - 20 Triệu</span></td>
                            <td class="text-center py-3">
                                <a href="mailto:hr@qhvdtech.com?subject=Ung tuyen Ky Thuat" class="btn btn-sm btn-brand px-3 rounded-pill" title="Ứng tuyển">
                                    <i class="bi bi-send-fill me-1"></i> Gửi CV
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-3"><strong class="text-dark">Chăm sóc Khách hàng (CSKH)</strong></td>
                            <td class="py-3 text-secondary">Phòng CSKH</td>
                            <td class="py-3"><span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3">9 - 15 Triệu</span></td>
                            <td class="text-center py-3">
                                <a href="mailto:hr@qhvdtech.com?subject=Ung tuyen CSKH" class="btn btn-sm btn-brand px-3 rounded-pill" title="Ứng tuyển">
                                    <i class="bi bi-send-fill me-1"></i> Gửi CV
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="alert alert-info border-0 bg-info-subtle text-info-emphasis rounded-4 mb-0 p-4">
                <div class="d-flex gap-3">
                    <i class="bi bi-info-circle-fill fs-3 text-info"></i>
                    <div>
                        <strong class="d-block mb-1">Gửi CV của bạn về: <a href="mailto:hr@qhvdtech.com" class="text-decoration-none fw-bold text-info-emphasis">hr@qhvdtech.com</a></strong>
                        <p class="mb-0 text-info-emphasis opacity-75 small">Tiêu đề email ghi rõ: [Họ tên] - [Vị trí ứng tuyển]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>