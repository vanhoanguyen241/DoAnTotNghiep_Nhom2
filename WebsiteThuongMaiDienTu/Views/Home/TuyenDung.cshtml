@{
    ViewBag.Title = "Tuyển dụng";
}

<div class="kh-container">
    <!-- Banner -->
    <div class="kh-card text-center mb-4" style="background: linear-gradient(135deg, #FBD808 0%, #F0C400 100%); padding: 60px 20px;">
        <h1 style="color: var(--brand-dark); font-size: 2.5rem; font-weight: 800;">Gia nhập đội ngũ QHVD Tech</h1>
        <p class="lead mt-3 mb-0" style="color: #333;">Nơi khởi đầu sự nghiệp công nghệ của bạn</p>
    </div>

    <!-- Tại sao chọn chúng tôi -->
    <div class="kh-card mb-4">
        <div class="section-header">
            <h3><i class="bi bi-trophy-fill" style="color: var(--brand-yellow);"></i> Tại sao chọn QHVD Tech?</h3>
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-cash-stack" style="font-size: 2rem; color: var(--brand-yellow); flex-shrink: 0;"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Thu nhập hấp dẫn</h5>
                        <p class="text-muted mb-0">Mức lương cạnh tranh, thưởng doanh số không giới hạn, review lương 6 tháng/lần.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-graph-up-arrow" style="font-size: 2rem; color: var(--brand-yellow); flex-shrink: 0;"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Lộ trình thăng tiến rõ ràng</h5>
                        <p class="text-muted mb-0">Được đào tạo bài bản, cơ hội thăng tiến lên Quản lý, Trưởng phòng.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-heart-pulse-fill" style="font-size: 2rem; color: var(--brand-red); flex-shrink: 0;"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Chế độ đãi ngộ tốt</h5>
                        <p class="text-muted mb-0">Đóng BHXH đầy đủ, bảo hiểm sức khỏe cao cấp, du lịch hàng năm.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-emoji-smile-fill" style="font-size: 2rem; color: #2E7D32; flex-shrink: 0;"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Môi trường năng động</h5>
                        <p class="text-muted mb-0">Đội ngũ trẻ trung, sáng tạo, sếp tâm lý, sẵn sàng support bạn.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vị trí tuyển dụng -->
    <div class="kh-card">
        <div class="section-header d-flex justify-content-between align-items-center">
            <h3><i class="bi bi-briefcase-fill" style="color: var(--brand-yellow);"></i> Vị trí đang tuyển</h3>
            <span class="sp-badge sp-badge-success">03 Vị trí</span>
        </div>

        <div class="table-responsive">
            <table class="kh-table">
                <thead>
                    <tr>
                        <th>Vị trí</th>
                        <th>Phòng ban</th>
                        <th>Mức lương</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Nhân viên Kinh doanh (Sales)</strong></td>
                        <td>Phòng Kinh doanh</td>
                        <td><span class="sp-badge sp-badge-warning">10 - 25 Triệu</span></td>
                        <td class="text-center">
                            <a href="mailto:hr@qhvdtech.com?subject=Ung tuyen Sales" class="btn-icon btn-sua" title="Ứng tuyển">
                                <i class="bi bi-send-fill"></i>
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Kỹ thuật viên Phần cứng</strong></td>
                        <td>Phòng Kỹ thuật</td>
                        <td><span class="sp-badge sp-badge-warning">12 - 20 Triệu</span></td>
                        <td class="text-center">
                            <a href="mailto:hr@qhvdtech.com?subject=Ung tuyen Ky Thuat" class="btn-icon btn-sua" title="Ứng tuyển">
                                <i class="bi bi-send-fill"></i>
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Chăm sóc Khách hàng (CSKH)</strong></td>
                        <td>Phòng CSKH</td>
                        <td><span class="sp-badge sp-badge-warning">9 - 15 Triệu</span></td>
                        <td class="text-center">
                            <a href="mailto:hr@qhvdtech.com?subject=Ung tuyen CSKH" class="btn-icon btn-sua" title="Ứng tuyển">
                                <i class="bi bi-send-fill"></i>
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="alert alert-info mt-4 mb-0">
            <i class="bi bi-info-circle-fill"></i>
            <strong>Gửi CV của bạn về:</strong> <a href="mailto:hr@qhvdtech.com" class="fw-bold">hr@qhvdtech.com</a>
            <br><small class="text-muted">Tiêu đề email ghi rõ: [Họ tên] - [Vị trí ứng tuyển]</small>
        </div>
    </div>
</div>