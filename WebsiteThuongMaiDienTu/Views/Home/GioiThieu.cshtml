@{
    ViewBag.Title = "Giới thiệu về QHVD Tech";
}

<div class="container py-5">
    <!-- Banner -->
    <div class="card border-0 shadow-sm rounded-4 text-center mb-5 overflow-hidden" style="background: linear-gradient(135deg, #1A1A1A 0%, #333 100%); color: #fff;">
        <div class="card-body" style="padding: 60px 20px;">
            <h1 class="fw-bold text-brand-yellow" style="font-size: 2.5rem;">Về QHVD Tech</h1>
            <p class="lead mt-3 mb-0 opacity-75">Hệ thống bán lẻ thiết bị điện tử & máy tính hàng đầu</p>
        </div>
    </div>

    <!-- Câu chuyện -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 pt-5 pb-5">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark"><i class="bi bi-bookmark-star-fill me-2 text-brand-yellow"></i> Câu chuyện của chúng tôi</h3>
            </div>
            <div class="mx-auto" style="max-width: 800px;">
                <p class="text-secondary" style="font-size: 1.05rem; line-height: 1.8;">
                    <strong class="text-dark">QHVD Tech</strong> được thành lập với sứ mệnh mang đến những sản phẩm công nghệ tiên tiến nhất, chất lượng nhất đến tay người tiêu dùng Việt Nam.
                    Trải qua nhiều năm phát triển, chúng tôi tự hào là điểm đến tin cậy của hàng triệu khách hàng trên cả nước trong lĩnh vực kinh doanh máy tính,
                    linh kiện điện tử và các thiết bị công nghệ thông minh.
                </p>
                <p class="text-secondary mb-0" style="font-size: 1.05rem; line-height: 1.8;">
                    Với hệ thống cửa hàng trải dài khắp các tỉnh thành, cùng đội ngũ nhân viên am hiểu công nghệ, nhiệt huyết,
                    QHVD Tech cam kết mang lại trải nghiệm mua sắm tuyệt vời nhất với chính sách bảo hành minh bạch, hậu mãi chu đáo.
                </p>
            </div>
        </div>
    </div>

    <!-- Tầm nhìn & Sứ mệnh -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-eye-fill text-brand-yellow" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="text-center fw-bold text-dark mb-3">Tầm nhìn</h4>
                    <p class="text-center text-secondary mb-0">
                        Trở thành hệ thống bán lẻ thiết bị công nghệ số 1 Việt Nam, là cầu nối đưa công nghệ thế giới đến gần hơn với mọi gia đình Việt.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-rocket-takeoff-fill text-brand-yellow" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="text-center fw-bold text-dark mb-3">Sứ mệnh</h4>
                    <p class="text-center text-secondary mb-0">
                        Cung cấp các giải pháp công nghệ toàn diện, sản phẩm chính hãng 100% với dịch vụ chăm sóc khách hàng tận tâm, vượt trội.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Giá trị cốt lõi -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-5">
            <div class="text-center mb-5">
                <h3 class="fw-bold text-dark"><i class="bi bi-gem me-2 text-brand-yellow"></i> Giá trị cốt lõi</h3>
            </div>
            <div class="row g-4 text-center">
                <div class="col-md-3 col-6">
                    <div class="p-3 border-0 bg-transparent h-100">
                        <i class="bi bi-heart-fill mb-3 d-block text-brand-red" style="font-size: 2.5rem;"></i>
                        <h5 class="fw-bold text-dark mb-2">Tận tâm</h5>
                        <div class="text-muted small">Đặt lợi ích khách hàng lên hàng đầu</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 border-0 bg-transparent h-100">
                        <i class="bi bi-shield-check mb-3 d-block text-brand-blue" style="font-size: 2.5rem;"></i>
                        <h5 class="fw-bold text-dark mb-2">Chính hãng</h5>
                        <div class="text-muted small">Cam kết 100% nguồn gốc rõ ràng</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 border-0 bg-transparent h-100">
                        <i class="bi bi-lightning-charge-fill mb-3 d-block text-brand-yellow" style="font-size: 2.5rem;"></i>
                        <h5 class="fw-bold text-dark mb-2">Nhanh chóng</h5>
                        <div class="text-muted small">Giao hàng thần tốc, hỗ trợ 24/7</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 border-0 bg-transparent h-100">
                        <i class="bi bi-people-fill mb-3 d-block text-brand-green" style="font-size: 2.5rem;"></i>
                        <h5 class="fw-bold text-dark mb-2">Đồng hành</h5>
                        <div class="text-muted small">Bảo hành dài hạn, hậu mãi trọn đời</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
