@{
    ViewBag.Title = "Giới thiệu về QHVD Tech";
}

<div class="kh-container">
    <!-- Banner -->
    <div class="kh-card text-center mb-4" style="background: linear-gradient(135deg, #1A1A1A 0%, #333 100%); color: #fff; padding: 60px 20px;">
        <h1 style="color: var(--brand-yellow); font-size: 2.5rem; font-weight: 800;">Về QHVD Tech</h1>
        <p class="lead mt-3 mb-0">Hệ thống bán lẻ thiết bị điện tử & máy tính hàng đầu</p>
    </div>

    <!-- Câu chuyện -->
    <div class="kh-card mb-4">
        <div class="section-header">
            <h3><i class="bi bi-bookmark-star-fill" style="color: var(--brand-yellow);"></i> Câu chuyện của chúng tôi</h3>
        </div>
        <p style="font-size: 1.05rem; line-height: 1.8; color: #444;">
            <strong>QHVD Tech</strong> được thành lập với sứ mệnh mang đến những sản phẩm công nghệ tiên tiến nhất, chất lượng nhất đến tay người tiêu dùng Việt Nam.
            Trải qua nhiều năm phát triển, chúng tôi tự hào là điểm đến tin cậy của hàng triệu khách hàng trên cả nước trong lĩnh vực kinh doanh máy tính,
            linh kiện điện tử và các thiết bị công nghệ thông minh.
        </p>
        <p style="font-size: 1.05rem; line-height: 1.8; color: #444;">
            Với hệ thống cửa hàng trải dài khắp các tỉnh thành, cùng đội ngũ nhân viên am hiểu công nghệ, nhiệt huyết,
            QHVD Tech cam kết mang lại trải nghiệm mua sắm tuyệt vời nhất với chính sách bảo hành minh bạch, hậu mãi chu đáo.
        </p>
    </div>

    <!-- Tầm nhìn & Sứ mệnh -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="kh-card h-100">
                <div class="text-center mb-3">
                    <i class="bi bi-eye-fill" style="font-size: 3rem; color: var(--brand-yellow);"></i>
                </div>
                <h4 class="text-center fw-bold">Tầm nhìn</h4>
                <p class="text-center text-muted">
                    Trở thành hệ thống bán lẻ thiết bị công nghệ số 1 Việt Nam, là cầu nối đưa công nghệ thế giới đến gần hơn với mọi gia đình Việt.
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="kh-card h-100">
                <div class="text-center mb-3">
                    <i class="bi bi-rocket-takeoff-fill" style="font-size: 3rem; color: var(--brand-yellow);"></i>
                </div>
                <h4 class="text-center fw-bold">Sứ mệnh</h4>
                <p class="text-center text-muted">
                    Cung cấp các giải pháp công nghệ toàn diện, sản phẩm chính hãng 100% với dịch vụ chăm sóc khách hàng tận tâm, vượt trội.
                </p>
            </div>
        </div>
    </div>

    <!-- Giá trị cốt lõi -->
    <div class="kh-card">
        <div class="section-header">
            <h3><i class="bi bi-gem" style="color: var(--brand-yellow);"></i> Giá trị cốt lõi</h3>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <i class="bi bi-heart-fill" style="font-size: 2.5rem; color: var(--brand-red);"></i>
                <h5 class="mt-2 fw-bold">Tận tâm</h5>
                <small class="text-muted">Đặt lợi ích khách hàng lên hàng đầu</small>
            </div>
            <div class="col-md-3 col-6">
                <i class="bi bi-shield-check" style="font-size: 2.5rem; color: #1976D2;"></i>
                <h5 class="mt-2 fw-bold">Chính hãng</h5>
                <small class="text-muted">Cam kết 100% nguồn gốc rõ ràng</small>
            </div>
            <div class="col-md-3 col-6">
                <i class="bi bi-lightning-charge-fill" style="font-size: 2.5rem; color: var(--brand-yellow);"></i>
                <h5 class="mt-2 fw-bold">Nhanh chóng</h5>
                <small class="text-muted">Giao hàng thần tốc, hỗ trợ 24/7</small>
            </div>
            <div class="col-md-3 col-6">
                <i class="bi bi-people-fill" style="font-size: 2.5rem; color: #2E7D32;"></i>
                <h5 class="mt-2 fw-bold">Đồng hành</h5>
                <small class="text-muted">Bảo hành dài hạn, hậu mãi trọn đời</small>
            </div>
        </div>
    </div>
</div>