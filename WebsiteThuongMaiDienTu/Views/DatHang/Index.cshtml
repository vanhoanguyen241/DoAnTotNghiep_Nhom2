@using WebsiteThuongMaiDienTu.Models
@model List<sanpham>
@{
    ViewBag.Title = "Xác nhận đặt hàng";

    var gioHang = ViewBag.GioHang as Dictionary<string, int>;

    if (gioHang == null)
    {
        gioHang = new Dictionary<string, int>();
    }

    decimal tongTien = ViewBag.TongTien != null ? (decimal)ViewBag.TongTien : 0;
    var khachHang = ViewBag.KhachHang as khachhang;
    var homNay = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <h4 class="fw-bold text-dark mb-0">
                <i class="bi bi-receipt me-2 text-brand-yellow"></i> Xác nhận đặt hàng
            </h4>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="px-4 pt-4">
                <div class="alert alert-danger border-0 bg-danger-subtle text-danger-emphasis rounded-3 d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@ViewBag.ThongBao</span>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-uppercase text-secondary small fw-bold py-3 ps-4" style="width: 50%;">Sản phẩm</th>
                            <th class="text-uppercase text-secondary small fw-bold py-3" style="width: 15%;">Đơn giá</th>
                            <th class="text-center text-uppercase text-secondary small fw-bold py-3" style="width: 15%;">Số lượng</th>
                            <th class="text-end text-uppercase text-secondary small fw-bold py-3 pe-4" style="width: 20%;">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sp in Model)
                        {
                            int soLuong = gioHang.ContainsKey(sp.masanpham) ? gioHang[sp.masanpham] : 0;
                            decimal thanhTien = sp.dongia * soLuong;

                            <tr>
                                <td class="py-3 ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(sp.hinh))
                                        {
                                            <img src="@Url.Content(sp.hinh)" alt="@sp.tensanpham" class="rounded-3 border object-fit-cover flex-shrink-0" style="width: 70px; height: 70px;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-3 border bg-light d-flex align-items-center justify-content-center text-secondary flex-shrink-0" style="width: 70px; height: 70px;">
                                                <i class="bi bi-image opacity-50 fs-4"></i>
                                            </div>
                                        }

                                        <div class="d-flex flex-column">
                                            <strong class="text-dark">@sp.tensanpham</strong>
                                            <span class="text-muted small">@sp.masanpham</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <span class="text-secondary fw-medium">@string.Format("{0:N0}₫", sp.dongia)</span>
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fs-6">@soLuong</span>
                                </td>
                                <td class="py-3 pe-4 text-end">
                                    <span class="text-danger fw-bold">@string.Format("{0:N0}₫", thanhTien)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-body border-top p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <a href="@Url.Action("Index", "GioHang", new { area = "" })" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-pencil me-1"></i> Sửa giỏ hàng
                    </a>

                    <div class="text-end">
                        <div class="text-secondary small text-uppercase fw-bold">Tổng tiền thanh toán</div>
                        <div class="h3 mb-0 text-danger fw-bold">@string.Format("{0:N0}₫", tongTien)</div>
                    </div>
                </div>
            </div>

            using (Html.BeginForm("XacNhanDatHang", "DatHang", new { area = "" }, FormMethod.Post, new { id = "formDatHang", autocomplete = "off" }))
            {
                <div class="card-body border-top p-4" id="sectionKhachHang">
                    <h5 class="fw-bold text-dark mb-4">
                        <i class="bi bi-person-vcard me-2 text-brand-yellow"></i> Thông tin khách hàng
                    </h5>

                    @if (khachHang != null)
                    {
                        <div class="alert alert-success border-0 bg-success-subtle text-success-emphasis rounded-3 d-flex align-items-start gap-2">
                            <i class="bi bi-person-check-fill mt-1"></i>
                            <span>
                                Bạn đang đặt hàng với tài khoản <strong>@khachHang.hoten</strong>.
                                Hệ thống sẽ sử dụng thông tin khách hàng đã có sẵn.
                            </span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-medium text-dark small mb-1">Họ tên</label>
                                <input type="text" class="form-control bg-light" value="@khachHang.hoten" readonly />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-medium text-dark small mb-1">Số điện thoại</label>
                                <input type="text" class="form-control bg-light" value="@khachHang.SDT" readonly />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-medium text-dark small mb-1">Địa chỉ</label>
                                <input type="text" class="form-control bg-light" value="@khachHang.diachi" readonly />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-medium text-dark small mb-1">
                                    Họ và tên <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       name="txt_hoten"
                                       id="txt_hoten"
                                       class="form-control"
                                       placeholder="Nhập họ và tên"
                                       maxlength="100"
                                       required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-medium text-dark small mb-1">
                                    Số điện thoại <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       name="txt_sdt"
                                       class="form-control"
                                       placeholder="Nhập 10 - 11 chữ số"
                                       maxlength="11"
                                       required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-medium text-dark small mb-1">
                                    Địa chỉ <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       name="txt_diachi"
                                       class="form-control"
                                       placeholder="Nhập địa chỉ"
                                       maxlength="200"
                                       required />
                            </div>
                        </div>
                    }
                </div>

                <div class="card-body border-top p-4">
                    <h5 class="fw-bold text-dark mb-4">
                        <i class="bi bi-truck me-2 text-brand-yellow"></i> Hình thức nhận hàng
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark small mb-1">Ngày giao mong muốn</label>
                            <input type="date"
                                   name="txt_ngaygiaohang"
                                   class="form-control"
                                   value="@homNay"
                                   min="@homNay" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark small mb-1">Địa chỉ giao tận nơi</label>
                            <input type="text"
                                   name="txt_diachigiao"
                                   class="form-control"
                                   placeholder="Để trống nếu nhận tại cửa hàng hoặc dùng địa chỉ đã đăng ký"
                                   maxlength="200" />
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input type="checkbox"
                               class="form-check-input"
                               name="chk_giaotannoi"
                               id="chk_giaotannoi" />
                        <label class="form-check-label fw-medium text-dark" for="chk_giaotannoi">
                            Giao hàng tận nơi
                        </label>
                    </div>

                    <div class="mt-3">
                        <label class="form-label fw-medium text-dark small mb-1">Ghi chú</label>
                        <textarea name="txt_ghichu"
                                  class="form-control"
                                  rows="3"
                                  maxlength="1000"
                                  placeholder="Nhập ghi chú cho đơn hàng nếu cần"></textarea>
                    </div>
                </div>

                <div class="card-body border-top bg-light p-4">
                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index", "GioHang", new { area = "" })" class="btn btn-light border px-4">
                            Quay lại giỏ hàng
                        </a>

                        <button type="submit" class="btn btn-brand px-4 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Xác nhận đặt hàng
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-cart-x text-muted mb-3 d-block opacity-50" style="font-size: 3.5rem;"></i>
                <h4 class="fw-bold text-dark">Giỏ hàng trống</h4>
                <p class="text-muted mb-4">Bạn chưa có sản phẩm nào trong giỏ hàng.</p>
                <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })" class="btn btn-brand rounded-pill px-4">
                    <i class="bi bi-arrow-left-circle me-1"></i> Xem sản phẩm
                </a>
            </div>
        }
    </div>
</div>
@if (ViewBag.FocusForm == true)
{
    <script>
    window.addEventListener('DOMContentLoaded', function () {
        var section = document.getElementById('sectionKhachHang');
        if (section) {
            section.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        setTimeout(function () {
            var input = document.getElementById('txt_hoten');
            if (input) {
                input.focus();
            }
        }, 500);
    });
    </script>
}