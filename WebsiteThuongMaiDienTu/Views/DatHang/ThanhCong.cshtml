@using WebsiteThuongMaiDienTu.Models
@model dathang
@{
    ViewBag.Title = "Đặt hàng thành công";

    decimal tongTien = 0;
    if (Model.chitietdathangs != null)
    {
        foreach (var ct in Model.chitietdathangs)
        {
            tongTien += ct.thanhtien;
        }
    }

    string trangThaiText = "Chờ duyệt";
    string trangThaiClass = "bg-warning-subtle text-warning-emphasis";

    if (Model.trangthai == 1)
    {
        trangThaiText = "Đã duyệt";
        trangThaiClass = "bg-success-subtle text-success-emphasis";
    }
    else if (Model.trangthai == 2)
    {
        trangThaiText = "Từ chối";
        trangThaiClass = "bg-danger-subtle text-danger-emphasis";
    }
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body text-center pt-5 pb-4">
                    <i class="bi bi-check-circle-fill d-block mb-3" style="font-size: 3.5rem; color: #2E7D32;"></i>
                    <h3 class="fw-bold text-dark mb-0">Đặt hàng thành công</h3>
                </div>

                <div class="card-body pt-0 px-4">
                    <div class="alert alert-success border-0 bg-success-subtle text-success-emphasis rounded-3 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>
                            Cảm ơn bạn đã đặt hàng. Mã đơn hàng của bạn là <strong>#@Model.madathang</strong>.
                        </span>
                    </div>
                </div>

                <div class="list-group list-group-flush border-top">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                        <span class="text-secondary">Mã đơn hàng</span>
                        <span class="fw-bold text-dark">@Model.madathang</span>
                    </div>

                    <div class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                        <span class="text-secondary">Ngày đặt hàng</span>
                        <span class="fw-medium text-dark">@Model.ngaydathang.ToString("dd/MM/yyyy")</span>
                    </div>

                    <div class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                        <span class="text-secondary">Ngày giao mong muốn</span>
                        <span class="fw-medium text-dark">@Model.ngaygiaohang.ToString("dd/MM/yyyy")</span>
                    </div>

                    <div class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                        <span class="text-secondary">Tổng tiền</span>
                        <span class="h5 mb-0 text-danger fw-bold">@string.Format("{0:N0}₫", tongTien)</span>
                    </div>

                    <div class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                        <span class="text-secondary">Trạng thái</span>
                        <span class="badge @trangThaiClass rounded-pill px-3 py-2">@trangThaiText</span>
                    </div>

                    <div class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                        <span class="text-secondary">Hình thức nhận hàng</span>
                        <span class="fw-medium text-dark">@(Model.giaotannoi ? "Giao tận nơi" : "Nhận tại cửa hàng")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ghichu))
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-start gap-3 px-4 py-3">
                            <span class="text-secondary flex-shrink-0">Ghi chú</span>
                            <span class="fw-medium text-dark text-end">@Model.ghichu</span>
                        </div>
                    }
                </div>

                <div class="card-body border-top bg-light p-4">
                    <p class="text-muted small mb-3">
                        <i class="bi bi-info-circle me-1"></i> Vui lòng lưu lại mã đơn hàng để tra cứu khi cần.
                    </p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="@Url.Action("DanhSach", "SanPhamCongKhai", new { area = "" })" class="btn btn-brand px-4 fw-medium shadow-sm">
                            <i class="bi bi-bag me-1"></i> Tiếp tục mua sắm
                        </a>
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-light border px-4">
                            Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>