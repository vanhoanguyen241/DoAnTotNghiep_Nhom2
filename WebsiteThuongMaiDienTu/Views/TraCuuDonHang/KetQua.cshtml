@using WebsiteThuongMaiDienTu.Models
@model dathang
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.madathang;

    string trangThaiText = "Chờ duyệt";
    string trangThaiClass = "bg-warning-subtle text-warning-emphasis";

    if (Model.trangthai == 1)
    {
        trangThaiText = "Đã duyệt";
        trangThaiClass = "bg-success-subtle text-success-emphasis";
    }
    else if (Model.trangthai == 2)
    {
        trangThaiText = "Từ chối";
        trangThaiClass = "bg-danger-subtle text-danger-emphasis";
    }

    var hoaDon = Model.hoadon;
    bool daThanhToan = hoaDon != null && hoaDon.dathanhtoan;
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h4 class="fw-bold text-dark mb-0">
                    <i class="bi bi-receipt-cutoff me-2" style="color: var(--brand-yellow);"></i>
                    Chi tiết đơn hàng #@Model.madathang
                </h4>
                <a href="@Url.Action("Index", "TraCuuDonHang")" class="btn btn-light border px-3">
                    <i class="bi bi-arrow-left me-1"></i> Tra cứu đơn khác
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            <!-- THÔNG TIN ĐƠN HÀNG & KHÁCH HÀNG -->
            <div class="list-group list-group-flush">
                <div class="row g-0">
                    <div class="col-md-6 border-bottom border-end-md">
                        <div class="list-group-item border-0 p-4 h-100">
                            <span class="text-secondary small text-uppercase fw-bold d-block mb-1">Khách hàng</span>
                            <span class="fw-medium text-dark">@(Model.khachhang != null ? Model.khachhang.hoten : "—")</span>
                        </div>
                    </div>
                    <div class="col-md-6 border-bottom">
                        <div class="list-group-item border-0 p-4 h-100">
                            <span class="text-secondary small text-uppercase fw-bold d-block mb-1">Số điện thoại</span>
                            <span class="fw-medium text-dark">@(Model.khachhang != null && !string.IsNullOrEmpty(Model.khachhang.SDT) ? Model.khachhang.SDT : "—")</span>
                        </div>
                    </div>

                    <div class="col-md-6 border-bottom border-end-md">
                        <div class="list-group-item border-0 p-4 h-100">
                            <span class="text-secondary small text-uppercase fw-bold d-block mb-1">Ngày đặt</span>
                            <span class="fw-medium text-dark">@Model.ngaydathang.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                    <div class="col-md-6 border-bottom">
                        <div class="list-group-item border-0 p-4 h-100">
                            <span class="text-secondary small text-uppercase fw-bold d-block mb-1">Ngày giao mong muốn</span>
                            <span class="fw-medium text-dark">@Model.ngaygiaohang.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>

                    <div class="col-md-4 border-bottom border-end-md">
                        <div class="list-group-item border-0 p-4 h-100">
                            <span class="text-secondary small text-uppercase fw-bold d-block mb-1">Hình thức nhận</span>
                            <span class="fw-medium text-dark">
                                @(Model.giaotannoi ? "Giao tận nơi" : "Nhận tại cửa hàng")
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4 border-bottom border-end-md">
                        <div class="list-group-item border-0 p-4 h-100">
                            <span class="text-secondary small text-uppercase fw-bold d-block mb-1">Trạng thái duyệt</span>
                            <span class="badge @trangThaiClass rounded-pill px-3 py-2 mt-1">@trangThaiText</span>
                        </div>
                    </div>
                    <div class="col-md-4 border-bottom">
                        <div class="list-group-item border-0 p-4 h-100">
                            <span class="text-secondary small text-uppercase fw-bold d-block mb-1">Thanh toán</span>
                            <span class="mt-1 d-inline-block">
                                @if (hoaDon != null)
                                {
                                    if (daThanhToan)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-2">Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-2">Chưa thanh toán</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ghichu))
                    {
                        <div class="col-12 border-bottom">
                            <div class="list-group-item border-0 p-4 bg-light">
                                <span class="text-secondary small text-uppercase fw-bold d-block mb-1">Ghi chú</span>
                                <span class="text-dark">@Model.ghichu</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG CHI TIẾT SẢN PHẨM -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-box-seam me-2" style="color: var(--brand-yellow);"></i> Sản phẩm đã đặt
            </h5>
        </div>

        @if (Model.chitietdathangs != null && Model.chitietdathangs.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-uppercase text-secondary small fw-bold py-3 ps-4" style="width: 50%;">Sản phẩm</th>
                            <th class="text-center text-uppercase text-secondary small fw-bold py-3" style="width: 15%;">SL Đặt</th>
                            <th class="text-center text-uppercase text-secondary small fw-bold py-3" style="width: 15%;">SL Duyệt</th>
                            <th class="text-end text-uppercase text-secondary small fw-bold py-3 pe-4" style="width: 20%;">Đơn giá</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ct in Model.chitietdathangs)
                        {
                            <tr>
                                <td class="py-3 ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (ct.sanpham != null && !string.IsNullOrEmpty(ct.sanpham.hinh))
                                        {
                                            <img src="@Url.Content(ct.sanpham.hinh)"
                                                 alt="@ct.sanpham.tensanpham"
                                                 class="rounded-3 border object-fit-cover flex-shrink-0"
                                                 style="width: 60px; height: 60px;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-3 border bg-light d-flex align-items-center justify-content-center text-secondary flex-shrink-0"
                                                 style="width: 60px; height: 60px;">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }

                                        <div>
                                            <div class="fw-bold text-dark">@(ct.sanpham != null ? ct.sanpham.tensanpham : "—")</div>
                                            <div class="small text-muted font-monospace">@(ct.sanpham != null ? ct.sanpham.masanpham : "")</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3 text-center">
                                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-2">@ct.soluongdat</span>
                                </td>

                                <td class="py-3 text-center">
                                    @if (ct.soluongduyet.HasValue)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-2">@ct.soluongduyet</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="py-3 pe-4 text-end">
                                    <span class="text-danger fw-bold">@string.Format("{0:N0}₫", ct.dongia)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top p-4 text-end">
                <span class="text-secondary text-uppercase fw-bold me-3">Tổng tiền tạm tính</span>
                <span class="h3 mb-0 text-danger fw-bold">
                    @string.Format("{0:N0}₫", Model.chitietdathangs.Sum(ct => ct.thanhtien))
                </span>
            </div>
        }
    </div>

    <!-- TRẠNG THÁI ĐƠN HÀNG -->
    @if (Model.trangthai == 2)
    {
        <div class="alert alert-danger border-0 bg-danger-subtle text-danger-emphasis rounded-4 p-4 d-flex gap-3 mb-4">
            <i class="bi bi-x-circle-fill" style="font-size: 1.5rem;"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1">Đơn hàng bị từ chối</h5>
                <p class="mb-0">@(string.IsNullOrEmpty(Model.ghichu) ? "" : "Vui lòng liên hệ cửa hàng để biết thêm chi tiết.")</p>
            </div>
        </div>
    }
    else if (Model.trangthai == 1)
    {
        if (daThanhToan)
        {
            <div class="alert alert-success border-0 bg-success-subtle text-success-emphasis rounded-4 p-4 d-flex gap-3 mb-4">
                <i class="bi bi-check-circle-fill" style="font-size: 1.5rem;"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">Đã thanh toán thành công</h5>
                    <p class="mb-0">
                        @if (Model.mahoadon.HasValue) { <span>Mã hóa đơn của bạn là <strong>#@Model.mahoadon</strong>.</span> }
                        @(Model.giaotannoi ? "Đơn hàng sẽ được giao tới địa chỉ của bạn." : "Vui lòng nhận hàng tại cửa hàng.")
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning border-0 bg-warning-subtle text-warning-emphasis rounded-4 p-4 d-flex gap-3 mb-4">
                <i class="bi bi-cash-coin" style="font-size: 1.5rem;"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">Đã duyệt - Chưa thanh toán</h5>
                    <p class="mb-0">
                        @if (Model.mahoadon.HasValue) { <span>Mã hóa đơn <strong>#@Model.mahoadon</strong>.</span> }
                        Vui lòng hoàn tất thanh toán để đơn hàng được xử lý.
                    </p>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info border-0 bg-info-subtle text-info-emphasis rounded-4 p-4 d-flex gap-3 mb-4">
            <i class="bi bi-clock-fill" style="font-size: 1.5rem;"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1">Đang chờ duyệt</h5>
                <p class="mb-0">Đơn hàng của bạn đang được nhân viên kiểm tra, vui lòng đợi trong ít phút.</p>
            </div>
        </div>
    }

    <div class="d-flex flex-wrap gap-2 justify-content-end">
        <a href="@Url.Action("Index", "Home")" class="btn btn-light border px-4">
            <i class="bi bi-house me-1"></i> Trang chủ
        </a>
        <a href="@Url.Action("DanhSach", "SanPhamCongKhai")" class="btn btn-brand px-4 shadow-sm fw-bold">
            <i class="bi bi-bag me-1"></i> Tiếp tục mua sắm
        </a>
    </div>
</div>