@{
    ViewBag.Title = "Tra cứu đơn hàng";
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header text-center">
            <i class="bi bi-search" style="font-size: 3rem; color: var(--brand-yellow);"></i>
            <h2>Tra cứu đơn hàng</h2>
            <p class="text-muted">Nhập mã đơn hàng để kiểm tra trạng thái và chi tiết sản phẩm</p>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
            </div>
        }

        @using (Html.BeginForm("TimKiem", "TraCuuDonHang", FormMethod.Post, new { id = "formTraCuu" }))
        {
            <div class="form-group">
                <label for="txt_madathang">Mã đơn hàng <span class="required">*</span></label>
                <div class="input-icon">
                    <i class="bi bi-receipt-cutoff"></i>
                    <input type="number"
                           class="form-control"
                           id="txt_madathang"
                           name="txt_madathang"
                           placeholder="Ví dụ: 1, 2, 3..."
                           required
                           autofocus />
                </div>
                <small class="form-text">Mã đơn hàng được cung cấp khi bạn đặt hàng thành công.</small>
            </div>

            <button type="submit" class="btn-luu w-100" style="margin-top: 10px;">
                <i class="bi bi-search"></i> Tra cứu ngay
            </button>
        }
    </div>
</div>