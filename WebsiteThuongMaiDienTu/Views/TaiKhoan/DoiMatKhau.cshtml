@{
    ViewBag.Title = "Đổi mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h3 class="fw-bold text-dark mb-2">
                            <i class="bi bi-key-fill me-2" style="color: var(--brand-yellow);"></i> Đổi mật khẩu
                        </h3>
                        <p class="text-muted mb-0">
                            Cập nhật mật khẩu cho tài khoản <strong class="text-dark">@Session["TenDangNhap"]</strong>
                        </p>
                    </div>

                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger border-0 bg-danger-subtle text-danger-emphasis rounded-3 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@ViewBag.ThongBao</span>
                        </div>
                    }

                    @if (ViewBag.ThongBaoThanhCong != null)
                    {
                        <div class="alert alert-success border-0 bg-success-subtle text-success-emphasis rounded-3">
                            <i class="bi bi-check-circle-fill me-1"></i> @ViewBag.ThongBaoThanhCong
                            @if (ViewBag.TuDongDangXuat == true)
                            {
                                <br/><i class="bi bi-clock-history"></i><span> Hệ thống sẽ tự động đăng xuất sau <strong id="countdown" style="color: var(--brand-red);">5</strong> giây...</span>
                                <script>
                                    document.addEventListener('DOMContentLoaded', function () {
                                    var seconds = 5;
                                    var countdownEl = document.getElementById('countdown');
                                    var interval = setInterval(function () {
                                    seconds--;
                                    if (countdownEl) countdownEl.textContent = seconds;
                                    if (seconds <= 0) {
                                    clearInterval(interval);
                                    // Redirect về action Đăng xuất để clear Session
                                    window.location.href = '@Url.Action("DangXuat", "TaiKhoan", new { area = "" })';}}, 1000);});
                                </script>
                            }
                        </div>
                    }

                    @using (Html.BeginForm("DoiMatKhau", "TaiKhoan", FormMethod.Post, new { id = "formDoiMatKhau", autocomplete = "off" }))
                    {
                        <div class="mb-3">
                            <label for="txt_matkhaucu" class="form-label fw-medium text-dark small mb-1">
                                Mật khẩu hiện tại <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary"><i class="bi bi-lock"></i></span>
                                <input type="password"
                                       class="form-control"
                                       id="txt_matkhaucu"
                                       name="txt_matkhaucu"
                                       placeholder="Nhập mật khẩu hiện tại"
                                       required
                                       autofocus />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="txt_matkhaumoi" class="form-label fw-medium text-dark small mb-1">
                                Mật khẩu mới <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary"><i class="bi bi-key"></i></span>
                                <input type="password"
                                       class="form-control"
                                       id="txt_matkhaumoi"
                                       name="txt_matkhaumoi"
                                       placeholder="Nhập mật khẩu mới"
                                       required
                                       minlength="6" />
                            </div>
                            <div class="form-text">Mật khẩu phải có ít nhất 6 ký tự</div>
                        </div>

                        <div class="mb-4">
                            <label for="txt_xacnhanmk" class="form-label fw-medium text-dark small mb-1">
                                Xác nhận mật khẩu mới <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary"><i class="bi bi-key-fill"></i></span>
                                <input type="password"
                                       class="form-control"
                                       id="txt_xacnhanmk"
                                       name="txt_xacnhanmk"
                                       placeholder="Nhập lại mật khẩu mới"
                                       required
                                       minlength="6" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-brand w-100 py-2 fw-bold rounded-3 shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Xác nhận đổi mật khẩu
                        </button>
                    }

                    <div class="text-center mt-4">
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="text-decoration-none text-secondary small">
                            <i class="bi bi-arrow-left me-1"></i> Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Kiểm tra khớp mật khẩu ngay phía client trước khi gửi lên server
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('formDoiMatKhau');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                var mkMoi = document.getElementById('txt_matkhaumoi').value;
                var xacNhan = document.getElementById('txt_xacnhanmk').value;
                if (mkMoi !== xacNhan) {
                    e.preventDefault();
                    alert('Mật khẩu xác nhận không khớp với mật khẩu mới!');
                }
            });
        });
    </script>
}