@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<div class="container py-5 min-vh-75 d-flex align-items-center">
    <div class="row justify-content-center w-100">
        <div class="col-md-9 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h3 class="fw-bold text-dark mb-2">
                            <i class="bi bi-person-plus-fill me-2" style="color: var(--brand-yellow);"></i> Đăng ký tài khoản
                        </h3>
                        <p class="text-muted mb-0">Tạo tài khoản mới để bắt đầu mua sắm</p>
                    </div>

                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger border-0 bg-danger-subtle text-danger-emphasis rounded-3 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@ViewBag.ThongBao</span>
                        </div>
                    }

                    @if (ViewBag.ThongBaoThanhCong != null)
                    {
                        <div class="alert alert-success border-0 bg-success-subtle text-success-emphasis rounded-3 d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@ViewBag.ThongBaoThanhCong</span>
                        </div>
                    }

                    @using (Html.BeginForm("DangKy", "TaiKhoan", FormMethod.Post))
                    {
                        <!-- Thông tin tài khoản -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark text-uppercase small mb-3 pb-2 border-bottom">
                                <i class="bi bi-shield-lock me-2" style="color: var(--brand-yellow);"></i> Thông tin đăng nhập
                            </h6>

                            <div class="mb-3">
                                <label for="txt_tendangnhap" class="form-label fw-medium text-dark small mb-1">
                                    Tên đăng nhập <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-person"></i></span>
                                    <input type="text"
                                           class="form-control"
                                           id="txt_tendangnhap"
                                           name="txt_tendangnhap"
                                           placeholder="Nhập tên đăng nhập"
                                           required
                                           maxlength="50" />
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="txt_matkhau" class="form-label fw-medium text-dark small mb-1">
                                        Mật khẩu <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-secondary"><i class="bi bi-lock"></i></span>
                                        <input type="password"
                                               class="form-control"
                                               id="txt_matkhau"
                                               name="txt_matkhau"
                                               placeholder="Nhập mật khẩu"
                                               required
                                               minlength="6" />
                                    </div>
                                    <div class="form-text">Mật khẩu phải có ít nhất 6 ký tự</div>
                                </div>

                                <div class="col-md-6">
                                    <label for="txt_xacnhanmk" class="form-label fw-medium text-dark small mb-1">
                                        Xác nhận mật khẩu <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-secondary"><i class="bi bi-lock-fill"></i></span>
                                        <input type="password"
                                               class="form-control"
                                               id="txt_xacnhanmk"
                                               name="txt_xacnhanmk"
                                               placeholder="Nhập lại mật khẩu"
                                               required />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Thông tin cá nhân -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark text-uppercase small mb-3 pb-2 border-bottom">
                                <i class="bi bi-person-vcard me-2" style="color: var(--brand-yellow);"></i> Thông tin khách hàng
                            </h6>

                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label for="txt_hoten" class="form-label fw-medium text-dark small mb-1">
                                        Họ và tên <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-secondary"><i class="bi bi-person-badge"></i></span>
                                        <input type="text"
                                               class="form-control"
                                               id="txt_hoten"
                                               name="txt_hoten"
                                               placeholder="Nhập họ và tên"
                                               required
                                               maxlength="100" />
                                    </div>
                                </div>

                                <div class="col-md-5">
                                    <label for="txt_sdt" class="form-label fw-medium text-dark small mb-1">
                                        Số điện thoại <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-secondary"><i class="bi bi-telephone"></i></span>
                                        <input type="tel"
                                               class="form-control"
                                               id="txt_sdt"
                                               name="txt_sdt"
                                               placeholder="Nhập số điện thoại"
                                               required
                                               maxlength="15" />
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label for="txt_diachi" class="form-label fw-medium text-dark small mb-1">
                                        Địa chỉ <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-secondary align-items-start pt-2"><i class="bi bi-geo-alt"></i></span>
                                        <textarea class="form-control"
                                                  id="txt_diachi"
                                                  name="txt_diachi"
                                                  rows="3"
                                                  placeholder="Nhập địa chỉ chi tiết"
                                                  required
                                                  maxlength="200"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-brand w-100 py-2 fw-bold rounded-3 shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Đăng ký tài khoản
                        </button>
                    }

                    <div class="text-center text-muted small mt-4">
                        Đã có tài khoản?
                        <a href="@Url.Action("DangNhap", "TaiKhoan")" class="fw-bold text-decoration-none">Đăng nhập ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>