@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<div class="register-container">
    <div class="register-card">
        <div class="register-header">
            <h2><i class="bi bi-person-plus-fill" style="color: var(--brand-yellow);"></i> Đăng ký tài khoản</h2>
            <p>Tạo tài khoản mới để bắt đầu mua sắm</p>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
            </div>
        }

        @if (ViewBag.ThongBaoThanhCong != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill"></i> @ViewBag.ThongBaoThanhCong
            </div>
        }

        @using (Html.BeginForm("DangKy", "TaiKhoan", FormMethod.Post))
        {
            <!-- Thông tin tài khoản -->
            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bi bi-shield-lock"></i> Thông tin đăng nhập
                </h3>

                <div class="form-group">
                    <label for="txt_tendangnhap">Tên đăng nhập <span class="required">*</span></label>
                    <div class="input-icon">
                        <i class="bi bi-person"></i>
                        <input type="text"
                               class="form-control"
                               id="txt_tendangnhap"
                               name="txt_tendangnhap"
                               placeholder="Nhập tên đăng nhập"
                               required
                               maxlength="50" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="txt_matkhau">Mật khẩu <span class="required">*</span></label>
                    <div class="input-icon">
                        <i class="bi bi-lock"></i>
                        <input type="password"
                               class="form-control"
                               id="txt_matkhau"
                               name="txt_matkhau"
                               placeholder="Nhập mật khẩu"
                               required
                               minlength="6" />
                    </div>
                    <small class="form-text">Mật khẩu phải có ít nhất 6 ký tự</small>
                </div>

                <div class="form-group">
                    <label for="txt_xacnhanmk">Xác nhận mật khẩu <span class="required">*</span></label>
                    <div class="input-icon">
                        <i class="bi bi-lock-fill"></i>
                        <input type="password"
                               class="form-control"
                               id="txt_xacnhanmk"
                               name="txt_xacnhanmk"
                               placeholder="Nhập lại mật khẩu"
                               required />
                    </div>
                </div>
            </div>

            <!-- Thông tin cá nhân -->
            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bi bi-person-vcard"></i> Thông tin khách hàng
                </h3>

                <div class="form-group">
                    <label for="txt_hoten">Họ và tên <span class="required">*</span></label>
                    <div class="input-icon">
                        <i class="bi bi-person-badge"></i>
                        <input type="text"
                               class="form-control"
                               id="txt_hoten"
                               name="txt_hoten"
                               placeholder="Nhập họ và tên"
                               required
                               maxlength="100" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="txt_sdt">Số điện thoại <span class="required">*</span></label>
                    <div class="input-icon">
                        <i class="bi bi-telephone"></i>
                        <input type="tel"
                               class="form-control"
                               id="txt_sdt"
                               name="txt_sdt"
                               placeholder="Nhập số điện thoại"
                               required
                               maxlength="15" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="txt_diachi">Địa chỉ <span class="required">*</span></label>
                    <div class="input-icon">
                        <i class="bi bi-geo-alt"></i>
                        <textarea class="form-control"
                                  id="txt_diachi"
                                  name="txt_diachi"
                                  rows="3"
                                  placeholder="Nhập địa chỉ chi tiết"
                                  required
                                  maxlength="200"
                                  style="padding-left: 45px;"></textarea>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-register">
                <i class="bi bi-check-circle"></i> Đăng ký tài khoản
            </button>
        }

        <div class="login-link">
            Đã có tài khoản? <a href="@Url.Action("DangNhap", "TaiKhoan")">Đăng nhập ngay</a>
        </div>
    </div>
</div>