@model WebsiteThuongMaiDienTu.Models.taikhoan

@{
    ViewBag.Title = "Đăng nhập";
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2><i class="bi bi-box-arrow-in-right" style="color: var(--brand-yellow);"></i> Đăng nhập</h2>
            <p>Đăng nhập để tiếp tục mua sắm</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ErrorMessage
            </div>
        }

        @using (Html.BeginForm("DangNhap", "TaiKhoan", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @Html.ValidationSummary(true, "", new { @class = "" })
                </div>
            }

            <div class="form-group">
                <label for="tendangnhap">
                    Tên đăng nhập <span class="required">*</span>
                </label>
                <div class="input-icon">
                    <i class="bi bi-person"></i>
                    @Html.TextBoxFor(m => m.tendangnhap, new
                    {
                        @class = "form-control",
                        placeholder = "Nhập tên đăng nhập",
                        id = "tendangnhap",
                        required = "required"
                    })
                </div>
            </div>

            <div class="form-group">
                <label for="matkhau">
                    Mật khẩu <span class="required">*</span>
                </label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    @Html.PasswordFor(m => m.matkhau, new
                    {
                        @class = "form-control",
                        placeholder = "Nhập mật khẩu",
                        id = "matkhau",
                        required = "required"
                    })
                </div>
            </div>

            <div class="form-options">
                <a href="@Url.Action("QuenMatKhau", "TaiKhoan")" class="forgot-password">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn-login">
                <i class="bi bi-check-circle"></i> Đăng nhập
            </button>
        }

        <div class="register-link">
            Chưa có tài khoản? <a href="@Url.Action("DangKy", "TaiKhoan")">Đăng ký ngay</a>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}