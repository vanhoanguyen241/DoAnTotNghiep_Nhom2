@{
    ViewBag.Title = "Đăng nhập";
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2><i class="bi bi-box-arrow-in-right" style="color: var(--brand-yellow);"></i> Đăng nhập</h2>
            <p>Đăng nhập để tiếp tục mua sắm</p>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
            </div>
        }

        @using (Html.BeginForm("DangNhap", "TaiKhoan", FormMethod.Post))
        {
            <div class="form-group">
                <label for="txt_tendangnhap">Tên đăng nhập <span class="required">*</span></label>
                <div class="input-icon">
                    <i class="bi bi-person"></i>
                    <input type="text"
                           class="form-control"
                           id="txt_tendangnhap"
                           name="txt_tendangnhap"
                           placeholder="Nhập tên đăng nhập"
                           required
                           autofocus />
                </div>
            </div>

            <div class="form-group">
                <label for="txt_matkhau">Mật khẩu <span class="required">*</span></label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <input type="password"
                           class="form-control"
                           id="txt_matkhau"
                           name="txt_matkhau"
                           placeholder="Nhập mật khẩu"
                           required />
                </div>
            </div>

            <button type="submit" class="btn-login">
                <i class="bi bi-check-circle"></i> Đăng nhập
            </button>
        }

        <div class="register-link">
            Chưa có tài khoản? <a href="@Url.Action("DangKy", "TaiKhoan")">Đăng ký ngay</a>
        </div>
    </div>
</div>