@model WebsiteThuongMaiDienTu.Models.khachhang
@{
    ViewBag.Title = "Thông tin tài khoản";
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2><i class="bi bi-person-badge-fill" style="color: var(--brand-yellow);"></i> Thông tin tài khoản</h2>
            <p>Cập nhật thông tin cá nhân của bạn</p>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill"></i> @ViewBag.ThongBao
            </div>
        }

        @using (Html.BeginForm("ThongTin", "TaiKhoan", FormMethod.Post, new { id = "formThongTin" }))
        {
            <div class="form-group">
                <label for="txt_hoten">Họ và tên <span class="required">*</span></label>
                <div class="input-icon">
                    <i class="bi bi-person"></i>
                    <input type="text"
                           class="form-control"
                           id="txt_hoten"
                           name="txt_hoten"
                           value="@Model.hoten"
                           placeholder="Nhập họ và tên"
                           required
                           maxlength="100" />
                </div>
            </div>

            <div class="form-group">
                <label for="txt_sdt">Số điện thoại</label>
                <div class="input-icon">
                    <i class="bi bi-telephone"></i>
                    <input type="tel"
                           class="form-control"
                           id="txt_sdt"
                           name="txt_sdt"
                           value="@Model.SDT"
                           placeholder="Nhập số điện thoại"
                           maxlength="15" />
                </div>
            </div>

            <div class="form-group">
                <label for="txt_diachi">Địa chỉ <span class="required">*</span></label>
                <div class="input-icon">
                    <i class="bi bi-geo-alt"></i>
                    <textarea class="form-control"
                              id="txt_diachi"
                              name="txt_diachi"
                              rows="3"
                              placeholder="Nhập địa chỉ chi tiết"
                              required
                              maxlength="200"
                              style="padding-left: 45px;">@Model.diachi</textarea>
                </div>
            </div>

            <button type="submit" class="btn-login">
                <i class="bi bi-save"></i> Lưu thay đổi
            </button>
        }

        <div class="register-link">
            <a href="@Url.Action("Index", "Home", new { area = "" })">Về trang chủ</a>
        </div>
    </div>
</div>