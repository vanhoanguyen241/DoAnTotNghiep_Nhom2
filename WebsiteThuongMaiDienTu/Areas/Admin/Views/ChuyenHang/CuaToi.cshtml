@using WebsiteThuongMaiDienTu.Models
@model List<chuyenhang>
@{
    ViewBag.Title = "Đơn hàng của tôi";
}

<div class="kh-container kh-container-wide">
    <div class="kh-card">
        <div class="kh-header">
            <h2>
                <i class="bi bi-truck-front" style="color: var(--brand-yellow);"></i>
                Đơn hàng cần giao
            </h2>
            <a href="@Url.Action("Index", "ChuyenHang", new { area = "Admin" })" class="btn-huy"
               style="padding:10px 16px;background:#f5f5f5;border:2px solid #e0e0e0;border-radius:8px;">
                <i class="bi bi-arrow-left"></i> Về trang quản lý
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="kh-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Mã phiếu</th>
                            <th style="width: 90px;">Hóa đơn</th>
                            <th>Khách hàng</th>
                            <th>Địa chỉ giao / Ghi chú</th>
                            <th style="width: 120px;">Ngày giao</th>
                            <th style="width: 150px;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var hd = item.hoadon;
                            var kh = hd != null ? hd.khachhang : null;
                            <tr>
                                <td><strong>#@item.machuyenhang</strong></td>
                                <td>
                                    <a href="@Url.Action("Index", "ChiTietHoaDon", new { area = "Admin", id = item.mahoadon })"
                                       title="Xem chi tiết hóa đơn">
                                        #@item.mahoadon
                                    </a>
                                </td>
                                <td>
                                    <strong>@(kh != null ? kh.hoten : "—")</strong>
                                    @if (kh != null && !string.IsNullOrEmpty(kh.SDT))
                                    {
                                        <br />
                                        <small class="text-muted"><i class="bi bi-telephone-fill"></i> @kh.SDT</small>
                                    }
                                </td>
                                <td>
                                    @(kh != null ? kh.diachi : "—")
                                    @if (hd != null && !string.IsNullOrEmpty(hd.ghichu))
                                    {
                                        <br />
                                        <small class="text-muted fst-italic">
                                            <i class="bi bi-sticky-fill"></i> @hd.ghichu
                                        </small>
                                    }
                                </td>
                                <td>
                                    @(item.ngaygiao != null ? item.ngaygiao.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td class="text-center">
                                    @using (Html.BeginForm("XacNhanGiaoHang", "ChuyenHang", new { area = "Admin" }, FormMethod.Post, new { style = "display:inline;", onsubmit = "return confirm('Xác nhận đã giao hàng thành công cho khách hàng?');" }))
                                    {
                                        <input type="hidden" name="id" value="@item.machuyenhang" />
                                        <button type="submit" class="btn-luu" style="padding: 8px 16px; font-size: 0.85rem; border-radius: 6px;">
                                            <i class="bi bi-check-circle-fill"></i> Đã giao
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state" style="padding: 40px 20px;">
                <i class="bi bi-box-seam" style="font-size: 3rem; color: #ddd;"></i>
                <h4 style="color: #666; margin-top: 15px;">Không có đơn hàng nào cần giao</h4>
                <p class="text-muted">Tất cả các đơn hàng được phân công cho bạn đã được xử lý hoặc chưa có đơn nào được gán.</p>
            </div>
        }
    </div>
</div>