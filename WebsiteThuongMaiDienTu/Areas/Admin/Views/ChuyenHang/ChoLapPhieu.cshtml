@using WebsiteThuongMaiDienTu.Models
@model List<hoadon>
@{
    ViewBag.Title = "Đơn chờ lập phiếu giao";
}

<div class="kh-container kh-container-wide">
    <div class="kh-card">
        <div class="kh-header">
            <h2>
                <i class="bi bi-receipt-cutoff" style="color: var(--brand-yellow);"></i>
                Đơn chờ lập phiếu giao
            </h2>
            <a href="@Url.Action("Index", "ChuyenHang", new { area = "Admin" })" class="btn-huy"
               style="padding:10px 16px;background:#f5f5f5;border:2px solid #e0e0e0;border-radius:8px;">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="kh-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Mã HĐ</th>
                            <th>Khách hàng</th>
                            <th>Địa chỉ giao</th>
                            <th style="width: 110px;">Ngày đặt</th>
                            <th style="width: 110px;">Ngày giao</th>
                            <th style="width: 130px;" class="text-end">Tổng tiền</th>
                            <th style="width: 130px;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var kh = item.khachhang;
                            <tr>
                                <td><strong>#@item.mahoadon</strong></td>
                                <td>
                                    @(kh != null ? kh.hoten : "—")
                                    @if (kh != null && !string.IsNullOrEmpty(kh.SDT))
                                    {
                                        <br />
                                        <small class="text-muted">@kh.SDT</small>
                                    }
                                </td>
                                <td>
                                    @(kh != null ? kh.diachi : "—")
                                    @if (!string.IsNullOrEmpty(item.ghichu))
                                    {
                                        <br />
                                        <small class="text-muted" title="@item.ghichu">@item.ghichu</small>
                                    }
                                </td>
                                <td>@item.ngaydathang.ToString("dd/MM/yyyy")</td>
                                <td>@item.ngaygiaohang.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <strong>@string.Format("{0:N0}₫", item.tongtien)</strong>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("LapPhieu", "ChuyenHang", new { area = "Admin", id = item.mahoadon })"
                                       class="btn-them"
                                       style="padding:8px 14px;"
                                       onclick="return confirm('Tạo phiếu giao hàng cho hóa đơn #@item.mahoadon?');">
                                        <i class="bi bi-truck"></i> Lập phiếu
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Hiện không có đơn hàng nào cần lập phiếu giao.
            </div>
        }
    </div>
</div>