@using WebsiteThuongMaiDienTu.Models
@model List<chuyenhang>
@{
    bool isAdmin = ViewBag.IsAdmin == true;
    int? maNV = Session["MaNV"] as int?;
    ViewBag.Title = isAdmin ? "Quản lý giao hàng" : "Đơn hàng của tôi";
}

<div class="container-fluid px-4 py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-truck me-2 text-brand-yellow"></i>
                @(isAdmin ? "Quản lý Giao hàng" : "Đơn hàng của tôi")
            </h2>
            <a href="@Url.Action("ChoLapPhieu", "ChuyenHang", new { area = "Admin" })" class="btn btn-brand">
                <i class="bi bi-plus-circle me-1"></i> Đơn chờ lập phiếu
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="card-body pb-0">
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;" class="text-uppercase text-secondary small fw-bold">Mã phiếu</th>
                            <th style="width: 90px;" class="text-uppercase text-secondary small fw-bold">Hóa đơn</th>
                            <th style="width: 160px;" class="text-uppercase text-secondary small fw-bold">Khách hàng</th>
                            <th style="width: 160px;" class="text-uppercase text-secondary small fw-bold">Nhân viên giao</th>
                            <th style="width: 140px;" class="text-uppercase text-secondary small fw-bold">Ngày giao</th>
                            <th style="width: 140px;" class="text-center text-uppercase text-secondary small fw-bold">Thanh toán</th>
                            <th style="width: 100px;" class="text-center text-uppercase text-secondary small fw-bold">Đã giao</th>
                            <th style="width: 220px;" class="text-center text-uppercase text-secondary small fw-bold">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var hd = item.hoadon;
                            var kh = hd != null ? hd.khachhang : null;
                            var nv = item.nhanvien;
                            <tr>
                                <td><strong class="text-dark">@item.machuyenhang</strong></td>
                                <td>
                                    <a href="@Url.Action("Index", "ChiTietHoaDon", new { area = "Admin", id = item.mahoadon })"
                                       title="Xem chi tiết hóa đơn" class="text-decoration-none fw-medium text-primary">
                                        @item.mahoadon
                                    </a>
                                </td>
                                <td>
                                    @if (kh != null)
                                    {
                                        <a href="@Url.Action("ChiTiet", "KhachHang", new { area = "Admin", id = kh.makh })" class="text-decoration-none fw-medium text-primary">
                                            @kh.hoten
                                        </a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @if (nv != null)
                                    {
                                        @nv.hoten
                                        if (!string.IsNullOrEmpty(nv.dienthoai))
                                        {
                                            <br />
                                            <small class="text-muted">@nv.dienthoai</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">Chưa gán</span>
                                    }
                                </td>
                                <td>
                                    @if (hd != null)
                                    {
                                        <div class="text-muted small">
                                            <span>Mong muốn: @hd.ngaygiaohang.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        if (item.ngaygiao != null && item.ngaygiao.Value != DateTime.MinValue)
                                        {
                                            <div class="mt-1"><strong class="text-dark">Thực tế: @item.ngaygiao.Value.ToString("dd/MM/yyyy")</strong></div>
                                        }
                                        else
                                        {
                                            <div class="text-muted mt-1 small">Chưa giao</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" @(hd != null && hd.dathanhtoan ? "checked" : "") disabled />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" @(item.daxuli ? "checked" : "") disabled />
                                </td>
                                <td class="text-center">
                                    @{
                                        bool daGiao = item.daxuli;
                                        bool daThuTien = hd != null && hd.dathanhtoan;
                                        bool hoanThanh = daGiao && daThuTien;
                                    }

                                    @* === TRẠNG THÁI 1: CHƯA GIAO === *@
                                    @if (!daGiao)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2 py-1 d-block mb-1">Chờ giao</span>

                                        <div class="d-flex flex-column gap-1 mt-1">
                                            @if (item.manv == null)
                                            {
                                                if (isAdmin)
                            {
<a href="@Url.Action("GanNhanVien", "ChuyenHang", new { area = "Admin", id = item.machuyenhang })"
   class="btn btn-sm btn-light text-primary" title="Gán nhân viên giao">
    <i class="bi bi-person-gear"></i> Gán NV
</a>
                            }
                                            }

                                            @* Nút tự xác nhận của Nhân viên (chỉ hiện khi chưa giao + đúng NV được gán) *@
                                            @if (!isAdmin && item.manv == maNV)
                                            {
                                                using (Html.BeginForm("XacNhanGiaoHang", "ChuyenHang", new { area = "Admin" }, FormMethod.Post, new { style = "display:inline;" }))
                                                {
                                                    <input type="hidden" name="id" value="@item.machuyenhang" />
                                                    <button type="submit" class="btn btn-sm btn-brand"
                                                            onsubmit="return confirm('Xác nhận đã giao hàng thành công cho khách hàng?');">
                                                        <i class="bi bi-box-seam-fill me-1"></i> Xác nhận giao
                                                    </button>
                                                }
                                            }
                                        </div>
                                    }

                                    @* === TRẠNG THÁI 2: ĐÃ GIAO NHƯNG CHƯA THU TIỀN === *@
                                    else if (daGiao && !daThuTien)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-2 py-1 d-block mb-1">Đã giao - Chờ thu tiền</span>

                                        <div class="d-flex flex-column gap-1 mt-1">
                                            @* Nút xác nhận thu tiền của Nhân viên *@
                                            @if (!isAdmin && item.manv == maNV)
                                            {
                                                using (Html.BeginForm("XacNhanThuTien", "ChuyenHang", new { area = "Admin" }, FormMethod.Post, new { style = "display:inline;" }))
                                                {
                                                    <input type="hidden" name="id" value="@item.machuyenhang" />
                                                    <button type="submit" class="btn btn-sm btn-brand"
                                                            onsubmit="return confirm('Xác nhận đã thu tiền thành công từ khách hàng?');">
                                                        <i class="bi bi-cash-coin me-1"></i> Xác nhận thu tiền
                                                    </button>
                                                }
                                            }
                                        </div>
                                    }
                                    @* === TRẠNG THÁI 3: HOÀN THÀNH (ĐÃ GIAO + ĐÃ THU TIỀN) === *@
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2 py-1">
                                            <i class="bi bi-check-all me-1"></i> Hoàn thành
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body">
                @if (isAdmin)
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Chưa có phiếu giao hàng nào. Vào mục <strong>Đơn chờ lập phiếu</strong> để tạo phiếu mới.
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-box-seam" style="font-size: 3rem; color: #ddd;"></i>
                        <h4 class="mt-3 text-secondary">Không có đơn hàng nào được gán cho bạn</h4>
                        <p class="text-muted mb-0">
                            Tất cả các đơn hàng được phân công cho bạn đã được xử lý hoặc chưa có đơn nào được gán.
                        </p>
                    </div>
                }
            </div>
        }
    </div>
</div>