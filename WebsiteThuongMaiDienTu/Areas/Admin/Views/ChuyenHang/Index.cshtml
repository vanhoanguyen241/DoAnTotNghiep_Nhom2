@using WebsiteThuongMaiDienTu.Models
@model List<chuyenhang>
@{
    bool isAdmin = ViewBag.IsAdmin == true;
    int? maNV = Session["MaNV"] as int?;

    ViewBag.Title = isAdmin ? "Quản lý giao hàng" : "Đơn hàng của tôi";
}

<div class="kh-container kh-container-wide">
    <div class="kh-card">
        <div class="kh-header">
            <h2>
                <i class="bi bi-truck" style="color: var(--brand-yellow);"></i>
                @(isAdmin ? "Quản lý Giao hàng" : "Đơn hàng của tôi")
            </h2>

            @if (isAdmin)
            {
                <a href="@Url.Action("ChoLapPhieu", "ChuyenHang", new { area = "Admin" })" class="btn-them">
                    <i class="bi bi-plus-circle"></i> Đơn chờ lập phiếu
                </a>
            }
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="kh-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Mã phiếu</th>
                            <th style="width: 90px;">Hóa đơn</th>
                            <th>Khách hàng</th>
                            <th>Địa chỉ giao</th>
                            <th style="width: 160px;">Nhân viên giao</th>
                            <th style="width: 110px;">Ngày giao</th>
                            <th style="width: 110px;" class="text-center">Trạng thái</th>
                            <th style="width: 150px;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var hd = item.hoadon;
                            var kh = hd != null ? hd.khachhang : null;
                            var nv = item.nhanvien;

                            <tr>
                                <td><strong>#@item.machuyenhang</strong></td>
                                <td>
                                    <a href="@Url.Action("Index", "ChiTietHoaDon", new { area = "Admin", id = item.mahoadon })"
                                       title="Xem chi tiết hóa đơn">
                                        #@item.mahoadon
                                    </a>
                                </td>
                                <td>
                                    @(kh != null ? kh.hoten : "—")
                                    @if (kh != null && !string.IsNullOrEmpty(kh.SDT))
                                    {
                                        <br />
                                        <small class="text-muted">@kh.SDT</small>
                                    }
                                </td>
                                <td>
                                    @(kh != null ? kh.diachi : "—")
                                    @if (hd != null && !string.IsNullOrEmpty(hd.ghichu))
                                    {
                                        <br />
                                        <small class="text-muted" title="@hd.ghichu">@hd.ghichu</small>
                                    }
                                </td>
                                <td>
                                    @if (nv != null)
                                    {
                                        @nv.hoten
                                        if (!string.IsNullOrEmpty(nv.dienthoai))
                                        {
                                            <br />
                                            <small class="text-muted">@nv.dienthoai</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="sp-badge sp-badge-warning">Chưa gán</span>
                                    }
                                </td>
                                <td>
                                    @(item.ngaygiao != null ? item.ngaygiao.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td class="text-center">
                                    @if (item.daxuli)
                                    {
                                        <span class="sp-badge sp-badge-success">Đã giao</span>
                                    }
                                    else
                                    {
                                        <span class="sp-badge sp-badge-danger">Chưa giao</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (isAdmin)
                                    {
                                        if (!item.daxuli)
                                        {
                                            <a href="@Url.Action("GanNhanVien", "ChuyenHang", new { area = "Admin", id = item.machuyenhang })"
                                               class="btn-icon btn-sua"
                                               title="Gán nhân viên giao">
                                                <i class="bi bi-person-gear"></i>
                                            </a>

                                            <a href="@Url.Action("XacNhanDaGiao", "ChuyenHang", new { area = "Admin", id = item.machuyenhang })"
                                               class="btn-icon"
                                               style="background:#E8F5E9;color:#2E7D32;"
                                               title="Xác nhận đã giao hàng"
                                               onclick="return confirm('Xác nhận phiếu giao #@item.machuyenhang đã giao hàng thành công?');">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Hoàn thành</span>
                                        }
                                    }
                                    else
                                    {
                                        if (!item.daxuli && item.manv == maNV)
                                        {
                                            using (Html.BeginForm(
                                                "XacNhanGiaoHang",
                                                "ChuyenHang",
                                                new { area = "Admin" },
                                                FormMethod.Post,
                                                new
                                                {
                                                    style = "display:inline;",
                                                    onsubmit = "return confirm('Xác nhận đã giao hàng thành công cho khách hàng?');"
                                                }))
                                            {
                                                <input type="hidden" name="id" value="@item.machuyenhang" />

                                                <button type="submit"
                                                        class="btn-luu"
                                                        style="padding: 8px 16px; font-size: 0.85rem; border-radius: 6px;">
                                                    <i class="bi bi-check-circle-fill"></i> Đã giao
                                                </button>
                                            }
                                        }
                                        else if (!item.daxuli)
                                        {
                                            <span class="text-muted">Chưa xử lý</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Hoàn thành</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            if (isAdmin)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Chưa có phiếu giao hàng nào. Vào mục <strong>Đơn chờ lập phiếu</strong> để tạo phiếu mới.
                </div>
            }
            else
            {
                <div class="empty-state" style="padding: 40px 20px;">
                    <i class="bi bi-box-seam" style="font-size: 3rem; color: #ddd;"></i>
                    <h4 style="color: #666; margin-top: 15px;">Không có đơn hàng nào được gán cho bạn</h4>
                    <p class="text-muted">
                        Tất cả các đơn hàng được phân công cho bạn đã được xử lý hoặc chưa có đơn nào được gán.
                    </p>
                </div>
            }
        }
    </div>
</div>