@using WebsiteThuongMaiDienTu.Models
@model chuyenhang
@{
    ViewBag.Title = "Gán nhân viên giao hàng";
    var hd = Model.hoadon;
    var kh = hd != null ? hd.khachhang : null;
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark">
                        <i class="bi bi-person-gear me-2" style="color: var(--brand-yellow);"></i> Gán nhân viên giao hàng — Phiếu #@Model.machuyenhang
                    </h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
                        </div>
                    }

                    <div class="alert alert-info mb-4">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <strong>Hóa đơn:</strong><br />
                                #@Model.mahoadon
                            </div>
                            <div class="col-md-4">
                                <strong>Khách hàng:</strong><br />
                                @(kh != null ? kh.hoten : "—")
                            </div>
                            <div class="col-md-4">
                                <strong>Số điện thoại:</strong><br />
                                @(kh != null && !string.IsNullOrEmpty(kh.SDT) ? kh.SDT : "—")
                            </div>
                            <div class="col-12">
                                <strong>Địa chỉ giao:</strong><br />
                                @(kh != null ? kh.diachi : "—")
                                @if (hd != null && !string.IsNullOrEmpty(hd.ghichu))
                                {
                                    <br />
                                    <small class="text-muted">Ghi chú: @hd.ghichu</small>
                                }
                            </div>
                        </div>
                    </div>

                    @using (Html.BeginForm("GanNhanVien", "ChuyenHang", new { area = "Admin" }, FormMethod.Post, new { id = "formGanNhanVien" }))
                    {
                        <input type="hidden" name="txt_machuyenhang" value="@Model.machuyenhang" />

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">
                                Nhân viên giao hàng <span class="text-danger ms-1">*</span>
                            </label>
                            @Html.DropDownList(
                                "txt_manv",
                                (SelectList)ViewBag.manv,
                                "-- Chọn nhân viên giao hàng --",
                                new { @class = "form-select", required = "required" }
                            )
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-brand px-4">
                                <i class="bi bi-check-circle me-1"></i> Gán nhân viên
                            </button>
                            <a href="@Url.Action("Index", "ChuyenHang", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">
                                Hủy bỏ
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>