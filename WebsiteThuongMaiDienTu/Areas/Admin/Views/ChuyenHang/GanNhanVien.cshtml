@using WebsiteThuongMaiDienTu.Models
@model chuyenhang
@{
    ViewBag.Title = "Gán nhân viên giao hàng";
    var hd = Model.hoadon;
    var kh = hd != null ? hd.khachhang : null;
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2>
                <i class="bi bi-person-gear" style="color: var(--brand-yellow);"></i>
                Gán nhân viên giao hàng — Phiếu #@Model.machuyenhang
            </h2>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
            </div>
        }

        <div class="alert alert-info mb-4">
            <div class="row g-2">
                <div class="col-md-4">
                    <strong>Hóa đơn:</strong><br />
                    #@Model.mahoadon
                </div>
                <div class="col-md-4">
                    <strong>Khách hàng:</strong><br />
                    @(kh != null ? kh.hoten : "—")
                </div>
                <div class="col-md-4">
                    <strong>Số điện thoại:</strong><br />
                    @(kh != null && !string.IsNullOrEmpty(kh.SDT) ? kh.SDT : "—")
                </div>
                <div class="col-12">
                    <strong>Địa chỉ giao:</strong><br />
                    @(kh != null ? kh.diachi : "—")
                    @if (hd != null && !string.IsNullOrEmpty(hd.ghichu))
                    {
                        <br />
                        <small class="text-muted">Ghi chú: @hd.ghichu</small>
                    }
                </div>
            </div>
        </div>

        @using (Html.BeginForm("GanNhanVien", "ChuyenHang", new { area = "Admin" }, FormMethod.Post, new { id = "formGanNhanVien" }))
        {
            <input type="hidden" name="txt_machuyenhang" value="@Model.machuyenhang" />

            <div class="mb-4">
                <label class="form-label">
                    Nhân viên giao hàng <span class="text-danger">*</span>
                </label>
                @Html.DropDownList(
                    "txt_manv",
                    (SelectList)ViewBag.manv,
                    "-- Chọn nhân viên giao hàng --",
                    new { @class = "form-select", required = "required" }
                )
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu">
                    <i class="bi bi-check-circle"></i> Gán nhân viên
                </button>
                <a href="@Url.Action("Index", "ChuyenHang", new { area = "Admin" })" class="btn-huy">
                    Hủy bỏ
                </a>
            </div>
        }
    </div>
</div>