@using WebsiteThuongMaiDienTu.Models
@model List<dathang>
@{
    ViewBag.Title = "Đơn hàng đã từ chối";
}

<div class="kh-container kh-container-wide">
    <div class="kh-card">
        <div class="kh-header">
            <h2>
                <i class="bi bi-x-octagon" style="color:#C62828;"></i>
                Phiếu đặt hàng đã từ chối
            </h2>
            <a href="@Url.Action("Index", "DuyetDon", new { area = "Admin" })" class="btn-huy"
               style="padding:10px 16px;background:#f5f5f5;border:2px solid #e0e0e0;border-radius:8px;">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="kh-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Mã đơn</th>
                            <th>Khách hàng</th>
                            <th style="width: 110px;">Ngày đặt</th>
                            <th>Lý do / Ghi chú</th>
                            <th style="width: 100px;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.madathang</strong></td>
                                <td>@(item.khachhang != null ? item.khachhang.hoten : "—")</td>
                                <td>@item.ngaydathang.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <small class="text-muted">
                                        @(string.IsNullOrEmpty(item.ghichu) ? "—" : item.ghichu)
                                    </small>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("XoaDonTuChoi", "DuyetDon", new { area = "Admin", id = item.madathang })"
                                       class="btn-icon btn-xoa"
                                       title="Xóa đơn"
                                       onclick="return confirm('XÓA VĨNH VIỄN đơn #@item.madathang?\nKhách hàng sẽ không thể tra cứu lại đơn này.\nTiếp tục?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Chưa có đơn hàng nào bị từ chối.
            </div>
        }
    </div>
</div>