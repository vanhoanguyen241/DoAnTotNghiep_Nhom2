@using WebsiteThuongMaiDienTu.Models
@model List<dathang>
@{
    ViewBag.Title = "Đơn hàng đã từ chối";
    bool isAdmin = ViewBag.IsAdmin == true;
}

<div class="container-fluid px-4 py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-x-octagon me-2" style="color:#C62828;"></i>
                Phiếu đặt hàng đã từ chối
            </h2>
            <a href="@Url.Action("Index", "DuyetDon", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="card-body pb-0">
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;" class="text-uppercase text-secondary small fw-bold">Mã đơn</th>
                            <th class="text-uppercase text-secondary small fw-bold">Khách hàng</th>
                            <th style="width: 110px;" class="text-uppercase text-secondary small fw-bold">Ngày đặt</th>
                            <th class="text-uppercase text-secondary small fw-bold">Lý do / Ghi chú</th>
                            <th style="width: 100px;" class="text-center text-uppercase text-secondary small fw-bold">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong class="text-dark">#@item.madathang</strong></td>
                                <td>@(item.khachhang != null ? item.khachhang.hoten : "—")</td>
                                <td>@item.ngaydathang.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <small class="text-muted">
                                        @(string.IsNullOrEmpty(item.ghichu) ? "—" : item.ghichu)
                                    </small>
                                </td>
                                <td class="text-center">
                                    @if (isAdmin)
                                    {
                                        <a href="@Url.Action("XoaDonTuChoi", "DuyetDon", new { area = "Admin", id = item.madathang })"
                                           class="btn btn-sm btn-light text-danger"
                                           title="Xóa đơn"
                                           onclick="return confirm('XÓA VĨNH VIỄN đơn #@item.madathang?\nKhách hàng sẽ không thể tra cứu lại đơn này.\nTiếp tục?');">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-1"></i> Chưa có đơn hàng nào bị từ chối.
                </div>
            </div>
        }
    </div>
</div>