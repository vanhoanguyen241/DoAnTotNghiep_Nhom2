@using WebsiteThuongMaiDienTu.Models
@model List<dathang>
@{
    ViewBag.Title = "Duyệt đơn hàng";
}

<div class="container-fluid px-4 py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-clipboard-check me-2 text-brand-yellow"></i>
                Phiếu đặt hàng chờ duyệt
            </h2>
            <div class="d-flex gap-2">
                <a href="@Url.Action("DanhSachTuChoi", "DuyetDon", new { area = "Admin" })" class="btn btn-danger text-white">
                    <i class="bi bi-x-octagon me-1"></i> Đơn đã từ chối
                </a>
                <a href="@Url.Action("Index", "HoaDon", new { area = "Admin" })" class="btn btn-light border shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Tất cả hóa đơn
                </a>
            </div>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="card-body pb-0">
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;" class="text-uppercase text-secondary small fw-bold">Mã đơn</th>
                            <th class="text-uppercase text-secondary small fw-bold">Khách hàng</th>
                            <th style="width: 120px;" class="text-uppercase text-secondary small fw-bold">SĐT</th>
                            <th style="width: 110px;" class="text-uppercase text-secondary small fw-bold">Ngày đặt</th>
                            <th style="width: 110px;" class="text-uppercase text-secondary small fw-bold">Ngày giao</th>
                            <th style="width: 100px;" class="text-center text-uppercase text-secondary small fw-bold">Số SP</th>
                            <th style="width: 110px;" class="text-center text-uppercase text-secondary small fw-bold">Giao tận nơi</th>
                            <th style="width: 110px;" class="text-center text-uppercase text-secondary small fw-bold">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            int soSP = item.chitietdathangs != null ? item.chitietdathangs.Count : 0;
                            <tr>
                                <td><strong class="text-dark">@item.madathang</strong></td>
                                <td>@(item.khachhang != null ? item.khachhang.hoten : "—")</td>
                                <td>@(item.khachhang != null && !string.IsNullOrEmpty(item.khachhang.SDT) ? item.khachhang.SDT : "—")</td>
                                <td>@item.ngaydathang.ToString("dd/MM/yyyy")</td>
                                <td>@item.ngaygiaohang.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">@soSP</span>
                                </td>
                                <td class="text-center">
                                    @if (item.giaotannoi)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">Có</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Tại quầy</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("ChiTiet", "DuyetDon", new { area = "Admin", id = item.madathang })"
                                       class="btn btn-sm btn-light text-primary" title="Duyệt đơn">
                                        <i class="bi bi-check2-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-1"></i> Hiện không có phiếu đặt hàng nào cần duyệt.
                </div>
            </div>
        }
    </div>
</div>