@using WebsiteThuongMaiDienTu.Models
@model List<chitietdathang>
@{
    ViewBag.Title = "Duyệt đơn hàng";
    var datHang = ViewBag.DatHang as dathang;
    var khachHang = ViewBag.KhachHang as khachhang;
    var tonKho = ViewBag.TonKho as Dictionary<string, int>;
    if (tonKho == null) { tonKho = new Dictionary<string, int>(); }
}

@if (datHang == null)
{
    <div class="container-fluid px-4 py-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <div class="alert alert-danger">Không tìm thấy phiếu đặt hàng.</div>
                <a href="@Url.Action("Index", "DuyetDon", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
                <h2 class="h4 mb-0 fw-bold text-dark">
                    <i class="bi bi-clipboard2-check me-2" style="color: var(--brand-yellow);"></i>
                    Duyệt phiếu đặt hàng #@datHang.madathang
                </h2>
                <a href="@Url.Action("Index", "DuyetDon", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>

            @if (TempData["ThongBao"] != null)
            {
                <div class="card-body pb-0">
                    <div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">
                        @TempData["ThongBao"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }

            <!-- Thông tin khách hàng & đơn -->
            <div class="card-body p-4 pb-0">
                <div class="alert alert-info mb-4">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <strong>Khách hàng:</strong><br />
                            @(khachHang != null ? khachHang.hoten : "—")
                        </div>
                        <div class="col-md-3">
                            <strong>Số điện thoại:</strong><br />
                            @(khachHang != null && !string.IsNullOrEmpty(khachHang.SDT) ? khachHang.SDT : "—")
                        </div>
                        <div class="col-md-3">
                            <strong>Ngày đặt / Ngày giao:</strong><br />
                            @datHang.ngaydathang.ToString("dd/MM/yyyy") → @datHang.ngaygiaohang.ToString("dd/MM/yyyy")
                        </div>
                        <div class="col-md-3">
                            <strong>Hình thức:</strong><br />
                            @(datHang.giaotannoi ? "Giao tận nơi" : "Nhận tại cửa hàng")
                        </div>
                        @if (!string.IsNullOrEmpty(datHang.ghichu))
                        {
                            <div class="col-12 mt-2">
                                <strong>Ghi chú:</strong> @datHang.ghichu
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                using (Html.BeginForm("XuLyDuyet", "DuyetDon", new { area = "Admin" }, FormMethod.Post, new { id = "formDuyetDon" }))
                {
                    <input type="hidden" name="madathang" value="@datHang.madathang" />

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 120px;" class="text-uppercase text-secondary small fw-bold">Mã SP</th>
                                    <th class="text-uppercase text-secondary small fw-bold">Tên sản phẩm</th>
                                    <th style="width: 110px;" class="text-end text-uppercase text-secondary small fw-bold">Đơn giá</th>
                                    <th style="width: 120px;" class="text-center text-uppercase text-secondary small fw-bold">Khách đặt</th>
                                    <th style="width: 120px;" class="text-center text-uppercase text-secondary small fw-bold">Tồn kho</th>
                                    <th style="width: 170px;" class="text-center text-uppercase text-secondary small fw-bold">
                                        Số lượng duyệt <span class="text-danger ms-1">*</span>
                                    </th>
                                    <th style="width: 130px;" class="text-end text-uppercase text-secondary small fw-bold">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ct in Model)
                                {
                                    int ton = tonKho.ContainsKey(ct.masanpham) ? tonKho[ct.masanpham] : 0;
                                    int macDinh = Math.Min(ct.soluongdat, ton);
                                    <tr>
                                        <td><strong class="text-dark">@ct.masanpham</strong></td>
                                        <td>@(ct.sanpham != null ? ct.sanpham.tensanpham : "—")</td>
                                        <td class="text-end">@string.Format("{0:N0}₫", ct.dongia)</td>
                                        <td class="text-center">
                                            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">@ct.soluongdat</span>
                                        </td>
                                        <td class="text-center">
                                            @if (ton > 0)
                                            {
                                                <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2">@ton</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-2">Hết</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <input type="number"
                                                   name="sl_@ct.masanpham"
                                                   class="form-control sl-duyet text-center fw-bold mx-auto"
                                                   min="0"
                                                   max="@Math.Min(ton, ct.soluongdat)"
                                                   value="@macDinh"
                                                   data-goc="@ct.soluongdat"
                                                   data-ton="@ton"
                                                   data-dat="@ct.soluongdat"
                                                   style="max-width: 100px;"
                                                   required />
                                        </td>
                                        <td class="text-end">
                                            <strong class="thanh-tien text-danger">
                                                @string.Format("{0:N0}₫", ct.dongia * macDinh)
                                            </strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="card-body border-top">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div>
                                <span class="text-secondary fw-normal">Tổng tiền sau duyệt:</span>
                                <span id="tongTienMoi" class="h4 mb-0 text-danger fw-bold ms-2">
                                    @string.Format("{0:N0}₫", datHang.chitietdathangs.Sum(ct => ct.thanhtien))
                                </span>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-danger"
                                        data-bs-toggle="modal" data-bs-target="#modalTuChoi">
                                    <i class="bi bi-x-octagon me-1"></i> Từ chối đơn
                                </button>
                                <button type="submit" class="btn btn-brand px-4"
                                        onclick="return confirm('Xác nhận duyệt đơn với số lượng đã chọn?');">
                                    <i class="bi bi-check2-circle me-1"></i> Duyệt đơn
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="card-body pt-0">
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i> Phiếu đặt hàng này chưa có sản phẩm nào.
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Modal Từ chối -->
    <div class="modal fade" id="modalTuChoi" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <form method="post" action="@Url.Action("TuChoi", "DuyetDon", new { area = "Admin" })">
                    <input type="hidden" name="id" value="@datHang.madathang" />
                    <div class="modal-header bg-danger-subtle text-danger-emphasis border-0">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-x-octagon-fill me-1"></i> Từ chối đơn #@datHang.madathang
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label fw-bold">
                            Lý do từ chối <span class="text-danger ms-1">*</span>
                        </label>
                        <textarea name="lydo" class="form-control" rows="4"
                                  placeholder="Ví dụ: Hết hàng, khách không liên hệ được..."
                                  required maxlength="500"></textarea>
                        <small class="text-muted d-block mt-2">
                            Lý do sẽ được nối vào phần ghi chú của phiếu đặt hàng.
                        </small>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-danger"
                                onclick="return confirm('Xác nhận từ chối đơn hàng này?');">
                            <i class="bi bi-x-octagon me-1"></i> Xác nhận từ chối
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Tính lại thành tiền + tổng tiền khi nhân viên thay đổi số lượng duyệt
        (function () {
            function formatVND(n) {
                return new Intl.NumberFormat('vi-VN').format(n) + '₫';
            }

            function recalc() {
                var tong = 0;
                document.querySelectorAll('.sl-duyet').forEach(function (input) {
                    var tr = input.closest('tr');
                    var priceCell = tr.querySelectorAll('td')[2];
                    var price = parseInt(priceCell.textContent.replace(/[^\d]/g, ''), 10) || 0;
                    var sl = parseInt(input.value, 10) || 0;
                    if (sl < 0) sl = 0;

                    var ton = parseInt(input.getAttribute('data-ton'), 10) || 0;
                    var dat = parseInt(input.getAttribute('data-dat'), 10) || 0; // Lấy số lượng khách đặt

                    // Chặn không cho vượt quá tồn kho VÀ số lượng khách đặt
                    var maxAllowed = Math.min(ton, dat);
                    if (sl > maxAllowed) {
                        sl = maxAllowed;
                        input.value = maxAllowed;
                    }

                    var tt = price * sl;
                    tong += tt;
                    var ttCell = tr.querySelector('.thanh-tien');
                    if (ttCell) ttCell.textContent = formatVND(tt);
                });
                var el = document.getElementById('tongTienMoi');
                if (el) el.textContent = formatVND(tong);
            }

            document.addEventListener('input', function (e) {
                if (e.target && e.target.classList && e.target.classList.contains('sl-duyet')) {
                    recalc();
                }
            });

            document.addEventListener('DOMContentLoaded', recalc);
        })();
    </script>
}