@using WebsiteThuongMaiDienTu.Models
@model List<hoadon>
@{
    ViewBag.Title = "Duyệt thanh toán";
}

<div class="kh-container kh-container-wide">
    <div class="kh-card">
        <div class="kh-header">
            <h2>
                <i class="bi bi-cash-coin" style="color: var(--brand-yellow);"></i>
                Hóa đơn chờ xác nhận thanh toán
            </h2>

            <a href="@Url.Action("DaThanhToan", "ThanhToan", new { area = "Admin" })"
               class="btn-them"
               style="background:#E8F5E9;color:#2E7D32;">
                <i class="bi bi-check2-all"></i> Danh sách đã thanh toán
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="kh-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Mã HĐ</th>
                            <th style="width: 100px;" class="text-center">Mã đơn đặt</th>
                            <th>Khách hàng</th>
                            <th style="width: 120px;">SĐT</th>
                            <th style="width: 110px;">Ngày đặt</th>
                            <th style="width: 130px;" class="text-end">Tổng tiền</th>
                            <th style="width: 100px;" class="text-center">Giao tận nơi</th>
                            <th style="width: 170px;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var donDat = item.dathangs != null && item.dathangs.Any()
                                ? item.dathangs.FirstOrDefault()
                                : null;

                            var kh = item.khachhang;

                            <tr>
                                <td><strong>#@item.mahoadon</strong></td>

                                <td class="text-center">
                                    @if (donDat != null)
                                    {
                                        <span class="sp-badge sp-badge-warning">#@donDat.madathang</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @(kh != null ? kh.hoten : "—")
                                </td>

                                <td>
                                    @(kh != null && !string.IsNullOrEmpty(kh.SDT) ? kh.SDT : "—")
                                </td>

                                <td>
                                    @item.ngaydathang.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end">
                                    <strong>@string.Format("{0:N0}₫", item.tongtien)</strong>
                                </td>

                                <td class="text-center">
                                    @if (item.giaotannoi)
                                    {
                                        <span class="sp-badge sp-badge-warning">Có</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a href="@Url.Action("DuyetThanhToan", "ThanhToan", new { area = "Admin", id = item.mahoadon })"
                                       class="btn-them"
                                       style="padding:8px 14px;"
                                       onclick="return confirm('Xác nhận khách hàng đã thanh toán hóa đơn #@item.mahoadon?');">
                                        <i class="bi bi-cash-coin"></i> Duyệt thanh toán
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Hiện không có hóa đơn nào chờ xác nhận thanh toán.
            </div>
        }
    </div>
</div>