@using WebsiteThuongMaiDienTu.Models
@model List<hoadon>
@{
    ViewBag.Title = "Duyệt thanh toán";
}

<div class="container-fluid px-4 py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-cash-coin me-2 text-brand-yellow"></i>
                Hóa đơn chờ xác nhận thanh toán
            </h2>

            <a href="@Url.Action("DaThanhToan", "ThanhToan", new { area = "Admin" })" class="btn btn-success px-4 text-brand-green" style="background:#E8F5E9;border:none;">
                <i class="bi bi-check2-all me-1"></i> Danh sách đã thanh toán
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="card-body pb-0">
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;" class="text-uppercase text-secondary small fw-bold">Mã HĐ</th>
                            <th style="width: 100px;" class="text-center text-uppercase text-secondary small fw-bold">Mã đơn đặt</th>
                            <th class="text-uppercase text-secondary small fw-bold">Khách hàng</th>
                            <th style="width: 120px;" class="text-uppercase text-secondary small fw-bold">SĐT</th>
                            <th style="width: 110px;" class="text-uppercase text-secondary small fw-bold">Ngày đặt</th>
                            <th style="width: 130px;" class="text-end text-uppercase text-secondary small fw-bold">Tổng tiền</th>
                            <th style="width: 100px;" class="text-center text-uppercase text-secondary small fw-bold">Giao tận nơi</th>
                            <th style="width: 170px;" class="text-center text-uppercase text-secondary small fw-bold">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var donDat = item.dathangs != null && item.dathangs.Any()
                                ? item.dathangs.FirstOrDefault()
                                : null;

                            var kh = item.khachhang;

                            <tr>
                                <td><strong class="text-dark">#@item.mahoadon</strong></td>

                                <td class="text-center">
                                    @if (donDat != null)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">#@donDat.madathang</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @(kh != null ? kh.hoten : "—")
                                </td>

                                <td>
                                    @(kh != null && !string.IsNullOrEmpty(kh.SDT) ? kh.SDT : "—")
                                </td>

                                <td>
                                    @item.ngaydathang.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end">
                                    <strong class="text-danger">@string.Format("{0:N0}₫", item.tongtien)</strong>
                                </td>

                                <td class="text-center">
                                    @if (item.giaotannoi)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">Có</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a href="@Url.Action("DuyetThanhToan", "ThanhToan", new { area = "Admin", id = item.mahoadon })"
                                       class="btn btn-sm btn-brand px-3"
                                       onclick="return confirm('Xác nhận khách hàng đã thanh toán hóa đơn #@item.mahoadon?');">
                                        <i class="bi bi-cash-coin me-1"></i> Duyệt thanh toán
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-1"></i> Hiện không có hóa đơn nào chờ xác nhận thanh toán.
                </div>
            </div>
        }
    </div>
</div>