@using WebsiteThuongMaiDienTu.Models
@model List<hoadon>
@{
    ViewBag.Title = "Hóa đơn đã thanh toán";
}

<div class="kh-container kh-container-wide">
    <div class="kh-card">
        <div class="kh-header">
            <h2>
                <i class="bi bi-check2-all" style="color:#2E7D32;"></i>
                Hóa đơn đã thanh toán
            </h2>

            <a href="@Url.Action("Index", "ThanhToan", new { area = "Admin" })"
               class="btn-huy"
               style="padding:10px 16px;background:#f5f5f5;border:2px solid #e0e0e0;border-radius:8px;">
                <i class="bi bi-arrow-left"></i> Chờ thanh toán
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="kh-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Mã HĐ</th>
                            <th style="width: 100px;" class="text-center">Mã đơn đặt</th>
                            <th>Khách hàng</th>
                            <th style="width: 120px;">SĐT</th>
                            <th style="width: 110px;">Ngày đặt</th>
                            <th style="width: 130px;" class="text-end">Tổng tiền</th>
                            <th style="width: 120px;" class="text-center">Thanh toán</th>
                            <th style="width: 130px;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var donDat = item.dathangs != null && item.dathangs.Any()
                                ? item.dathangs.FirstOrDefault()
                                : null;

                            var kh = item.khachhang;

                            <tr>
                                <td><strong>#@item.mahoadon</strong></td>

                                <td class="text-center">
                                    @if (donDat != null)
                                    {
                                        <span class="sp-badge sp-badge-warning">#@donDat.madathang</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @(kh != null ? kh.hoten : "—")
                                </td>

                                <td>
                                    @(kh != null && !string.IsNullOrEmpty(kh.SDT) ? kh.SDT : "—")
                                </td>

                                <td>
                                    @item.ngaydathang.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end">
                                    <strong>@string.Format("{0:N0}₫", item.tongtien)</strong>
                                </td>

                                <td class="text-center">
                                    <span class="sp-badge sp-badge-success">Đã thanh toán</span>
                                </td>

                                <td class="text-center">
                                    <a href="@Url.Action("Index", "ChiTietHoaDon", new { area = "Admin", id = item.mahoadon })"
                                       class="btn-icon btn-sua"
                                       title="Xem chi tiết hóa đơn">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <a href="@Url.Action("HuyThanhToan", "ThanhToan", new { area = "Admin", id = item.mahoadon })"
                                       class="btn-icon btn-xoa"
                                       title="Hủy xác nhận thanh toán"
                                       onclick="return confirm('Bạn có chắc chắn muốn hủy xác nhận thanh toán hóa đơn #@item.mahoadon?');">
                                        <i class="bi bi-x-circle-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Chưa có hóa đơn nào được xác nhận thanh toán.
            </div>
        }
    </div>
</div>