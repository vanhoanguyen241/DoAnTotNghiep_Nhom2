@{
    ViewBag.Title = "Tạo tài khoản";
}
<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark"><i class="bi bi-person-plus me-2" style="color: var(--brand-yellow);"></i> Tạo tài khoản cho Nhân viên</h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao</div>
                    }
                    @using (Html.BeginForm("TaoMoi", "TaiKhoan", new { area = "Admin" }, FormMethod.Post, new { id = "formThemTK", autocomplete = "off" }))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Nhân viên <span class="text-danger ms-1">*</span></label>
                            @Html.DropDownList("txt_manv", (SelectList)ViewBag.manv, "-- Chọn nhân viên --", new { @class = "form-select", required = "required" })
                            <small class="text-muted">Chỉ hiển thị nhân viên chưa có tài khoản.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Tên đăng nhập <span class="text-danger ms-1">*</span></label>
                            <input type="text" name="txt_tendangnhap" class="form-control" placeholder="Nhập tên đăng nhập" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Mật khẩu <span class="text-danger ms-1">*</span></label>
                            <input type="password" name="txt_matkhau" class="form-control" placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)" required minlength="6" />
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-brand px-4"><i class="bi bi-check-circle me-1"></i> Tạo tài khoản</button>
                            <a href="@Url.Action("Index", "TaiKhoan", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">Hủy bỏ</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>