@using WebsiteThuongMaiDienTu.Models
@model List<taikhoan>
@{
    ViewBag.Title = "Quản lý Tài khoản";
}
<div class="kh-container kh-container-wide">
    <div class="kh-card">
        <div class="kh-header">
            <h2><i class="bi bi-key" style="color: var(--brand-yellow);"></i> Quản lý Tài khoản Nhân viên</h2>
            <a href="@Url.Action("TaoMoi", "TaiKhoan", new { area = "Admin" })" class="btn-them">
                <i class="bi bi-plus-circle"></i> Tạo tài khoản
            </a>
        </div>
        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="kh-table">
                <thead>
                    <tr>
                        <th>Tên đăng nhập</th>
                        <th>Nhân viên</th>
                        <th style="width: 150px;" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var nv = item.nhanvien;
                        <tr>
                            <td><strong>@item.tendangnhap</strong></td>
                            <td>@(nv != null ? nv.hoten : "—")</td>
                            <td class="text-center">
                                <a href="@Url.Action("Sua", "TaiKhoan", new { area = "Admin", id = item.tendangnhap })" class="btn-icon btn-sua" title="Đổi mật khẩu"><i class="bi bi-key-fill"></i></a>
                                <a href="@Url.Action("Xoa", "TaiKhoan", new { area = "Admin", id = item.tendangnhap })" class="btn-icon btn-xoa" title="Xóa" onclick="return confirm('Bạn có chắc chắn muốn xóa tài khoản này?');"><i class="bi bi-trash-fill"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>