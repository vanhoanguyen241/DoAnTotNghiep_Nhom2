@using WebsiteThuongMaiDienTu.Models
@model taikhoan
@{
    ViewBag.Title = "Đổi mật khẩu";
}
<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark"><i class="bi bi-key-fill me-2 text-brand-yellow"></i> Đổi mật khẩu</h2>
                    <p class="text-muted mb-0">Tài khoản: <strong>@Model.tendangnhap</strong></p>
                </div>

                <div class="card-body p-4 pt-2">
                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao</div>
                    }
                    @using (Html.BeginForm("Sua", "TaiKhoan", new { area = "Admin" }, FormMethod.Post, new { autocomplete = "off" }))
                    {
                        <input type="hidden" name="txt_tendangnhap" value="@Model.tendangnhap" />
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Tên đăng nhập</label>
                            <input type="text" class="form-control bg-readonly" value="@Model.tendangnhap" readonly />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Mật khẩu mới <span class="text-danger ms-1">*</span></label>
                            <input type="password" name="txt_matkhaumoi" class="form-control" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" minlength="6" />
                            <small class="text-muted">Để trống nếu không muốn đổi mật khẩu.</small>
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-brand px-4"><i class="bi bi-check-circle me-1"></i> Lưu thay đổi</button>
                            <a href="@Url.Action("Index", "TaiKhoan", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">Hủy bỏ</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>