@{
    ViewBag.Title = "Thêm khách hàng";
}
<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark"><i class="bi bi-person-plus me-2 text-brand-yellow"></i> Thêm khách hàng mới</h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @using (Html.BeginForm("TaoMoi", "KhachHang", new { area = "Admin" }, FormMethod.Post, new { id = "formThemKH", autocomplete = "off" }))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Họ tên <span class="text-danger ms-1">*</span></label>
                            <input type="text" id="txt_hoten" name="txt_hoten" class="form-control"
                                   placeholder="Nhập họ và tên khách hàng" required aria-required="true" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Địa chỉ <span class="text-danger ms-1">*</span></label>
                            <input type="text" id="txt_diachi" name="txt_diachi" class="form-control"
                                   placeholder="Nhập địa chỉ" required aria-required="true" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Số điện thoại</label>
                            <input type="text" id="txt_sdt" name="txt_sdt" class="form-control"
                                   placeholder="Nhập 10-11 chữ số (không bắt buộc)" />
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-brand px-4"><i class="bi bi-check-circle me-1"></i> Xác nhận Lưu</button>
                            <a href="@Url.Action("Index", "KhachHang", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">Hủy bỏ</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>