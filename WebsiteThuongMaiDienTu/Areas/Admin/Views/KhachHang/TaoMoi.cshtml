@{
    ViewBag.Title = "Thêm khách hàng";
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2><i class="bi bi-person-plus" style="color: var(--brand-yellow);"></i> Thêm khách hàng mới</h2>
        </div>

        @using (Html.BeginForm("TaoMoi", "KhachHang", new { area = "Admin" }, FormMethod.Post, new { id = "formThemKH", autocomplete = "off" }))
        {
            <div class="mb-3">
                <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                <input type="text" id="txt_hoten" name="txt_hoten" class="form-control"
                       placeholder="Nhập họ và tên khách hàng" required aria-required="true" />
            </div>
            <div class="mb-3">
                <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                <input type="text" id="txt_diachi" name="txt_diachi" class="form-control"
                       placeholder="Nhập địa chỉ" required aria-required="true" />
            </div>
            <div class="mb-4">
                <label class="form-label">Số điện thoại</label>
                <input type="text" id="txt_sdt" name="txt_sdt" class="form-control"
                       placeholder="Nhập 10-11 chữ số (không bắt buộc)" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu"><i class="bi bi-check-circle"></i> Xác nhận Lưu</button>
                <a href="@Url.Action("Index", "KhachHang", new { area = "Admin" })" class="btn-huy">Hủy bỏ</a>
            </div>
        }
    </div>
</div>