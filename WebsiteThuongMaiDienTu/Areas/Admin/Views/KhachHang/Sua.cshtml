@using WebsiteThuongMaiDienTu.Models
@model khachhang
@{
    ViewBag.Title = "Sửa khách hàng";
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2><i class="bi bi-pencil-square" style="color: var(--brand-yellow);"></i> Cập nhật thông tin khách hàng</h2>
        </div>

        @using (Html.BeginForm("Sua", "KhachHang", new { area = "Admin" }, FormMethod.Post, new { id = "formSuaKH" }))
        {
            <div class="mb-3">
                <label class="form-label">Mã khách hàng</label>
                <input type="number" id="txt_makh" name="txt_makh" class="form-control"
                       readonly value="@Model.makh" style="background: #f8f9fa;" />
            </div>
            <div class="mb-3">
                <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                <input type="text" id="txt_hoten" name="txt_hoten" class="form-control"
                       value="@Model.hoten" required aria-required="true" />
            </div>
            <div class="mb-3">
                <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                <input type="text" id="txt_diachi" name="txt_diachi" class="form-control"
                       value="@Model.diachi" required aria-required="true" />
            </div>
            <div class="mb-4">
                <label class="form-label">Số điện thoại</label>
                <input type="text" id="txt_sdt" name="txt_sdt" class="form-control"
                       value="@Model.SDT" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu"><i class="bi bi-check-circle"></i> Lưu thay đổi</button>
                <a href="@Url.Action("Index", "KhachHang", new { area = "Admin" })" class="btn-huy">Hủy bỏ</a>
            </div>
        }
    </div>
</div>