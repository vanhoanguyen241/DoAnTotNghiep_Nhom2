@using WebsiteThuongMaiDienTu.Models
@model khachhang
@{
    ViewBag.Title = "Sửa khách hàng";
}
<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark"><i class="bi bi-pencil-square me-2" style="color: var(--brand-yellow);"></i> Cập nhật thông tin khách hàng</h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @using (Html.BeginForm("Sua", "KhachHang", new { area = "Admin" }, FormMethod.Post, new { id = "formSuaKH" }))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Mã khách hàng</label>
                            <input type="number" id="txt_makh" name="txt_makh" class="form-control"
                                   readonly value="@Model.makh" style="background: #f8f9fa;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Họ tên <span class="text-danger ms-1">*</span></label>
                            <input type="text" id="txt_hoten" name="txt_hoten" class="form-control"
                                   value="@Model.hoten" required aria-required="true" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Địa chỉ <span class="text-danger ms-1">*</span></label>
                            <input type="text" id="txt_diachi" name="txt_diachi" class="form-control"
                                   value="@Model.diachi" required aria-required="true" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Số điện thoại</label>
                            <input type="text" id="txt_sdt" name="txt_sdt" class="form-control"
                                   value="@Model.SDT" />
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-brand px-4"><i class="bi bi-check-circle me-1"></i> Lưu thay đổi</button>
                            <a href="@Url.Action("Index", "KhachHang", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">Hủy bỏ</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>