@using WebsiteThuongMaiDienTu.Models
@model khachhang
@{
    ViewBag.Title = "Sửa khách hàng";
}

<div class="row justify-content-center pt-2">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-light shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h1 class="h5 m-0 fw-bold text-dark">Cập nhật thông tin khách hàng</h1>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm("Sua", "KhachHang", new { area = "Admin" }, FormMethod.Post, new { id = "formSuaKH" }))
                {
                    <div class="mb-3">
                        <label for="txt_makh" class="form-label text-muted fs-7 text-uppercase fw-bold">Mã khách hàng (Không thể thay đổi)</label>
                        <input type="number" id="txt_makh" name="txt_makh" class="form-control bg-light font-monospace text-muted fw-bold"
                               readonly value="@Model.makh" />
                    </div>
                    <div class="mb-3">
                        <label for="txt_hoten" class="form-label text-muted fs-7 text-uppercase fw-bold">Họ tên</label>
                        <input type="text" id="txt_hoten" name="txt_hoten" class="form-control"
                               value="@Model.hoten" required aria-required="true" />
                    </div>
                    <div class="mb-3">
                        <label for="txt_diachi" class="form-label text-muted fs-7 text-uppercase fw-bold">Địa chỉ</label>
                        <input type="text" id="txt_diachi" name="txt_diachi" class="form-control"
                               value="@Model.diachi" required aria-required="true" />
                    </div>
                    <div class="mb-4">
                        <label for="txt_sdt" class="form-label text-muted fs-7 text-uppercase fw-bold">Số điện thoại</label>
                        <input type="text" id="txt_sdt" name="txt_sdt" class="form-control"
                               value="@Model.SDT" />
                    </div>
                    <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                        @Html.ActionLink("Hủy bỏ", "Index", "KhachHang", new { area = "Admin" },
                            new { @class = "btn btn-sm btn-light px-3 text-muted", role = "button" })
                        <button type="submit" class="btn btn-sm btn-primary px-4 fw-bold shadow-sm">Lưu thay đổi</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>