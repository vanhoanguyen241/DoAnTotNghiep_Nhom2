@using WebsiteThuongMaiDienTu.Models
@model List<khachhang>
@{
    ViewBag.Title = "Quản lý khách hàng";
    bool isAdmin = ViewBag.IsAdmin == true;
}

<div class="kh-container">
    <div class="kh-card">
        <div class="kh-header">
            <h2><i class="bi bi-people-fill" style="color: var(--brand-yellow);"></i> Quản lý Khách hàng</h2>
            <a href="@Url.Action("TaoMoi", "KhachHang", new { area = "Admin" })" class="btn-them">
                <i class="bi bi-plus-circle"></i> Thêm khách hàng
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="kh-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">Mã KH</th>
                        <th>Họ tên</th>
                        <th>Địa chỉ</th>
                        <th>Số điện thoại</th>
                        <th style="width: 120px;" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.makh</strong></td>
                            <td>@item.hoten</td>
                            <td>@item.diachi</td>
                            <td>@(string.IsNullOrEmpty(item.SDT) ? "—" : item.SDT)</td>
                            <td class="text-center">
                                <a href="@Url.Action("Sua", "KhachHang", new { area = "Admin", id = item.makh })"
                                   class="btn-icon btn-sua"
                                   title="Sửa">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>

                                @if (isAdmin)
                                {
                                    <a href="@Url.Action("Xoa", "KhachHang", new { area = "Admin", id = item.makh })"
                                       class="btn-icon btn-xoa"
                                       title="Xóa"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>