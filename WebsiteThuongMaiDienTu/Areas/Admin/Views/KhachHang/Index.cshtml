@using WebsiteThuongMaiDienTu.Models
@model List<khachhang>
@{
    ViewBag.Title = "Quản lý khách hàng";
    bool isAdmin = ViewBag.IsAdmin == true;

    var grid = new WebGrid(
        source: Model,
        rowsPerPage: 10,
        canPage: true,
        canSort: true,
        defaultSort: "makh"
    );
}

<div class="container-fluid px-4 py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-people-fill me-2 text-brand-yellow"></i>
                Quản lý Khách hàng
            </h2>
            <a href="@Url.Action("TaoMoi", "KhachHang", new { area = "Admin" })" class="btn btn-brand">
                <i class="bi bi-plus-circle me-1"></i> Thêm khách hàng
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="card-body pb-0">
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        <div class="card-body">
            @grid.GetHtml(
                tableStyle: "table table-hover align-middle mb-0",
                headerStyle: "table-light text-uppercase small text-secondary fw-bold",
                footerStyle: "webgrid-pager",
                mode: WebGridPagerModes.All,
                firstText: "«",
                previousText: "‹",
                nextText: "›",
                lastText: "»",
                numericLinksCount: 3,
                columns: grid.Columns(
                    grid.Column("makh", header: "Mã KH"),
                    grid.Column("hoten", header: "Họ tên"),
                    grid.Column("diachi", header: "Địa chỉ"),
                    grid.Column(
                        header: "Số điện thoại",
                        format: @<span>@(string.IsNullOrEmpty(item.SDT) ? "—" : item.SDT)</span>
),
grid.Column(
header: "Hành động",
format: @<text>
    <a href="@Url.Action("Sua", "KhachHang", new { area = "Admin", id = item.makh })"
       class="btn btn-sm btn-light text-primary me-1" title="Sửa">
        <i class="bi bi-pencil-fill"></i>
    </a>
    @if (isAdmin)
    {
        <a href="@Url.Action("Xoa", "KhachHang", new { area = "Admin", id = item.makh })"
           class="btn btn-sm btn-light text-danger" title="Xóa"
           onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?');">
            <i class="bi bi-trash-fill"></i>
        </a>
    }
</text>
)
)
)
        </div>
    </div>
</div>