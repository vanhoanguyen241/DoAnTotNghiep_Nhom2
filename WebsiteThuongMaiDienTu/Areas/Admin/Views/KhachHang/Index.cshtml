@using WebsiteThuongMaiDienTu.Models
@model List<khachhang>
@{
    ViewBag.Title = "Quản lý khách hàng";
    bool isAdmin = ViewBag.IsAdmin == true;
}

<div class="container-fluid px-4 py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-people-fill me-2 text-brand-yellow"></i>
                Quản lý Khách hàng
            </h2>
            <a href="@Url.Action("TaoMoi", "KhachHang", new { area = "Admin" })" class="btn btn-brand">
                <i class="bi bi-plus-circle me-1"></i> Thêm khách hàng
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="card-body pb-0">
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;" class="text-uppercase text-secondary small fw-bold">Mã KH</th>
                        <th class="text-uppercase text-secondary small fw-bold">Họ tên</th>
                        <th class="text-uppercase text-secondary small fw-bold">Địa chỉ</th>
                        <th class="text-uppercase text-secondary small fw-bold">Số điện thoại</th>
                        <th style="width: 120px;" class="text-center text-uppercase text-secondary small fw-bold">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong class="text-dark">@item.makh</strong></td>
                            <td>@item.hoten</td>
                            <td>@item.diachi</td>
                            <td>@(string.IsNullOrEmpty(item.SDT) ? "—" : item.SDT)</td>
                            <td class="text-center">
                                <a href="@Url.Action("Sua", "KhachHang", new { area = "Admin", id = item.makh })"
                                   class="btn btn-sm btn-light text-primary me-1"
                                   title="Sửa">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>

                                @if (isAdmin)
                                {
                                    <a href="@Url.Action("Xoa", "KhachHang", new { area = "Admin", id = item.makh })"
                                       class="btn btn-sm btn-light text-danger"
                                       title="Xóa"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>