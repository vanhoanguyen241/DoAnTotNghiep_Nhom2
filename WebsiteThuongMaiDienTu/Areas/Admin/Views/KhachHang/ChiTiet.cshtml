@model WebsiteThuongMaiDienTu.Models.khachhang
@{
    ViewBag.Title = "Thông tin khách hàng " + Model.makh;
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h2 class="h4 mb-0 fw-bold text-dark">
                        <i class="bi bi-person-badge me-2 text-brand-yellow"></i>
                        Thông tin khách hàng #@Model.makh
                    </h2>
                    <a href="javascript:history.back()" class="btn btn-light border shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
                <div class="card-body p-4">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between border-bottom">
                            <span class="text-secondary fw-medium">Mã khách hàng:</span>
                            <span class="fw-bold text-dark font-monospace">@Model.makh</span>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between border-bottom">
                            <span class="text-secondary fw-medium">Họ và tên:</span>
                            <span class="fw-bold text-dark">@Model.hoten</span>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between border-bottom">
                            <span class="text-secondary fw-medium">Số điện thoại:</span>
                            <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.SDT) ? "—" : Model.SDT)</span>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between">
                            <span class="text-secondary fw-medium">Địa chỉ:</span>
                            <span class="fw-bold text-dark text-end" style="max-width: 65%;">@Model.diachi</span>
                        </li>
                    </ul>

                    <div class="mt-4 d-flex justify-content-center gap-2 flex-wrap">
                        <!-- Nút Sửa: Cả Admin và Nhân viên đều thấy (do đã được cấp quyền "Sua" trong BaseAdminController) -->
                        <a href="@Url.Action("Sua", "KhachHang", new { area = "Admin", id = Model.makh })" class="btn btn-brand px-4">
                            <i class="bi bi-pencil-square me-1"></i> Sửa thông tin
                        </a>

                        <!-- Nút Xóa: Chỉ dành riêng cho Admin -->
                        @if (ViewBag.IsAdmin == true)
                        {
                            <a href="@Url.Action("Xoa", "KhachHang", new { area = "Admin", id = Model.makh })"
                               class="btn btn-outline-danger px-4"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?');">
                                <i class="bi bi-trash me-1"></i> Xóa khách hàng
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>