@using WebsiteThuongMaiDienTu.Models
@model hoadon
@{
    ViewBag.Title = "Sửa hóa đơn";
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2>
                <i class="bi bi-pencil-square" style="color: var(--brand-yellow);"></i>
                Cập nhật hóa đơn #@Model.mahoadon
            </h2>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
            </div>
        }

        @using (Html.BeginForm("Sua", "HoaDon", new { area = "Admin" }, FormMethod.Post, new { id = "formSuaHoaDon" }))
        {
            <div class="mb-3">
                <label class="form-label">Mã hóa đơn</label>
                <input type="number"
                       id="txt_mahoadon"
                       name="txt_mahoadon"
                       class="form-control"
                       readonly
                       value="@Model.mahoadon"
                       style="background: #f8f9fa;" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Khách hàng <span class="text-danger">*</span>
                </label>

                @Html.DropDownList(
                    "txt_makh",
                    (SelectList)ViewBag.makh,
                    "-- Chọn khách hàng --",
                    new { @class = "form-select", required = "required" }
                )
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Ngày đặt hàng</label>
                    <input type="date"
                           id="txt_ngaydathang"
                           name="txt_ngaydathang"
                           class="form-control"
                           value="@Model.ngaydathang.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Ngày giao hàng</label>
                    <input type="date"
                           id="txt_ngaygiaohang"
                           name="txt_ngaygiaohang"
                           class="form-control"
                           value="@Model.ngaygiaohang.ToString("yyyy-MM-dd")" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Ghi chú</label>
                <textarea id="txt_ghichu"
                          name="txt_ghichu"
                          class="form-control"
                          rows="3">@Model.ghichu</textarea>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="form-check sp-check">
                        <input type="checkbox"
                               class="form-check-input"
                               name="chk_dathanhtoan"
                               id="chk_dathanhtoan"
                               @(Model.dathanhtoan ? "checked" : "") />

                        <label class="form-check-label" for="chk_dathanhtoan">
                            Đã thanh toán
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check sp-check">
                        <input type="checkbox"
                               class="form-check-input"
                               name="chk_giaotannoi"
                               id="chk_giaotannoi"
                               @(Model.giaotannoi ? "checked" : "") />

                        <label class="form-check-label" for="chk_giaotannoi">
                            Giao tận nơi
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu">
                    <i class="bi bi-check-circle"></i> Lưu thay đổi
                </button>

                <a href="@Url.Action("Index", "HoaDon", new { area = "Admin" })" class="btn-huy">
                    Hủy bỏ
                </a>
            </div>
        }
    </div>
</div>