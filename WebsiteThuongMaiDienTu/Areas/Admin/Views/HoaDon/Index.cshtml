@using WebsiteThuongMaiDienTu.Models
@model List<hoadon>
@{
    ViewBag.Title = "Quản lý Hóa đơn & Duyệt đơn";
    bool isAdmin = ViewBag.IsAdmin == true;
    var dsChoDuyet = ViewBag.DsChoDuyet as List<dathang> ?? new List<dathang>();
}

<div class="container-fluid px-4 py-4">

    <!-- ═══════════ PHẦN 1: ĐƠN CHỜ DUYỆT ═══════════ -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-clipboard-check me-2 text-brand-yellow"></i>
                Đơn chờ duyệt
                <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill ms-2">@dsChoDuyet.Count</span>
            </h2>
            <a href="@Url.Action("DanhSachTuChoi", "DuyetDon", new { area = "Admin" })" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-x-octagon me-1"></i> Đơn đã từ chối
            </a>
        </div>

        @if (dsChoDuyet.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:80px;" class="text-uppercase text-secondary small fw-bold">Mã đơn</th>
                            <th class="text-uppercase text-secondary small fw-bold">Khách hàng</th>
                            <th style="width:120px;" class="text-uppercase text-secondary small fw-bold">SĐT</th>
                            <th style="width:110px;" class="text-uppercase text-secondary small fw-bold">Ngày đặt</th>
                            <th style="width:110px;" class="text-uppercase text-secondary small fw-bold">Ngày giao</th>
                            <th style="width:100px;" class="text-center text-uppercase text-secondary small fw-bold">Số SP</th>
                            <th style="width:110px;" class="text-center text-uppercase text-secondary small fw-bold">Giao tận nơi</th>
                            <th style="width:110px;" class="text-center text-uppercase text-secondary small fw-bold">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in dsChoDuyet)
                        {
                            int soSP = item.chitietdathangs != null ? item.chitietdathangs.Count : 0;
                            <tr>
                                <td><strong class="text-dark">@item.madathang</strong></td>
                                <td>@(item.khachhang != null ? item.khachhang.hoten : "—")</td>
                                <td>@(item.khachhang != null && !string.IsNullOrEmpty(item.khachhang.SDT) ? item.khachhang.SDT : "—")</td>
                                <td>@item.ngaydathang.ToString("dd/MM/yyyy")</td>
                                <td>@item.ngaygiaohang.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">@soSP</span>
                                </td>
                                <td class="text-center">
                                    @if (item.giaotannoi)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">Có</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Tại quầy</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("ChiTiet", "DuyetDon", new { area = "Admin", id = item.madathang })"
                                       class="btn btn-sm btn-light text-primary" title="Duyệt đơn">
                                        <i class="bi bi-check2-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-1"></i> Hiện không có đơn hàng nào cần duyệt.
                </div>
            </div>
        }
    </div>

    <!-- ═══════════ PHẦN 2: DANH SÁCH HÓA ĐƠN ═══════════ -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-receipt me-2 text-brand-yellow"></i>
                Quản lý Hóa đơn
            </h2>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="card-body pb-0">
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:80px;" class="text-uppercase text-secondary small fw-bold">Mã HĐ</th>
                            <th style="width:110px;" class="text-center text-uppercase text-secondary small fw-bold">Mã đơn đặt</th>
                            <th class="text-uppercase text-secondary small fw-bold">Khách hàng</th>
                            <th style="width:110px;" class="text-uppercase text-secondary small fw-bold">Ngày đặt</th>
                            <th style="width:110px;" class="text-uppercase text-secondary small fw-bold">Ngày giao</th>
                            <th style="width:130px;" class="text-end text-uppercase text-secondary small fw-bold">Tổng tiền</th>
                            <th style="width:120px;" class="text-center text-uppercase text-secondary small fw-bold">Thanh toán</th>
                            <th style="width:150px;" class="text-center text-uppercase text-secondary small fw-bold">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong class="text-dark">@item.mahoadon</strong></td>
                                <td class="text-center">
                                    @{
                                        var donDat = item.dathangs != null && item.dathangs.Any() ? item.dathangs.FirstOrDefault() : null;
                                    }
                                    @if (donDat != null)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">@donDat.madathang</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>@(item.khachhang != null ? item.khachhang.hoten : "—")</td>
                                <td>@item.ngaydathang.ToString("dd/MM/yyyy")</td>
                                <td>@item.ngaygiaohang.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-medium text-danger">@string.Format("{0:N0}₫", item.tongtien)</td>
                                <td class="text-center">
                                    @if (item.dathanhtoan)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2">Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-2">Chưa</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Index", "ChiTietHoaDon", new { area = "Admin", id = item.mahoadon })"
                                       class="btn btn-sm btn-light text-primary me-1" title="Xem chi tiết">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    @if (isAdmin)
                                    {
                                        <a href="@Url.Action("Xoa", "HoaDon", new { area = "Admin", id = item.mahoadon })"
                                           class="btn btn-sm btn-light text-danger" title="Xóa"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa hóa đơn này?');">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small d-inline-block mt-1">Chỉ xem</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-1"></i> Chưa có hóa đơn nào.
                </div>
            </div>
        }
    </div>
</div>