@{
    ViewBag.Title = "Thêm hóa đơn";
    var homNay = DateTime.Today.ToString("yyyy-MM-dd");
}
<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark">
                        <i class="bi bi-receipt me-2" style="color: var(--brand-yellow);"></i> Thêm hóa đơn mới
                    </h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
                        </div>
                    }

                    @using (Html.BeginForm("TaoMoi", "HoaDon", new { area = "Admin" }, FormMethod.Post, new { id = "formThemHoaDon", autocomplete = "off" }))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">
                                Khách hàng <span class="text-danger ms-1">*</span>
                            </label>

                            @Html.DropDownList(
                                "txt_makh",
                                (SelectList)ViewBag.makh,
                                "-- Chọn khách hàng --",
                                new { @class = "form-select", required = "required" }
                            )
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Ngày đặt hàng</label>
                                <input type="date"
                                       id="txt_ngaydathang"
                                       name="txt_ngaydathang"
                                       class="form-control"
                                       value="@homNay" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Ngày giao hàng</label>
                                <input type="date"
                                       id="txt_ngaygiaohang"
                                       name="txt_ngaygiaohang"
                                       class="form-control"
                                       value="@homNay" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Ghi chú</label>
                            <textarea id="txt_ghichu"
                                      name="txt_ghichu"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Nhập ghi chú cho hóa đơn"></textarea>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-check p-3 bg-light rounded border d-flex align-items-center gap-2">
                                    <input type="checkbox"
                                           class="form-check-input mt-0"
                                           name="chk_dathanhtoan"
                                           id="chk_dathanhtoan" style="width: 1.25em; height: 1.25em; cursor: pointer;" />

                                    <label class="form-check-label fw-bold text-dark mb-0" for="chk_dathanhtoan" style="cursor: pointer;">
                                        Đã thanh toán
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check p-3 bg-light rounded border d-flex align-items-center gap-2">
                                    <input type="checkbox"
                                           class="form-check-input mt-0"
                                           name="chk_giaotannoi"
                                           id="chk_giaotannoi" style="width: 1.25em; height: 1.25em; cursor: pointer;" />

                                    <label class="form-check-label fw-bold text-dark mb-0" for="chk_giaotannoi" style="cursor: pointer;">
                                        Giao tận nơi
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-brand px-4">
                                <i class="bi bi-check-circle me-1"></i> Thêm mới
                            </button>

                            <a href="@Url.Action("Index", "HoaDon", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">
                                Hủy bỏ
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>