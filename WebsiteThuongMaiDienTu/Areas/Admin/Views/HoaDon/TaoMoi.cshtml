@{
    ViewBag.Title = "Thêm hóa đơn";
    var homNay = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2>
                <i class="bi bi-receipt" style="color: var(--brand-yellow);"></i>
                Thêm hóa đơn mới
            </h2>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
            </div>
        }

        @using (Html.BeginForm("TaoMoi", "HoaDon", new { area = "Admin" }, FormMethod.Post, new { id = "formThemHoaDon", autocomplete = "off" }))
        {
            <div class="mb-3">
                <label class="form-label">
                    Khách hàng <span class="text-danger">*</span>
                </label>

                @Html.DropDownList(
                    "txt_makh",
                    (SelectList)ViewBag.makh,
                    "-- Chọn khách hàng --",
                    new { @class = "form-select", required = "required" }
                )
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Ngày đặt hàng</label>
                    <input type="date"
                           id="txt_ngaydathang"
                           name="txt_ngaydathang"
                           class="form-control"
                           value="@homNay" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Ngày giao hàng</label>
                    <input type="date"
                           id="txt_ngaygiaohang"
                           name="txt_ngaygiaohang"
                           class="form-control"
                           value="@homNay" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Ghi chú</label>
                <textarea id="txt_ghichu"
                          name="txt_ghichu"
                          class="form-control"
                          rows="3"
                          placeholder="Nhập ghi chú cho hóa đơn"></textarea>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="form-check sp-check">
                        <input type="checkbox"
                               class="form-check-input"
                               name="chk_dathanhtoan"
                               id="chk_dathanhtoan" />

                        <label class="form-check-label" for="chk_dathanhtoan">
                            Đã thanh toán
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check sp-check">
                        <input type="checkbox"
                               class="form-check-input"
                               name="chk_giaotannoi"
                               id="chk_giaotannoi" />

                        <label class="form-check-label" for="chk_giaotannoi">
                            Giao tận nơi
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu">
                    <i class="bi bi-check-circle"></i> Thêm mới
                </button>

                <a href="@Url.Action("Index", "HoaDon", new { area = "Admin" })" class="btn-huy">
                    Hủy bỏ
                </a>
            </div>
        }
    </div>
</div>