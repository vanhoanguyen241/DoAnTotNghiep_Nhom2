@using WebsiteThuongMaiDienTu.Models
@model List<loaisanpham>

@{
    ViewBag.Title = "Quản lý Loại sản phẩm";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 text-dark font-medium m-0">
        Danh mục: Loại sản phẩm
    </h1>

    <div class="btn-toolbar mb-2 mb-md-0">
        @Html.ActionLink(
            "+ Thêm loại mới",
            "TaoMoi",
            "LoaiSanPham",
            new { area = "Admin" },
            new
            {
                @class = "btn btn-sm btn-primary d-inline-flex align-items-center fw-bold shadow-sm px-3 py-2",
                role = "button"
            }
        )
    </div>
</div>

<div class="card border-light shadow-sm">
    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light text-uppercase fs-7 text-muted border-bottom">
                <tr>
                    <th class="ps-3" style="width:150px;">
                        Mã loại
                    </th>

                    <th>
                        Tên loại sản phẩm
                    </th>

                    <th class="text-end pe-3" style="width:180px;">
                        Hành động
                    </th>
                </tr>
            </thead>

            <tbody class="border-top-0">

                @foreach (var item in Model)
                {
                    <tr>

                        <td class="ps-3 font-monospace text-muted fw-bold">
                            @item.maloaisanpham
                        </td>

                        <td class="text-dark fw-semibold">
                            @item.tenloaisanpham
                        </td>

                        <td class="text-end pe-3">

                            <div class="btn-group btn-group-sm">

                                @Html.ActionLink(
                                    "Sửa",
                                    "Sua",
                                    "LoaiSanPham",
                                    new
                                    {
                                        area = "Admin",
                                        id = item.maloaisanpham
                                    },
                                    new
                                    {
                                        @class = "btn btn-outline-secondary px-2",
                                        title = "Chỉnh sửa loại sản phẩm"
                                    }
                                )

                                @Html.ActionLink(
                                    "Xóa",
                                    "Xoa",
                                    "LoaiSanPham",
                                    new
                                    {
                                        area = "Admin",
                                        id = item.maloaisanpham
                                    },
                                    new
                                    {
                                        @class = "btn btn-outline-danger px-2",
                                        title = "Xóa loại sản phẩm",
                                        onclick = "return confirm('Bạn có chắc chắn muốn xóa loại sản phẩm này?');"
                                    }
                                )

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
</div>