@{
    ViewBag.Title = "Thêm loại sản phẩm";
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2><i class="bi bi-tag" style="color: var(--brand-yellow);"></i> Thêm loại sản phẩm mới</h2>
        </div>

        @using (Html.BeginForm("TaoMoi", "LoaiSanPham", new { area = "Admin" }, FormMethod.Post, new { id = "formThemLoai", autocomplete = "off" }))
        {
            <div class="mb-3">
                <label class="form-label">Mã loại sản phẩm <span class="text-danger">*</span></label>
                <input type="text" id="txt_ma" name="txt_ma" class="form-control"
                       placeholder="Ví dụ: LSP01" required />
            </div>
            <div class="mb-4">
                <label class="form-label">Tên loại sản phẩm <span class="text-danger">*</span></label>
                <input type="text" id="txt_ten" name="txt_ten" class="form-control"
                       placeholder="Ví dụ: Điện thoại" required />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu"><i class="bi bi-check-circle"></i> Thêm mới</button>
                <a href="@Url.Action("Index", "LoaiSanPham", new { area = "Admin" })" class="btn-huy">Hủy bỏ</a>
            </div>
        }
    </div>
</div>