@model WebsiteThuongMaiDienTu.Models.loaisanpham

@{
    ViewBag.Title = "Sửa loại sản phẩm";
}

<h3 class="mb-4">
    <i class="bi bi-pencil"></i> Sửa loại sản phẩm
</h3>

<div class="card shadow-sm border-0" style="max-width: 560px;">
    <div class="card-body p-4">
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

        @using (Html.BeginForm(
            "Sua",
            "LoaiSanPham",
            new { id = Model.maloaisanpham },
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">
                    Mã loại sản phẩm
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.maloaisanpham"
                       disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Tên loại sản phẩm
                    <span class="text-danger">*</span>
                </label>

                @Html.TextBoxFor(
                    m => m.tenloaisanpham,
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(
                    m => m.tenloaisanpham,
                    "",
                    new { @class = "text-danger small" })
            </div>

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn"
                        style="background: var(--brand-yellow); color: var(--brand-dark); font-weight:600;">
                    <i class="bi bi-check-lg"></i> Lưu
                </button>

                <a href="@Url.Action("Index")"
                   class="btn btn-outline-secondary">
                    Hủy
                </a>

            </div>
        }
    </div>

</div>