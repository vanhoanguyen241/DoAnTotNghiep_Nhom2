@using WebsiteThuongMaiDienTu.Models
@model loaisanpham
@{
    ViewBag.Title = "Chỉnh sửa loại sản phẩm";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark"><i class="bi bi-pencil-square me-2 text-brand-yellow"></i> Cập nhật loại sản phẩm</h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @using (Html.BeginForm("Sua", "LoaiSanPham", new { area = "Admin" }, FormMethod.Post, new { id = "formSuaLoai" }))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Mã loại</label>
                            <input type="text" id="txt_ma" name="txt_ma" class="form-control bg-readonly" readonly value="@Model.maloaisanpham" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Tên loại sản phẩm <span class="text-danger ms-1">*</span></label>
                            <input type="text" id="txt_ten" name="txt_ten" class="form-control"
                                   value="@Model.tenloaisanpham" required />
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-brand px-4"><i class="bi bi-check-circle me-1"></i> Lưu thay đổi</button>
                            <a href="@Url.Action("Index", "LoaiSanPham", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">Hủy bỏ</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>