@using WebsiteThuongMaiDienTu.Models
@model loaisanpham

@{
    ViewBag.Title = "Chỉnh sửa loại sản phẩm";
}

<div class="row justify-content-center pt-2">

    <div class="col-12 col-md-8 col-lg-6">

        <div class="card border-light shadow-sm">

            <div class="card-header bg-white border-bottom py-3">

                <h1 class="h5 m-0 fw-bold text-dark">
                    Cập nhật thông tin dữ liệu
                </h1>

            </div>

            <div class="card-body p-4">

                @using (Html.BeginForm(
                    "Sua",
                    "LoaiSanPham",
                    new { area = "Admin" },
                    FormMethod.Post,
                    new { id = "formSuaLoai" }))
                {
                    <div class="mb-3">

                        <label for="txt_ma"
                               class="form-label text-muted fs-7 text-uppercase fw-bold">
                            Mã loại (Không thể sửa)
                        </label>

                        <input type="text"
                               id="txt_ma"
                               name="txt_ma"
                               class="form-control bg-light font-monospace text-muted fw-bold"
                               readonly
                               value="@Model.maloaisanpham" />

                    </div>

                    <div class="mb-4">

                        <label for="txt_ten"
                               class="form-label text-muted fs-7 text-uppercase fw-bold">
                            Tên loại sản phẩm mới
                        </label>

                        <input type="text"
                               id="txt_ten"
                               name="txt_ten"
                               class="form-control"
                               value="@Model.tenloaisanpham"
                               required />

                    </div>

                    <div class="d-flex gap-2 justify-content-end pt-2 border-top">

                        @Html.ActionLink(
                            "Hủy bỏ",
                            "Index",
                            "LoaiSanPham",
                            new { area = "Admin" },
                            new
                            {
                                @class = "btn btn-sm btn-light px-3 text-muted"
                            }
                        )

                        <button type="submit"
                                class="btn btn-sm btn-primary px-4 fw-bold shadow-sm">
                            Lưu thay đổi
                        </button>

                    </div>
                }

            </div>

        </div>

    </div>

</div>