@using WebsiteThuongMaiDienTu.Models
@model loaisanpham
@{
    ViewBag.Title = "Chỉnh sửa loại sản phẩm";
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2><i class="bi bi-pencil-square" style="color: var(--brand-yellow);"></i> Cập nhật loại sản phẩm</h2>
        </div>

        @using (Html.BeginForm("Sua", "LoaiSanPham", new { area = "Admin" }, FormMethod.Post, new { id = "formSuaLoai" }))
        {
            <div class="mb-3">
                <label class="form-label">Mã loại</label>
                <input type="text" id="txt_ma" name="txt_ma" class="form-control"
                       readonly value="@Model.maloaisanpham" style="background: #f8f9fa;" />
            </div>
            <div class="mb-4">
                <label class="form-label">Tên loại sản phẩm <span class="text-danger">*</span></label>
                <input type="text" id="txt_ten" name="txt_ten" class="form-control"
                       value="@Model.tenloaisanpham" required />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu"><i class="bi bi-check-circle"></i> Lưu thay đổi</button>
                <a href="@Url.Action("Index", "LoaiSanPham", new { area = "Admin" })" class="btn-huy">Hủy bỏ</a>
            </div>
        }
    </div>
</div>