@{
    ViewBag.Title = "Thêm chi tiết hóa đơn";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark">
                        <i class="bi bi-cart-plus me-2" style="color: var(--brand-yellow);"></i> Thêm chi tiết hóa đơn #@ViewBag.Mahoadon
                    </h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
                        </div>
                    }

                    @using (Html.BeginForm("TaoMoi", "ChiTietHoaDon", new { area = "Admin" }, FormMethod.Post, new { id = "formThemChiTietHoaDon", autocomplete = "off" }))
                    {
                        <input type="hidden" name="txt_mahoadon" value="@ViewBag.Mahoadon" />

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">
                                Sản phẩm <span class="text-danger ms-1">*</span>
                            </label>

                            @Html.DropDownList(
                                "txt_masp",
                                (SelectList)ViewBag.masanpham,
                                "-- Chọn sản phẩm --",
                                new { @class = "form-select", required = "required" }
                            )
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">
                                Số lượng <span class="text-danger ms-1">*</span>
                            </label>

                            <input type="number"
                                   id="txt_soluong"
                                   name="txt_soluong"
                                   class="form-control"
                                   min="1"
                                   value="1"
                                   required />
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-brand px-4">
                                <i class="bi bi-check-circle me-1"></i> Thêm chi tiết
                            </button>

                            <a href="@Url.Action("Index", "ChiTietHoaDon", new { area = "Admin", id = ViewBag.Mahoadon })" class="btn btn-light px-4 border shadow-sm">
                                Hủy bỏ
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>