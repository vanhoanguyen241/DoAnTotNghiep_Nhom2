@{
    ViewBag.Title = "Thêm chi tiết hóa đơn";
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2>
                <i class="bi bi-cart-plus" style="color: var(--brand-yellow);"></i>
                Thêm chi tiết hóa đơn #@ViewBag.Mahoadon
            </h2>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
            </div>
        }

        @using (Html.BeginForm("TaoMoi", "ChiTietHoaDon", new { area = "Admin" }, FormMethod.Post, new { id = "formThemChiTietHoaDon", autocomplete = "off" }))
        {
            <input type="hidden" name="txt_mahoadon" value="@ViewBag.Mahoadon" />

            <div class="mb-3">
                <label class="form-label">
                    Sản phẩm <span class="text-danger">*</span>
                </label>

                @Html.DropDownList(
                    "txt_masp",
                    (SelectList)ViewBag.masanpham,
                    "-- Chọn sản phẩm --",
                    new { @class = "form-select", required = "required" }
                )
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Số lượng <span class="text-danger">*</span>
                </label>

                <input type="number"
                       id="txt_soluong"
                       name="txt_soluong"
                       class="form-control"
                       min="1"
                       value="1"
                       required />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu">
                    <i class="bi bi-check-circle"></i> Thêm chi tiết
                </button>

                <a href="@Url.Action("Index", "ChiTietHoaDon", new { area = "Admin", id = ViewBag.Mahoadon })" class="btn-huy">
                    Hủy bỏ
                </a>
            </div>
        }
    </div>
</div>