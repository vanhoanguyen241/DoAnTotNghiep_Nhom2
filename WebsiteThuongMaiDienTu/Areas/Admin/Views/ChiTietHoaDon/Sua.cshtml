@using WebsiteThuongMaiDienTu.Models
@model chitiethoadon
@{
    ViewBag.Title = "Sửa chi tiết hóa đơn";
}

<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2>
                <i class="bi bi-pencil-square" style="color: var(--brand-yellow);"></i>
                Cập nhật chi tiết hóa đơn #@Model.mahoadon
            </h2>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
            </div>
        }

        @using (Html.BeginForm("Sua", "ChiTietHoaDon", new { area = "Admin" }, FormMethod.Post, new { id = "formSuaChiTietHoaDon" }))
        {
            <input type="hidden" name="txt_mahoadon" value="@Model.mahoadon" />
            <input type="hidden" name="txt_masp" value="@Model.masanpham" />

            <div class="mb-3">
                <label class="form-label">Mã hóa đơn</label>
                <input type="text"
                       class="form-control"
                       readonly
                       value="@Model.mahoadon"
                       style="background: #f8f9fa;" />
            </div>

            <div class="mb-3">
                <label class="form-label">Sản phẩm</label>
                <input type="text"
                       class="form-control"
                       readonly
                       value="@(Model.sanpham != null ? Model.sanpham.tensanpham : Model.masanpham)"
                       style="background: #f8f9fa;" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Số lượng <span class="text-danger">*</span>
                </label>

                <input type="number"
                       id="txt_soluong"
                       name="txt_soluong"
                       class="form-control"
                       min="1"
                       value="@Model.soluong"
                       required />
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Đơn giá (VNĐ) <span class="text-danger">*</span>
                </label>

                <input type="number"
                       id="txt_dongia"
                       name="txt_dongia"
                       class="form-control"
                       min="1"
                       value="@string.Format("{0:0.##}", Model.dongia)"
                       required />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu">
                    <i class="bi bi-check-circle"></i> Lưu thay đổi
                </button>

                <a href="@Url.Action("Index", "ChiTietHoaDon", new { area = "Admin", id = Model.mahoadon })" class="btn-huy">
                    Hủy bỏ
                </a>
            </div>
        }
    </div>
</div>