@using WebsiteThuongMaiDienTu.Models
@model chitiethoadon
@{
    ViewBag.Title = "Sửa chi tiết hóa đơn";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark">
                        <i class="bi bi-pencil-square me-2" style="color: var(--brand-yellow);"></i> Cập nhật chi tiết hóa đơn #@Model.mahoadon
                    </h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
                        </div>
                    }

                    @using (Html.BeginForm("Sua", "ChiTietHoaDon", new { area = "Admin" }, FormMethod.Post, new { id = "formSuaChiTietHoaDon" }))
                    {
                        <input type="hidden" name="txt_mahoadon" value="@Model.mahoadon" />
                        <input type="hidden" name="txt_masp" value="@Model.masanpham" />

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Mã hóa đơn</label>
                            <input type="text"
                                   class="form-control"
                                   readonly
                                   value="@Model.mahoadon"
                                   style="background: #f8f9fa;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Sản phẩm</label>
                            <input type="text"
                                   class="form-control"
                                   readonly
                                   value="@(Model.sanpham != null ? Model.sanpham.tensanpham : Model.masanpham)"
                                   style="background: #f8f9fa;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">
                                Số lượng <span class="text-danger ms-1">*</span>
                            </label>

                            <input type="number"
                                   id="txt_soluong"
                                   name="txt_soluong"
                                   class="form-control"
                                   min="1"
                                   value="@Model.soluong"
                                   required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">
                                Đơn giá (VNĐ) <span class="text-danger ms-1">*</span>
                            </label>

                            <input type="number"
                                   id="txt_dongia"
                                   name="txt_dongia"
                                   class="form-control"
                                   min="1"
                                   value="@string.Format("{0:0.##}", Model.dongia)"
                                   required />
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-brand px-4">
                                <i class="bi bi-check-circle me-1"></i> Lưu thay đổi
                            </button>

                            <a href="@Url.Action("Index", "ChiTietHoaDon", new { area = "Admin", id = Model.mahoadon })" class="btn btn-light px-4 border shadow-sm">
                                Hủy bỏ
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>