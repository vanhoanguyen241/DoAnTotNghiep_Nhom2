@{
    ViewBag.Title = "Thêm sản phẩm";
}
<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark"><i class="bi bi-box-seam me-2 text-brand-yellow"></i> Thêm sản phẩm mới</h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
                        </div>
                    }

                    @using (Html.BeginForm("TaoMoi", "SanPham", new { area = "Admin" }, FormMethod.Post, new { id = "formThemSP", autocomplete = "off" }))
                    {
                        <div class="row g-3">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold text-dark" for="txt_masp">Mã sản phẩm <span class="text-danger ms-1">*</span></label>
                                <input type="text" id="txt_masp" name="txt_masp" class="form-control" required />
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold text-dark" for="txt_tensp">Tên sản phẩm <span class="text-danger ms-1">*</span></label>
                                <input type="text" id="txt_tensp" name="txt_tensp" class="form-control" required />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-dark" for="txt_lsp">Loại sản phẩm <span class="text-danger ms-1">*</span></label>
                                @Html.DropDownList("txt_lsp", (SelectList)ViewBag.maloaisanpham, "-- Chọn loại sản phẩm --", new { @class = "form-select", required = "required" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-dark" for="txt_dvsx">Nhà sản xuất <span class="text-danger ms-1">*</span></label>
                                @Html.DropDownList("txt_dvsx", (SelectList)ViewBag.donvisanxuat, "-- Chọn nhà sản xuất --", new { @class = "form-select", required = "required" })
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold text-dark" for="txt_mota">Mô tả</label>
                                <textarea id="txt_mota" name="txt_mota" class="form-control" rows="3"></textarea>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold text-dark" for="txt_tgbaohanh">Bảo hành (tháng)</label>
                                <input type="number" id="txt_tgbaohanh" name="txt_tgbaohanh" class="form-control" min="0" value="0" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold text-dark" for="txt_dongia">Đơn giá (VNĐ) <span class="text-danger ms-1">*</span></label>
                                <input type="number" id="txt_dongia" name="txt_dongia" class="form-control" min="0" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold text-dark" for="txt_soluong">Số lượng tồn kho</label>
                                <input type="number" id="txt_soluong" name="txt_soluong" class="form-control" min="0" value="0" />
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold text-dark" for="txt_hinh">Tên file hình ảnh</label>
                                <div class="bg-light p-3 rounded border">
                                    <input type="text" id="txt_hinh" name="txt_hinh" class="form-control mb-2" placeholder="Ví dụ: laptop.jpg, iphone15.png" />
                                    <small class="text-muted">Chỉ nhập tên file (vd: <code>laptop.jpg</code>). Hệ thống tự lưu vào <code>~/Content/images/sanpham/</code>. Bỏ trống sẽ dùng ảnh mặc định.</small>
                                </div>
                            </div>

                            <div class="col-12 mb-3">
                                <div class="form-check p-3 bg-light rounded border d-flex align-items-center gap-2">
                                    <input type="checkbox" class="form-check-input mt-0" name="chk_quangcao" id="chk_quangcao" style="width: 1.25em; height: 1.25em; cursor: pointer;" />
                                    <label class="form-check-label fw-bold text-dark mb-0" for="chk_quangcao" style="cursor: pointer;">Hiện ở trang chủ (quảng cáo)</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-brand px-4"><i class="bi bi-check-circle me-1"></i> Thêm sản phẩm</button>
                            <a href="@Url.Action("Index", "SanPham", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">Hủy bỏ</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>