@using WebsiteThuongMaiDienTu.Models
@model sanpham
@{
    ViewBag.Title = "Cập nhật sản phẩm";
}
<div class="kh-form-container kh-form-container-wide">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2><i class="bi bi-pencil-square" style="color: var(--brand-yellow);"></i> Cập nhật sản phẩm</h2>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao
            </div>
        }

        @using (Html.BeginForm("Sua", "SanPham", new { area = "Admin" }, FormMethod.Post, new { id = "formSuaSP" }))
        {
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="txt_masp">Mã sản phẩm</label>
                    <input type="text" id="txt_masp" name="txt_masp" class="form-control" readonly value="@Model.masanpham" style="background: #f8f9fa;" />
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="txt_tensp">Tên sản phẩm <span class="text-danger">*</span></label>
                    <input type="text" id="txt_tensp" name="txt_tensp" class="form-control" value="@Model.tensanpham" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="txt_lsp">Loại sản phẩm <span class="text-danger">*</span></label>
                    @Html.DropDownList("txt_lsp", (SelectList)ViewBag.maloaisanpham, new { @class = "form-select", required = "required" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="txt_dvsx">Nhà sản xuất <span class="text-danger">*</span></label>
                    @Html.DropDownList("txt_dvsx", (SelectList)ViewBag.donvisanxuat, new { @class = "form-select", required = "required" })
                </div>

                <div class="col-12">
                    <label class="form-label" for="txt_mota">Mô tả</label>
                    <textarea id="txt_mota" name="txt_mota" class="form-control" rows="3">@Model.mota</textarea>
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="txt_tgbaohanh">Bảo hành (tháng)</label>
                    <input type="number" id="txt_tgbaohanh" name="txt_tgbaohanh" class="form-control" min="0" value="@Model.thoigianbaohanh" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="txt_dongia">Đơn giá (VNĐ) <span class="text-danger">*</span></label>
                    <input type="number" id="txt_dongia" name="txt_dongia" class="form-control" min="0" value="@string.Format("{0:0.##}", Model.dongia)" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="txt_soluong">Số lượng tồn kho</label>
                    <input type="number" id="txt_soluong" name="txt_soluong" class="form-control" min="0" value="@Model.soluonghienco" />
                </div>

                <div class="col-12">
                    <label class="form-label">Hình hiện tại</label>
                    <div class="sp-img-box">
                        <img src="@Url.Content(Model.hinh)" alt="@Model.tensanpham" class="sp-img-preview" />
                        <div class="sp-img-input">
                            <label class="form-label" for="txt_hinh" style="margin-top: 10px; margin-bottom: 4px;">Đổi tên file hình ảnh (để trống nếu không đổi)</label>
                            <input type="text" id="txt_hinh" name="txt_hinh" class="form-control" placeholder="Ví dụ: laptop_new.jpg" />
                            <small class="form-text">Chỉ nhập tên file mới. Hệ thống tự lưu vào <code>~/Content/images/sanpham/</code>.</small>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-check sp-check">
                        <input type="checkbox" class="form-check-input" name="chk_quangcao" id="chk_quangcao"
                               @(Model.quangcao == true ? "checked" : "") />
                        <label class="form-check-label" for="chk_quangcao">Hiện ở trang chủ (quảng cáo)</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn-luu"><i class="bi bi-check-circle"></i> Lưu thay đổi</button>
                <a href="@Url.Action("Index", "SanPham", new { area = "Admin" })" class="btn-huy">Hủy bỏ</a>
            </div>
        }
    </div>
</div>