@using WebsiteThuongMaiDienTu.Models
@model List<sanpham>
@{
    ViewBag.Title = "Quản lý Sản phẩm";
    bool isAdmin = ViewBag.IsAdmin == true;
}
<div class="container-fluid px-4 py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-box-seam me-2 text-brand-yellow"></i>
                Quản lý Sản phẩm
            </h2>

            @if (isAdmin)
            {
                <a href="@Url.Action("TaoMoi", "SanPham", new { area = "Admin" })" class="btn btn-brand">
                    <i class="bi bi-plus-circle me-1"></i> Thêm sản phẩm mới
                </a>
            }
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="card-body pb-0">
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;" class="text-uppercase text-secondary small fw-bold">Ảnh</th>
                        <th style="width: 120px;" class="text-uppercase text-secondary small fw-bold">Mã SP</th>
                        <th class="text-uppercase text-secondary small fw-bold">Tên sản phẩm</th>
                        <th style="width: 130px;" class="text-uppercase text-secondary small fw-bold">Đơn giá</th>
                        <th style="width: 100px;" class="text-center text-uppercase text-secondary small fw-bold">Tồn kho</th>
                        <th style="width: 100px;" class="text-center text-uppercase text-secondary small fw-bold">Quảng cáo</th>
                        <th style="width: 120px;" class="text-center text-uppercase text-secondary small fw-bold">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@Url.Content(item.hinh)" alt="@item.tensanpham" class="thumb-48" />
                            </td>
                            <td><strong class="text-dark">@item.masanpham</strong></td>
                            <td>@item.tensanpham</td>
                            <td>@string.Format("{0:N0}₫", item.dongia)</td>
                            <td class="text-center">
                                @if (item.soluonghienco > 0)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2">@item.soluonghienco</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-2">Hết hàng</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.quangcao == true)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">Có</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Không</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (isAdmin)
                                {
                                    <a href="@Url.Action("Sua", "SanPham", new { area = "Admin", id = item.masanpham })"
                                       class="btn btn-sm btn-light text-primary me-1"
                                       title="Sửa">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <a href="@Url.Action("Xoa", "SanPham", new { area = "Admin", id = item.masanpham })"
                                       class="btn btn-sm btn-light text-danger"
                                       title="Xóa"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Chỉ xem</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>