@using WebsiteThuongMaiDienTu.Models
@model List<sanpham>
@{
    ViewBag.Title = "Quản lý Sản phẩm";
    bool isAdmin = ViewBag.IsAdmin == true;

    var grid = new WebGrid(
        source: Model,
        rowsPerPage: 10,
        canPage: true,
        canSort: true,
        defaultSort: "masanpham"
    );
}

<div class="container-fluid px-4 py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-box-seam me-2 text-brand-yellow"></i>
                Quản lý Sản phẩm
            </h2>
            @if (isAdmin)
            {
                <a href="@Url.Action("TaoMoi", "SanPham", new { area = "Admin" })" class="btn btn-brand">
                    <i class="bi bi-plus-circle me-1"></i> Thêm sản phẩm mới
                </a>
            }
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="card-body pb-0">
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

    <div class="card-body">
        @grid.GetHtml(
            tableStyle: "table table-hover align-middle mb-0",
            headerStyle: "table-light text-uppercase small text-secondary fw-bold",
            footerStyle: "webgrid-pager",
            mode: WebGridPagerModes.All,
            firstText: "«",
            previousText: "‹",
            nextText: "›",
            lastText: "»",
            numericLinksCount: 3,
            columns: grid.Columns(
                grid.Column(
                    header: "Ảnh",
                    format: @<img src="@Url.Content(item.hinh)" alt="@item.tensanpham" class="thumb-48" />
),
grid.Column("masanpham", header: "Mã SP"),
grid.Column("tensanpham", header: "Tên sản phẩm"),
grid.Column(
header: "Đơn giá",
format: @<span>@string.Format("{0:N0}₫", item.dongia)</span>
),
grid.Column(
header: "Tồn kho",
format: @<text>
        @if (item.soluonghienco > 0)
        {
            <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2">@item.soluonghienco</span>
        }
        else
        {
            <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-2">Hết hàng</span>
        }
    </text>
),
grid.Column(
header: "Quảng cáo",
format: @<text>
        <div class="d-flex justify-content-center">
            <input class="form-check-input" type="checkbox" @(item.quangcao == true ? "checked" : "") disabled style="cursor: not-allowed;" />
        </div>
    </text>
),
grid.Column(
header: "Hành động",
format: @<text>
        <!-- Nút Nhập kho (Dành cho cả Admin và Nhân viên) -->
        <a href="@Url.Action("NhapKho", "SanPham", new { area = "Admin", id = item.masanpham })"
           class="btn btn-sm btn-light text-success me-1" title="Nhập kho (Tăng số lượng)">
            <i class="bi bi-plus-circle-fill"></i> Nhập kho
        </a>

        @if (isAdmin)
        {
            <!-- Các nút Sửa / Xóa chỉ Admin mới thấy -->
            <a href="@Url.Action("Sua", "SanPham", new { area = "Admin", id = item.masanpham })"
               class="btn btn-sm btn-light text-primary me-1" title="Sửa">
                <i class="bi bi-pencil-fill"></i>
            </a>
            <a href="@Url.Action("Xoa", "SanPham", new { area = "Admin", id = item.masanpham })"
               class="btn btn-sm btn-light text-danger" title="Xóa"
               onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                <i class="bi bi-trash-fill"></i>
            </a>
        }
        else
        {
            <span class="text-muted small d-inline-block mt-1">NV: Chỉ nhập kho</span>
        }
    </text>
)))
    </div>
    </div>
</div>