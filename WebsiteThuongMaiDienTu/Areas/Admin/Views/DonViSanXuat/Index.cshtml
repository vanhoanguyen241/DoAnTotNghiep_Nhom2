@using WebsiteThuongMaiDienTu.Models
@model List<donvisanxuat>
@{
    ViewBag.Title = "Quản lý Đơn vị sản xuất";
    bool isAdmin = ViewBag.IsAdmin == true;
}
<div class="container-fluid px-4 py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-building me-2 text-brand-yellow"></i>
                Quản lý Đơn vị sản xuất
            </h2>

            @if (isAdmin)
            {
                <a href="@Url.Action("TaoMoi", "DonViSanXuat", new { area = "Admin" })" class="btn btn-brand">
                    <i class="bi bi-plus-circle me-1"></i> Thêm đơn vị mới
                </a>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 180px;" class="text-uppercase text-secondary small fw-bold">Mã đơn vị</th>
                        <th class="text-uppercase text-secondary small fw-bold">Tên đơn vị sản xuất</th>
                        <th style="width: 120px;" class="text-center text-uppercase text-secondary small fw-bold">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong class="text-dark">@item.madonvisanxuat</strong></td>
                            <td>@item.tendonvisanxuat</td>
                            <td class="text-center">
                                @if (isAdmin)
                                {
                                    <a href="@Url.Action("Sua", "DonViSanXuat", new { area = "Admin", id = item.madonvisanxuat })"
                                       class="btn btn-sm btn-light text-primary me-1"
                                       title="Sửa">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <a href="@Url.Action("Xoa", "DonViSanXuat", new { area = "Admin", id = item.madonvisanxuat })"
                                       class="btn btn-sm btn-light text-danger"
                                       title="Xóa"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa đơn vị sản xuất này?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Chỉ xem</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>