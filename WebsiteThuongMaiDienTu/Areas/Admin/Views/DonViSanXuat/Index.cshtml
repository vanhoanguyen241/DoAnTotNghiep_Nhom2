@using WebsiteThuongMaiDienTu.Models
@model List<donvisanxuat>
@{
    ViewBag.Title = "Quản lý Đơn vị sản xuất";
    bool isAdmin = ViewBag.IsAdmin == true;
}
<div class="kh-container">
    <div class="kh-card">
        <div class="kh-header">
            <h2>
                <i class="bi bi-building" style="color: var(--brand-yellow);"></i>
                Quản lý Đơn vị sản xuất
            </h2>

            @if (isAdmin)
            {
                <a href="@Url.Action("TaoMoi", "DonViSanXuat", new { area = "Admin" })" class="btn-them">
                    <i class="bi bi-plus-circle"></i> Thêm đơn vị mới
                </a>
            }
        </div>

        <div class="table-responsive">
            <table class="kh-table">
                <thead>
                    <tr>
                        <th style="width: 180px;">Mã đơn vị</th>
                        <th>Tên đơn vị sản xuất</th>
                        <th style="width: 120px;" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.madonvisanxuat</strong></td>
                            <td>@item.tendonvisanxuat</td>
                            <td class="text-center">
                                @if (isAdmin)
                                {
                                    <a href="@Url.Action("Sua", "DonViSanXuat", new { area = "Admin", id = item.madonvisanxuat })"
                                       class="btn-icon btn-sua"
                                       title="Sửa">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <a href="@Url.Action("Xoa", "DonViSanXuat", new { area = "Admin", id = item.madonvisanxuat })"
                                       class="btn-icon btn-xoa"
                                       title="Xóa"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa đơn vị sản xuất này?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Chỉ xem</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>