@{
    ViewBag.Title = "Thêm đơn vị sản xuất";
}
<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark"><i class="bi bi-building me-2" style="color: var(--brand-yellow);"></i> Thêm đơn vị sản xuất mới</h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @using (Html.BeginForm("TaoMoi", "DonViSanXuat", new { area = "Admin" }, FormMethod.Post, new { id = "formThemDonVi", autocomplete = "off" }))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark" for="txt_ma">Mã đơn vị sản xuất <span class="text-danger ms-1">*</span></label>
                            <input type="text" id="txt_ma" name="txt_ma" class="form-control" placeholder="Ví dụ: APPLE, SAMSUNG..." required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark" for="txt_ten">Tên đơn vị sản xuất <span class="text-danger ms-1">*</span></label>
                            <input type="text" id="txt_ten" name="txt_ten" class="form-control" placeholder="Ví dụ: Apple Inc." required />
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-brand px-4"><i class="bi bi-check-circle me-1"></i> Thêm mới</button>
                            <a href="@Url.Action("Index", "DonViSanXuat", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">Hủy bỏ</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>