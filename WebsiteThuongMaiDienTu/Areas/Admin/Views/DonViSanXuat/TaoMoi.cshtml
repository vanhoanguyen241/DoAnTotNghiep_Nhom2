@{
    ViewBag.Title = "Thêm đơn vị sản xuất";
}
<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2><i class="bi bi-building" style="color: var(--brand-yellow);"></i> Thêm đơn vị sản xuất mới</h2>
        </div>

        @using (Html.BeginForm("TaoMoi", "DonViSanXuat", new { area = "Admin" }, FormMethod.Post, new { id = "formThemDonVi", autocomplete = "off" }))
        {
            <div class="mb-3">
                <label class="form-label" for="txt_ma">Mã đơn vị sản xuất <span class="text-danger">*</span></label>
                <input type="text" id="txt_ma" name="txt_ma" class="form-control" placeholder="Ví dụ: APPLE, SAMSUNG..." required />
            </div>
            <div class="mb-4">
                <label class="form-label" for="txt_ten">Tên đơn vị sản xuất <span class="text-danger">*</span></label>
                <input type="text" id="txt_ten" name="txt_ten" class="form-control" placeholder="Ví dụ: Apple Inc." required />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu"><i class="bi bi-check-circle"></i> Thêm mới</button>
                <a href="@Url.Action("Index", "DonViSanXuat", new { area = "Admin" })" class="btn-huy">Hủy bỏ</a>
            </div>
        }
    </div>
</div>