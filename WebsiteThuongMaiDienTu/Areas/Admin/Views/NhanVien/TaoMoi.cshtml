@{
    ViewBag.Title = "Thêm nhân viên";
}
<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2><i class="bi bi-person-plus" style="color: var(--brand-yellow);"></i> Thêm nhân viên mới</h2>
        </div>
        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao</div>
        }
        @using (Html.BeginForm("TaoMoi", "NhanVien", new { area = "Admin" }, FormMethod.Post, new { id = "formThemNV", autocomplete = "off" }))
        {
            <div class="mb-3">
                <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                <input type="text" name="txt_hoten" class="form-control" placeholder="Nhập họ và tên" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Số điện thoại</label>
                <input type="text" name="txt_dienthoai" class="form-control" placeholder="Nhập số điện thoại" />
            </div>
            <div class="mb-4">
                <label class="form-label">Vai trò <span class="text-danger">*</span></label>
                <select name="txt_vaitro" class="form-select" required>
                    <option value="">-- Chọn vai trò --</option>
                    <option value="Admin">Admin</option>
                    <option value="NhanVien">Nhân viên</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu"><i class="bi bi-check-circle"></i> Xác nhận Lưu</button>
                <a href="@Url.Action("Index", "NhanVien", new { area = "Admin" })" class="btn-huy">Hủy bỏ</a>
            </div>
        }
    </div>
</div>