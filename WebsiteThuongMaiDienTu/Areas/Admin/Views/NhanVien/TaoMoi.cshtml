@{
    ViewBag.Title = "Thêm nhân viên";
}
<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h4 mb-0 fw-bold text-dark"><i class="bi bi-person-plus me-2" style="color: var(--brand-yellow);"></i> Thêm nhân viên mới</h2>
                </div>

                <div class="card-body p-4 pt-2">
                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao</div>
                    }
                    @using (Html.BeginForm("TaoMoi", "NhanVien", new { area = "Admin" }, FormMethod.Post, new { id = "formThemNV", autocomplete = "off" }))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Họ và tên <span class="text-danger ms-1">*</span></label>
                            <input type="text" name="txt_hoten" class="form-control" placeholder="Nhập họ và tên" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Số điện thoại</label>
                            <input type="text" name="txt_dienthoai" class="form-control" placeholder="Nhập số điện thoại" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Vai trò <span class="text-danger ms-1">*</span></label>
                            <select name="txt_vaitro" class="form-select" required>
                                <option value="">-- Chọn vai trò --</option>
                                <option value="Admin">Admin</option>
                                <option value="NhanVien">Nhân viên</option>
                            </select>
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-brand px-4"><i class="bi bi-check-circle me-1"></i> Xác nhận Lưu</button>
                            <a href="@Url.Action("Index", "NhanVien", new { area = "Admin" })" class="btn btn-light px-4 border shadow-sm">Hủy bỏ</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>