@using WebsiteThuongMaiDienTu.Models
@model taikhoan
@{
    ViewBag.Title = "Đổi mật khẩu";
    string loai = Model.manv != null ? "Nhân viên" : "Khách hàng";
    string chuSoHuu = Model.manv != null
        ? (Model.nhanvien != null ? Model.nhanvien.hoten : "—")
        : (Model.khachhang != null ? Model.khachhang.hoten : "—");
}
<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2><i class="bi bi-key-fill" style="color: var(--brand-yellow);"></i> Đổi mật khẩu</h2>
            <p class="text-muted">Tài khoản: <strong>@Model.tendangnhap</strong></p>
        </div>
        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao</div>
        }

        <!-- Hiển thị thông tin chủ sở hữu -->
        <div class="alert alert-info mb-4">
            <div class="row g-2">
                <div class="col-md-6">
                    <strong>Loại tài khoản:</strong><br />
                    <span class="sp-badge @(Model.manv != null ? "sp-badge-danger" : "sp-badge-success")">@loai</span>
                </div>
                <div class="col-md-6">
                    <strong>Chủ sở hữu:</strong><br />
                    @chuSoHuu
                </div>
            </div>
        </div>

        @using (Html.BeginForm("Sua", "TaiKhoan", new { area = "Admin" }, FormMethod.Post, new { autocomplete = "off" }))
        {
            <input type="hidden" name="txt_tendangnhap" value="@Model.tendangnhap" />
            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                <input type="text" class="form-control" value="@Model.tendangnhap" readonly style="background: #f8f9fa;" />
            </div>
            <div class="mb-4">
                <label class="form-label">Mật khẩu mới <span class="text-danger">*</span></label>
                <input type="password" name="txt_matkhaumoi" class="form-control" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" minlength="6" />
                <small class="text-muted">Để trống nếu không muốn đổi mật khẩu.</small>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu"><i class="bi bi-check-circle"></i> Lưu thay đổi</button>
                <a href="@Url.Action("Index", "TaiKhoan", new { area = "Admin" })" class="btn-huy">Hủy bỏ</a>
            </div>
        }
    </div>
</div>