@using WebsiteThuongMaiDienTu.Models
@model nhanvien
@{
    ViewBag.Title = "Sửa nhân viên";
}
<div class="kh-form-container">
    <div class="kh-form-card">
        <div class="kh-form-header">
            <h2><i class="bi bi-pencil-square" style="color: var(--brand-yellow);"></i> Cập nhật nhân viên #@Model.manv</h2>
        </div>
        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ThongBao</div>
        }
        @using (Html.BeginForm("Sua", "NhanVien", new { area = "Admin" }, FormMethod.Post))
        {
            <input type="hidden" name="txt_manv" value="@Model.manv" />
            <div class="mb-3">
                <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                <input type="text" name="txt_hoten" class="form-control" value="@Model.hoten" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Số điện thoại</label>
                <input type="text" name="txt_dienthoai" class="form-control" value="@Model.dienthoai" />
            </div>
            <div class="mb-4">
                <label class="form-label">Vai trò <span class="text-danger">*</span></label>
                <select name="txt_vaitro" class="form-select" required>
                    <option value="Admin" @(Model.vaitro == "Admin" ? "selected" : "")>Admin</option>
                    <option value="NhanVien" @(Model.vaitro == "NhanVien" ? "selected" : "")>Nhân viên</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-luu"><i class="bi bi-check-circle"></i> Lưu thay đổi</button>
                <a href="@Url.Action("Index", "NhanVien", new { area = "Admin" })" class="btn-huy">Hủy bỏ</a>
            </div>
        }
    </div>
</div>