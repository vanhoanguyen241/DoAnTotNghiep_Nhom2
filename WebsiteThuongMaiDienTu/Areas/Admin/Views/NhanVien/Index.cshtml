@using WebsiteThuongMaiDienTu.Models
@model List<nhanvien>
@{
    ViewBag.Title = "Quản lý Nhân viên";
}
<div class="kh-container kh-container-wide">
    <div class="kh-card">
        <div class="kh-header">
            <h2><i class="bi bi-person-badge" style="color: var(--brand-yellow);"></i> Quản lý Nhân viên</h2>
            <a href="@Url.Action("TaoMoi", "NhanVien", new { area = "Admin" })" class="btn-them">
                <i class="bi bi-plus-circle"></i> Thêm nhân viên
            </a>
        </div>
        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="kh-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">Mã NV</th>
                        <th>Họ tên</th>
                        <th>Điện thoại</th>
                        <th style="width: 120px;">Vai trò</th>
                        <th style="width: 120px;" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.manv</strong></td>
                            <td>@item.hoten</td>
                            <td>@(string.IsNullOrEmpty(item.dienthoai) ? "—" : item.dienthoai)</td>
                            <td>
                                @if (item.vaitro == "Admin")
                                {
                                    <span class="sp-badge sp-badge-danger">Admin</span>
                                }
                                else
                                {
                                    <span class="sp-badge sp-badge-success">Nhân viên</span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Sua", "NhanVien", new { area = "Admin", id = item.manv })" class="btn-icon btn-sua" title="Sửa"><i class="bi bi-pencil-fill"></i></a>
                                <a href="@Url.Action("Xoa", "NhanVien", new { area = "Admin", id = item.manv })" class="btn-icon btn-xoa" title="Xóa" onclick="return confirm('Bạn có chắc chắn muốn xóa nhân viên này?');"><i class="bi bi-trash-fill"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>