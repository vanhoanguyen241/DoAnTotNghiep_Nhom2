@using WebsiteThuongMaiDienTu.Models
@model List<nhanvien>
@{
    ViewBag.Title = "Quản lý Nhân viên";
}
<div class="container-fluid px-4 py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 py-3">
            <h2 class="h4 mb-0 fw-bold text-dark">
                <i class="bi bi-person-badge me-2 text-brand-yellow"></i>
                Quản lý Nhân viên
            </h2>
            <a href="@Url.Action("TaoMoi", "NhanVien", new { area = "Admin" })" class="btn btn-brand">
                <i class="bi bi-plus-circle me-1"></i> Thêm nhân viên
            </a>
        </div>
        @if (TempData["ThongBao"] != null)
        {
            <div class="card-body pb-0">
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;" class="text-uppercase text-secondary small fw-bold">Mã NV</th>
                        <th class="text-uppercase text-secondary small fw-bold">Họ tên</th>
                        <th class="text-uppercase text-secondary small fw-bold">Điện thoại</th>
                        <th style="width: 120px;" class="text-uppercase text-secondary small fw-bold">Vai trò</th>
                        <th style="width: 120px;" class="text-center text-uppercase text-secondary small fw-bold">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong class="text-dark">@item.manv</strong></td>
                            <td>@item.hoten</td>
                            <td>@(string.IsNullOrEmpty(item.dienthoai) ? "—" : item.dienthoai)</td>
                            <td>
                                @if (item.vaitro == "Admin")
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-2">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2">Nhân viên</span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Sua", "NhanVien", new { area = "Admin", id = item.manv })" class="btn btn-sm btn-light text-primary me-1" title="Sửa"><i class="bi bi-pencil-fill"></i></a>
                                <a href="@Url.Action("Xoa", "NhanVien", new { area = "Admin", id = item.manv })" class="btn btn-sm btn-light text-danger" title="Xóa" onclick="return confirm('Bạn có chắc chắn muốn xóa nhân viên này?');"><i class="bi bi-trash-fill"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>