@{
    ViewBag.Title = "Trang chủ quản trị";
    bool isAdmin = ViewBag.IsAdmin == true;
}

<div class="container-fluid px-4 py-4">
    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h4 mb-1 fw-bold text-dark">
                <i class="bi bi-speedometer2 me-2" style="color: var(--brand-yellow);"></i>
                Trang chủ quản trị
            </h2>
            <p class="text-muted mb-0">
                Xin chào <strong>@Session["TenDangNhap"]</strong>, đây là tổng quan các chức năng của hệ thống.
            </p>
        </div>
        <div class="d-none d-md-block">
            <span class="text-muted small bg-light px-3 py-2 rounded-pill">
                <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
            </span>
        </div>
    </div>

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
            @TempData["ThongBao"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">

        <!-- ═══ NHÓM 1: DANH MỤC & HÀNG HÓA ═══ -->
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-box-seam-fill me-2" style="color: var(--brand-yellow);"></i>
                        Danh mục & Hàng hóa
                    </h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item border-0 px-0 py-2">
                            <a href="@Url.Action("Index", "LoaiSanPham", new { area = "Admin" })" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-tags-fill text-primary"></i>
                                <span><strong>Loại sản phẩm</strong></span>
                            </a>
                            <small class="text-muted d-block ms-4">Quản lý danh mục sản phẩm (Điện thoại, Laptop...)</small>
                        </li>
                        <li class="list-group-item border-0 px-0 py-2">
                            <a href="@Url.Action("Index", "DonViSanXuat", new { area = "Admin" })" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-building text-info"></i>
                                <span><strong>Đơn vị sản xuất</strong></span>
                            </a>
                            <small class="text-muted d-block ms-4">Quản lý nhà sản xuất (Apple, Samsung...)</small>
                        </li>
                        <li class="list-group-item border-0 px-0 py-2">
                            <a href="@Url.Action("Index", "SanPham", new { area = "Admin" })" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-box-seam text-success"></i>
                                <span><strong>Sản phẩm</strong></span>
                            </a>
                            <small class="text-muted d-block ms-4">Thêm, sửa, xóa sản phẩm và quản lý tồn kho</small>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- ═══ NHÓM 2: KHÁCH HÀNG ═══ -->
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-people-fill me-2" style="color: var(--brand-yellow);"></i>
                        Khách hàng
                    </h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item border-0 px-0 py-2">
                            <a href="@Url.Action("Index", "KhachHang", new { area = "Admin" })" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-person-lines-fill text-warning"></i>
                                <span><strong>Quản lý Khách hàng</strong></span>
                            </a>
                            <small class="text-muted d-block ms-4">Thêm, sửa thông tin khách hàng. Không xóa nếu đã có hóa đơn.</small>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- ═══ NHÓM 3: NGHIỆP VỤ BÁN HÀNG ═══ -->
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-receipt-cutoff me-2" style="color: var(--brand-yellow);"></i>
                        Nghiệp vụ bán hàng
                    </h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item border-0 px-0 py-2">
                            <a href="@Url.Action("Index", "HoaDon", new { area = "Admin" })" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-receipt text-primary"></i>
                                <span><strong>Hóa đơn</strong></span>
                            </a>
                            <small class="text-muted d-block ms-4">Tạo mới, sửa, xóa hóa đơn bán hàng</small>
                        </li>
                        <li class="list-group-item border-0 px-0 py-2">
                            <a href="@Url.Action("Index", "DuyetDon", new { area = "Admin" })" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-clipboard-check text-success"></i>
                                <span><strong>Duyệt đơn</strong></span>
                            </a>
                            <small class="text-muted d-block ms-4">Kiểm tra tồn kho, duyệt hoặc từ chối phiếu đặt hàng</small>
                        </li>
                        <li class="list-group-item border-0 px-0 py-2">
                            <a href="@Url.Action("Index", "ThanhToan", new { area = "Admin" })" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-credit-card text-danger"></i>
                                <span><strong>Thanh toán</strong></span>
                            </a>
                            <small class="text-muted d-block ms-4">Xác nhận khách hàng đã thanh toán (tiền mặt/chuyển khoản)</small>
                        </li>
                        <li class="list-group-item border-0 px-0 py-2">
                            <a href="@Url.Action("Index", "ChuyenHang", new { area = "Admin" })" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-truck text-info"></i>
                                <span><strong>Giao hàng</strong></span>
                            </a>
                            <small class="text-muted d-block ms-4">Lập phiếu giao, gán nhân viên, xác nhận đã giao</small>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- ═══ NHÓM 4: HỆ THỐNG (Chỉ Admin) ═══ -->
        @if (isAdmin)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 py-3 px-4">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-shield-lock-fill me-2" style="color: var(--brand-yellow);"></i>
                            Hệ thống <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill small ms-1">Admin</span>
                        </h5>
                    </div>
                    <div class="card-body p-4 pt-0">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item border-0 px-0 py-2">
                                <a href="@Url.Action("Index", "TaiKhoan", new { area = "Admin" })" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                                    <i class="bi bi-key-fill text-secondary"></i>
                                    <span><strong>Tài khoản</strong></span>
                                </a>
                                <small class="text-muted d-block ms-4">Tạo tài khoản đăng nhập cho nhân viên</small>
                            </li>
                            <li class="list-group-item border-0 px-0 py-2">
                                <a href="@Url.Action("Index", "NhanVien", new { area = "Admin" })" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                                    <i class="bi bi-person-badge text-dark"></i>
                                    <span><strong>Nhân viên</strong></span>
                                </a>
                                <small class="text-muted d-block ms-4">Quản lý thông tin và vai trò nhân viên</small>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        }

        <!-- ═══ GHI CHÚ QUY TRÌNH ═══ -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 border-start border-4" style="border-color: var(--brand-yellow) !important;">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-lightbulb-fill me-2" style="color: var(--brand-yellow);"></i>
                        Quy trình xử lý đơn hàng
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-2 py-2">1</span>
                                <div>
                                    <strong class="text-dark small d-block">Khách đặt hàng</strong>
                                    <small class="text-muted">Phiếu đặt hàng chờ duyệt</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-2 py-2">2</span>
                                <div>
                                    <strong class="text-dark small d-block">Duyệt đơn</strong>
                                    <small class="text-muted">Kiểm tra kho → Tạo hóa đơn</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning px-2 py-2">3</span>
                                <div>
                                    <strong class="text-dark small d-block">Thanh toán</strong>
                                    <small class="text-muted">Xác nhận đã nhận tiền</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge rounded-pill bg-info bg-opacity-10 text-info px-2 py-2">4</span>
                                <div>
                                    <strong class="text-dark small d-block">Giao hàng</strong>
                                    <small class="text-muted">Lập phiếu → Giao → Hoàn tất</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>